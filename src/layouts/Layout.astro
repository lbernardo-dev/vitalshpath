---
import "../styles/global.css";
import { languages, supportedLangs, type Lang } from "../i18n/ui-locales";
import { useTranslations } from "../i18n";
import appIcon from "../assets/images/AppIcon_v2.png";
import { SUPABASE_URL, SUPABASE_ANON_KEY } from "../lib/supabase/config";

interface Props {
	lang: Lang;
	robots?: string;
	pageTitle?: string;
	pageDescription?: string;
}

const {
	lang,
	robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
	pageTitle,
	pageDescription,
} = Astro.props;
const t = useTranslations(lang);
const { dir } = languages[lang];

const title = pageTitle ?? t("meta.title");
const description = pageDescription ?? t("meta.description");
const keywordsByLang: Partial<Record<Lang, string>> = {
	en: "VitalsPath 2.0, medication tracker, pill reminder, symptom tracker, vitals tracker, appointments, Apple Watch health app, iOS health organizer",
	es: "VitalsPath 2.0, seguimiento de medicacion, recordatorio de pastillas, registro de sintomas, constantes vitales, citas medicas, Apple Watch salud, organizador de salud iOS",
};

const siteOrigin = "https://lbernardo-dev.github.io";
const basePath = "/vitalshpath";
const siteUrl = `${siteOrigin}${basePath}`;
const baseHref = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const normalizedPath = Astro.url.pathname.endsWith("/")
	? Astro.url.pathname
	: `${Astro.url.pathname}/`;
const currentUrl = new URL(normalizedPath, siteOrigin).toString();
const localizedPathForLang = (targetLang: Lang) =>
	normalizedPath.replace(
		new RegExp(`^${basePath}/${lang}(?=/|$)`),
		`${basePath}/${targetLang}`,
	);
const defaultLocaleUrl = new URL(localizedPathForLang("en"), siteOrigin).toString();
const appIconUrl = new URL(appIcon.src, siteOrigin).toString();
const socialImageUrl = appIconUrl;

const localeTags: Record<Lang, string> = {
	en: "en-US",
	es: "es-ES",
	fr: "fr-FR",
	de: "de-DE",
	it: "it-IT",
	pt: "pt-BR",
	ja: "ja-JP",
	zh: "zh-Hans",
	ko: "ko-KR",
	ru: "ru-RU",
	ar: "ar-SA",
	hi: "hi",
	tr: "tr-TR",
	nl: "nl-NL",
	pl: "pl",
};

const maintenanceSafeSegments = [
	"/privacy",
	"/terms",
	"/disclaimer",
	"/subscription",
	"/feedback",
];

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "SoftwareApplication",
		name: "VitalsPath",
		url: currentUrl,
		applicationCategory: "HealthApplication",
		operatingSystem: "iOS, watchOS",
		image: [appIconUrl],
		screenshot: [socialImageUrl],
		description: description,
		inLanguage: supportedLangs,
		author: {
			"@type": "Person",
			name: "Lester Romero Bernardo",
		},
		featureList: [
			"Medication planning and dose logging",
			"Symptom, mood and vitals tracking",
			"Appointments and follow-up tasks",
			"Widgets, Live Activities and Apple Watch support",
			"Private personal health organization",
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: "VitalsPath",
		url: `${siteUrl}/`,
	},
];
---

<!DOCTYPE html>
<html lang={lang} dir={dir} class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="google-site-verification"
			content="b72boX-YTMPpT_1qmIYVjY3BpA7LIVuMVPtBqqJJBmk"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content={keywordsByLang[lang] ?? keywordsByLang.en}
		/>
		<meta name="author" content="Lester Romero Bernardo" />
		<meta name="robots" content={robots} />
		<meta name="language" content={lang} />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="VitalsPath" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap" rel="stylesheet">

		<link rel="sitemap" href={`${siteUrl}/sitemap-index.xml`} />
		<link rel="canonical" href={currentUrl} />
		{
			supportedLangs.map((l) => (
				<link
					rel="alternate"
					hreflang={localeTags[l]}
					href={new URL(localizedPathForLang(l), siteOrigin).toString()}
				/>
			))
		}
		<link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:url" content={currentUrl} />
		<meta property="og:image:width" content="2048" />
		<meta property="og:image:height" content="2048" />
		<meta property="og:locale" content={localeTags[lang].replace("-", "_")} />
		<meta property="og:site_name" content="VitalsPath" />
		<meta
			property="og:image:alt"
			content="VitalsPath app icon"
		/>

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		<meta
			name="twitter:image:alt"
			content="VitalsPath app icon"
		/>

		<link
			rel="icon"
			type="image/png"
			sizes="32x32"
			href={`${baseHref}favicon-32x32.png`}
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="16x16"
			href={`${baseHref}favicon-16x16.png`}
		/>
		<link
			rel="icon"
			type="image/png"
			href={`${baseHref}favicon.ico`}
		/>
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href={`${baseHref}apple-touch-icon.png`}
		/>
		<link rel="manifest" href={`${baseHref}site.webmanifest`} />
		<meta name="theme-color" content="#FDFCFB" />
		<meta
			name="apple-mobile-web-app-status-bar-style"
			content="black-translucent"
		/>

		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

		<!-- Theme initialization -->
		<script is:inline>
			(function () {
				try {
					var saved = localStorage.getItem("theme");
					var isDark = saved === "dark" || (!saved && window.matchMedia("(prefers-color-scheme: dark)").matches);
					document.documentElement.classList.toggle("dark", isDark);
				} catch (e) {}
			})();
		</script>
		<script is:inline define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY }}>
			window.VITALSPATH_CONFIG = {
				supabaseUrl: SUPABASE_URL,
				supabaseAnonKey: SUPABASE_ANON_KEY
			};
		</script>
	</head>
	<body
		data-site-lang={lang}
		data-base-path={basePath}
		data-maintenance-safe-segments={maintenanceSafeSegments.join(",")}
		class="bg-mesh min-h-screen selection:bg-teal-primary/20 selection:text-teal-primary"
	>
		<!-- Skip to main content for accessibility -->
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-teal-primary focus:text-white focus:rounded-[1rem] focus:shadow-xl"
		>
			Skip to main content
		</a>

		<main id="main-content" class="relative z-10 w-full overflow-x-hidden">
			<slot />
		</main>

		<!-- Enhanced client script -->
		<script>
			import { setupRevealObserver } from "../lib/reveal-observer";
			import { hydrateAppStoreLinks } from "../lib/app-store-links";
			import { getSupabase, isSupabaseConfigured } from "../lib/supabase";
			import { trackEvent } from "../lib/supabase/tracking";

			function getLayoutConfig() {
				const body = document.body;
				return {
					lang: body.dataset.siteLang || "en",
					basePath: body.dataset.basePath || "",
					maintenanceSafeSegments: (body.dataset.maintenanceSafeSegments || "")
						.split(",")
						.filter(Boolean),
				};
			}

			// Enhanced Header behavior
			function setupHeader() {
				const header = document.querySelector(".glass-header");
				if (!header) return;

				const handleScroll = () => {
					if (window.scrollY > 15) {
						header.classList.add("scrolled");
					} else {
						header.classList.remove("scrolled");
					}
				};

				window.addEventListener("scroll", handleScroll, { passive: true });
				handleScroll(); // Initial check
			}

			// Non-blocking maintenance sync
			async function syncMaintenanceState() {
				try {
					if (!isSupabaseConfigured()) return;

					const { lang, basePath, maintenanceSafeSegments } = getLayoutConfig();
					const pathname = window.location.pathname.replace(/\/+$/, "");
					const localizedMaintenancePath = `${basePath}/${lang}/maintenance`;
					const isMaintenancePage = pathname === localizedMaintenancePath;
					const isSafeRoute = maintenanceSafeSegments.some((segment) =>
						pathname.endsWith(segment),
					);

					const supabase = getSupabase();
					if (!supabase) return;

					const { data, error } = await (supabase
						.from("site_settings")
						.select("value")
						.eq("key", "maintenance_mode")
						.maybeSingle() as unknown as Promise<{ data: any, error: any }>);

					if (error || !data) return;

					const value = data.value;
					const enabled =
						typeof value === "boolean" ? value : Boolean(value?.enabled);

					if (enabled && !isMaintenancePage && !isSafeRoute) {
						window.location.replace(`${localizedMaintenancePath}/`);
						return;
					}

					if (!enabled && isMaintenancePage) {
						window.location.replace(`${basePath}/${lang}/`);
					}
				} catch (e) {
					console.warn("Maintenance sync failed", e);
				}
			}

			function bindAppStoreTracking() {
				if ((window as any).__vitalsPathAppStoreTrackingBound) return;

				document.addEventListener("click", (event) => {
					const target = event.target instanceof Element ? event.target : null;
					if (!target) return;

					const link = target.closest("[data-app-store-link], [data-app-store-review-link]");
					if (!(link instanceof HTMLAnchorElement)) return;

					const isReviewLink = link.hasAttribute("data-app-store-review-link");
					trackEvent(
						isReviewLink ? "app_store_review_click" : "app_store_click",
						{
							href: link.href,
							page: window.location.pathname,
							label: (link.textContent || "").trim().slice(0, 80),
						},
					);
				});

				(window as any).__vitalsPathAppStoreTrackingBound = true;
			}

			async function initClientPage() {
				const config = getLayoutConfig() as { lang: string };
				const { lang } = config as any;
				
				// Priority 1: Vital UI behavior
				setupHeader();
				setupRevealObserver();
				
				// Priority 2: Interactivity
				bindAppStoreTracking();
				
				// Priority 3: External sync (Non-blocking)
				hydrateAppStoreLinks(lang).catch(console.error);
				syncMaintenanceState().catch(console.error);
				
				// Failsafe for reveal animations: if observer fails or element is not in view
				setTimeout(() => {
					document.querySelectorAll('.reveal:not(.reveal-visible), .reveal-scale:not(.reveal-visible)').forEach(el => {
						const rect = el.getBoundingClientRect();
						if (rect.top < window.innerHeight) {
							el.classList.add('reveal-visible');
						}
					});
				}, 2000);
			}

			initClientPage();
			document.addEventListener("astro:page-load", initClientPage);
		</script>
	</body>
</html>

---
import "../styles/global.css";
import { languages, supportedLangs, type Lang } from "../i18n/ui-locales";
import { useTranslations } from "../i18n";
import appMockup from "../assets/images/app-mockup.png";
import appIcon from "../assets/images/AppIcon_v2.png";
import SurveyWidget from "../components/SurveyWidget.astro";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { dir } = languages[lang];

const title = t("meta.title");
const description = t("meta.description");

const siteOrigin = "https://lbernardo-dev.github.io";
const basePath = "/vitalshpath";
const siteUrl = `${siteOrigin}${basePath}`;

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": ["SoftwareApplication", "MedicalApplication"],
		name: "VitalsPath: Smart Med Tracker",
		applicationCategory: "HealthApplication",
		operatingSystem: "iOS 18.0 or later, watchOS 11.0 or later",
		softwareVersion: "1.0",
		screenshot: [`${siteUrl}${appMockup.src}`],
		offers: {
			"@type": "Offer",
			price: "0",
			priceCurrency: "USD",
			availability: "https://schema.org/PreOrder",
		},
		aggregateRating: {
			"@type": "AggregateRating",
			ratingValue: 4.9,
			bestRating: 5,
			worstRating: 1,
			ratingCount: 500,
		},
		description: description,
		inLanguage: supportedLangs,
		author: {
			"@type": "Organization",
			name: "RomeroDev",
		},
		featureList: [
			"Medication & Pill Management",
			"Vitals & Symptoms Tracking",
			"Doctor Appointment Manager",
			"Smart Refill Alerts",
			"Live Activities & Dynamic Island",
			"Apple Watch Sync",
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: "VitalsPath",
		url: `${siteUrl}/`,
	},
];
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="UTF-8" />
		<meta
			name="google-site-verification"
			content="b72boX-YTMPpT_1qmIYVjY3BpA7LIVuMVPtBqqJJBmk"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="medication tracker, pill reminder, vitals tracker, prescription manager, doctor appointment, pharmacy refill, medical alerts, iOS health app"
		/>
		<meta name="author" content="Lester Romero Bernardo" />
		<meta
			name="robots"
			content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
		/>
		<meta name="language" content={lang} />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="VitalsPath" />

		<!-- Preconnect to external domains -->
		<link rel="dns-prefetch" href="https://www.googletagmanager.com" />

		<!-- Google Tag Manager -->
		<script is:inline>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({
					"gtm.start": new Date().getTime(),
					event: "gtm.js",
				});
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != "dataLayer" ? "&l=" + l : "";
				j.async = true;
				j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, "script", "dataLayer", "GTM-N5RRS3V8");
		</script>
		<!-- End Google Tag Manager -->

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta
			property="og:image"
			content={`${siteUrl}${appMockup.src}`}
		/>
		<meta property="og:url" content={siteUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content={lang} />
		<meta property="og:site_name" content="VitalsPath" />
		<meta
			property="og:image:alt"
			content="VitalsPath: Smart Medication & Vitals Tracker"
		/>

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta
			name="twitter:image"
			content={`${siteUrl}${appMockup.src}`}
		/>
		<meta name="twitter:creator" content="@vitalspath" />
		<meta
			name="twitter:image:alt"
			content="VitalsPath: Smart Medication & Vitals Tracker"
		/>

		<link
			rel="icon"
			type="image/png"
			sizes="32x32"
			href={`${siteUrl}/favicon-32x32.png`}
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="16x16"
			href={`${siteUrl}/favicon-16x16.png`}
		/>
		<link
			rel="icon"
			type="image/x-icon"
			href={`${siteUrl}/favicon.ico`}
		/>
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href={`${siteUrl}/apple-touch-icon.png`}
		/>
<!-- <link
			rel="icon"
			type="image/svg+xml"
			href={`${import.meta.env.BASE_URL}/favicon.svg`}
		/> -->
		<link
			rel="manifest"
			href={`${siteUrl}/site.webmanifest`}
		/>
		<meta name="theme-color" content="#007aff" />
		<meta
			name="apple-mobile-web-app-status-bar-style"
			content="black-translucent"
		/>

		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Canonical and Hreflang -->
		<link
			rel="sitemap"
			href={`${siteUrl}/sitemap-index.xml`}
		/>
		<link
			rel="canonical"
			href={`${siteUrl}/${lang}/`}
		/>
		<link
			rel="alternate"
			hreflang="x-default"
			href={`${siteUrl}/en/`}
		/>
		{
			supportedLangs.map((l) => (
				<link
					rel="alternate"
					hreflang={l}
					href={`${siteUrl}/${l}/`}
				/>
			))
		}

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}
		></script>

		<!-- Theme initialization -->
		<script is:inline>
			(function () {
				try {
					var saved = localStorage.getItem("theme");
					var prefersDark = window.matchMedia(
						"(prefers-color-scheme: dark)"
					).matches;
					var isDark = saved === "dark" || (!saved && prefersDark);
					document.documentElement.classList.toggle("dark", isDark);
				} catch (e) {}
			})();
		</script>
	</head>
	<body
		class="bg-white dark:bg-black text-gray-900 dark:text-white min-h-screen transition-colors"
	>
		<!-- Skip to main content for accessibility -->
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-lg focus:shadow-xl"
		>
			Skip to main content
		</a>
		<!-- Google Tag Manager (noscript) -->
		<noscript
			><iframe
				src="https://www.googletagmanager.com/ns.html?id=GTM-N5RRS3V8"
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe>
		</noscript>
		<!-- End Google Tag Manager (noscript) -->
		<div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
			<div
				class="absolute w-[500px] h-[500px] bg-blue-400/20 dark:bg-blue-500/10 rounded-full blur-[100px] top-[-5%] left-[-5%] animate-float"
			>
			</div>
			<div
				class="absolute w-[400px] h-[400px] bg-purple-400/15 dark:bg-purple-500/10 rounded-full blur-[100px] top-[40%] right-[-5%] animate-float"
				style="animation-delay: -4s;"
			>
			</div>
		</div>
		<slot />
		<SurveyWidget lang={lang} />
		<script>
			import { initScrollReveal } from "../lib/scrollReveal";
			// Initialize scroll reveal animations
			initScrollReveal();
		</script>
	</body>
</html>

---
import "../styles/global.css";
import { languages, supportedLangs, type Lang } from "../i18n/ui-locales";
import { useTranslations } from "../i18n";
import appMockup from "../assets/images/app-mockup.png";
import appIcon from "../assets/images/AppIcon_v2.png";

interface Props {
	lang: Lang;
	robots?: string;
	pageTitle?: string;
	pageDescription?: string;
}

const {
	lang,
	robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
	pageTitle,
	pageDescription,
} = Astro.props;
const t = useTranslations(lang);
const { dir } = languages[lang];

const title = pageTitle ?? t("meta.title");
const description = pageDescription ?? t("meta.description");

const siteOrigin = "https://lbernardo-dev.github.io";
const basePath = "/vitalshpath";
const siteUrl = `${siteOrigin}${basePath}`;
const baseHref = import.meta.env.BASE_URL.endsWith("/")
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const normalizedPath = Astro.url.pathname.endsWith("/")
	? Astro.url.pathname
	: `${Astro.url.pathname}/`;
const currentUrl = new URL(normalizedPath, siteOrigin).toString();
const localizedPathForLang = (targetLang: Lang) =>
	normalizedPath.replace(
		new RegExp(`^${basePath}/${lang}(?=/|$)`),
		`${basePath}/${targetLang}`,
	);
const defaultLocaleUrl = new URL(localizedPathForLang("en"), siteOrigin).toString();
const socialImageUrl = new URL(appMockup.src, siteOrigin).toString();

const localeTags: Record<Lang, string> = {
	en: "en-US",
	es: "es-ES",
	fr: "fr-FR",
	de: "de-DE",
	it: "it-IT",
	pt: "pt-BR",
	ja: "ja-JP",
	zh: "zh-Hans",
	ko: "ko-KR",
	ru: "ru-RU",
	ar: "ar-SA",
	hi: "hi",
	tr: "tr-TR",
	nl: "nl-NL",
	pl: "pl",
};

const maintenanceSafeSegments = [
	"/privacy",
	"/terms",
	"/disclaimer",
	"/subscription",
	"/feedback",
];

const jsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "SoftwareApplication",
		name: "VitalsPath",
		url: currentUrl,
		applicationCategory: "HealthApplication",
		operatingSystem: "iOS, watchOS",
		image: appIcon.src ? [new URL(appIcon.src, siteOrigin).toString()] : undefined,
		screenshot: [socialImageUrl],
		description: description,
		inLanguage: supportedLangs,
		author: {
			"@type": "Person",
			name: "Lester Romero Bernardo",
		},
		featureList: [
			"Medication planning and dose logging",
			"Symptom, mood and vitals tracking",
			"Appointments and follow-up tasks",
			"Widgets, Live Activities and Apple Watch support",
			"Private personal health organization",
		],
	},
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: "VitalsPath",
		url: `${siteUrl}/`,
	},
];
---

<!DOCTYPE html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="UTF-8" />
		<meta
			name="google-site-verification"
			content="b72boX-YTMPpT_1qmIYVjY3BpA7LIVuMVPtBqqJJBmk"
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="medication tracking, symptom tracking, vitals tracking, appointment organization, refill reminders, Apple Watch, widgets, Live Activities"
		/>
		<meta name="author" content="Lester Romero Bernardo" />
		<meta name="robots" content={robots} />
		<meta name="language" content={lang} />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="VitalsPath" />

			<link rel="sitemap" href={`${siteUrl}/sitemap-index.xml`} />
			<link rel="canonical" href={currentUrl} />
			{
				supportedLangs.map((l) => (
					<link
						rel="alternate"
						hreflang={localeTags[l]}
						href={new URL(localizedPathForLang(l), siteOrigin).toString()}
					/>
				))
			}
			<link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />

			<!-- Open Graph -->
			<meta property="og:type" content="website" />
			<meta property="og:title" content={title} />
			<meta property="og:description" content={description} />
			<meta property="og:image" content={socialImageUrl} />
			<meta property="og:url" content={currentUrl} />
			<meta property="og:image:width" content="1200" />
			<meta property="og:image:height" content="630" />
			<meta property="og:locale" content={localeTags[lang].replace("-", "_")} />
			<meta property="og:site_name" content="VitalsPath" />
			<meta
				property="og:image:alt"
				content="VitalsPath health timeline interface"
			/>

		<!-- Twitter Card -->
			<meta name="twitter:card" content="summary_large_image" />
			<meta name="twitter:title" content={title} />
			<meta name="twitter:description" content={description} />
			<meta name="twitter:image" content={socialImageUrl} />
			<meta
				name="twitter:image:alt"
				content="VitalsPath health timeline interface"
			/>

			<link
				rel="icon"
				type="image/png"
				sizes="32x32"
				href={`${baseHref}favicon-32x32.png`}
			/>
			<link
				rel="icon"
				type="image/png"
				sizes="16x16"
				href={`${baseHref}favicon-16x16.png`}
			/>
			<link
				rel="icon"
				type="image/x-icon"
				href={`${baseHref}favicon.ico`}
			/>
			<link
				rel="apple-touch-icon"
				sizes="180x180"
				href={`${baseHref}apple-touch-icon.png`}
			/>
			<!-- <link
				rel="icon"
				type="image/svg+xml"
				href={`${import.meta.env.BASE_URL}/favicon.svg`}
			/> -->
			<link rel="manifest" href={`${baseHref}site.webmanifest`} />
			<meta name="theme-color" content="#007aff" />
			<meta
				name="apple-mobile-web-app-status-bar-style"
			content="black-translucent"
		/>

			<meta name="generator" content={Astro.generator} />
			<title>{title}</title>

			<!-- JSON-LD Structured Data -->
			<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}
		></script>

		<!-- Theme initialization -->
		<script is:inline>
			(function () {
				try {
					var saved = localStorage.getItem("theme");
					var isDark = saved === "dark";
					document.documentElement.classList.toggle("dark", isDark);
				} catch (e) {}
			})();
		</script>
	</head>
	<body
		data-site-lang={lang}
		data-base-path={basePath}
		data-maintenance-safe-segments={maintenanceSafeSegments.join(",")}
		class="bg-white dark:bg-black text-gray-900 dark:text-white min-h-screen transition-colors"
	>
		<!-- Skip to main content for accessibility -->
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-lg focus:shadow-xl"
		>
			Skip to main content
		</a>
		<div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
			<div
				class="absolute w-[500px] h-[500px] bg-blue-400/20 dark:bg-blue-500/10 rounded-full blur-[100px] top-[-5%] left-[-5%] animate-float"
			>
			</div>
			<div
				class="absolute w-[400px] h-[400px] bg-purple-400/15 dark:bg-purple-500/10 rounded-full blur-[100px] top-[40%] right-[-5%] animate-float"
				style="animation-delay: -4s;"
			>
			</div>
		</div>
		<slot />
		<script>
			import { initScrollReveal } from "../lib/scrollReveal";
			import { hydrateAppStoreLinks } from "../lib/app-store-links";
			import { getSupabase, isSupabaseConfigured } from "../lib/supabase";
			import { trackEvent } from "../lib/supabase/tracking";

			function getLayoutConfig() {
				const body = document.body;
				return {
					lang: body.dataset.siteLang || "en",
					basePath: body.dataset.basePath || "",
					maintenanceSafeSegments: (body.dataset.maintenanceSafeSegments || "")
						.split(",")
						.filter(Boolean),
				};
			}

			async function syncMaintenanceState() {
				if (!isSupabaseConfigured()) return;

				const { lang, basePath, maintenanceSafeSegments } = getLayoutConfig();
				const pathname = window.location.pathname.replace(/\/+$/, "");
				const localizedMaintenancePath = `${basePath}/${lang}/maintenance`;
				const isMaintenancePage = pathname === localizedMaintenancePath;
				const isSafeRoute = maintenanceSafeSegments.some((segment) =>
					pathname.endsWith(segment),
				);

				const supabase = getSupabase();
				if (!supabase) return;

				const { data, error } = await supabase
					.from("site_settings")
					.select("value")
					.eq("key", "maintenance_mode")
					.maybeSingle();

				if (error || !data?.value) return;

				const value = data.value;
				const enabled =
					typeof value === "boolean" ? value : Boolean(value?.enabled);

				if (enabled && !isMaintenancePage && !isSafeRoute) {
					window.location.replace(`${localizedMaintenancePath}/`);
					return;
				}

				if (!enabled && isMaintenancePage) {
					window.location.replace(`${basePath}/${lang}/`);
				}
			}

			function bindAppStoreTracking() {
				if (window.__vitalsPathAppStoreTrackingBound) return;

				document.addEventListener("click", (event) => {
					const target = event.target instanceof Element ? event.target : null;
					if (!target) return;

					const link = target.closest("[data-app-store-link], [data-app-store-review-link]");
					if (!(link instanceof HTMLAnchorElement)) return;

					const isReviewLink = link.hasAttribute("data-app-store-review-link");
					trackEvent(
						isReviewLink ? "app_store_review_click" : "app_store_click",
						{
							href: link.href,
							page: window.location.pathname,
							label: (link.textContent || "").trim().slice(0, 80),
						},
					);
				});

				window.__vitalsPathAppStoreTrackingBound = true;
			}

			async function initClientPage() {
				const { lang } = getLayoutConfig();
				initScrollReveal();
				bindAppStoreTracking();
				await hydrateAppStoreLinks(lang);
				await syncMaintenanceState();
			}

			initClientPage();
			document.addEventListener("astro:page-load", initClientPage);
		</script>
	</body>
</html>

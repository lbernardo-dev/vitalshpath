---
import { type Lang } from "../../i18n/ui-locales";

interface Props {
    className?: string;
    lang?: Lang;
}

const { className = "h-[40px]", lang = "en" } = Astro.props;

// Official Apple Locale Mappings for the 15 supported languages
const localeMap: Record<Lang, string> = {
    en: "en-US",
    es: "es-ES",
    fr: "fr-FR",
    de: "de-DE",
    it: "it-IT",
    pt: "pt-BR",
    ja: "ja-JP",
    zh: "zh-CN",
    ko: "ko-KR",
    ru: "ru-RU",
    ar: "ar-SA",
    hi: "hi-IN",
    tr: "tr-TR",
    nl: "nl-NL",
    pl: "pl-PL",
};

const locale = localeMap[lang] || "en-US";
const blackBadgeUrl = `https://toolbox.marketingtools.apple.com/api/badges/download-on-the-app-store/black/${locale}.svg`;
const whiteBadgeUrl = `https://toolbox.marketingtools.apple.com/api/badges/download-on-the-app-store/white/${locale}.svg`;
---

<div class={`inline-flex items-center justify-center ${className} app-store-badge-container`}>
    <img 
        src={blackBadgeUrl} 
        alt="Download on the App Store" 
        class="badge-black h-full w-auto select-none pointer-events-none drop-shadow-[0_4px_12px_rgba(0,0,0,0.15)] hover:drop-shadow-[0_8px_20px_rgba(45,212,191,0.3)] transition-all duration-500"
        loading="lazy"
    />
    <img 
        src={whiteBadgeUrl} 
        alt="Download on the App Store" 
        class="badge-white h-full w-auto select-none pointer-events-none drop-shadow-[0_4px_12px_rgba(255,255,255,0.1)] hover:drop-shadow-[0_8px_20px_rgba(45,212,191,0.3)] transition-all duration-500"
        loading="lazy"
    />
</div>

<style>
    .badge-white { display: none; }
    .badge-black { display: block; }
    
    :global(.dark) .badge-white { display: block; }
    :global(.dark) .badge-black { display: none; }
</style>

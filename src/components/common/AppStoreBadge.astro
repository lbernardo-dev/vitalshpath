---
import { type Lang } from "../../i18n/ui-locales";

interface Props {
    className?: string;
    lang?: Lang;
}

const { className = "h-[40px]", lang = "en" } = Astro.props;

// Official Apple Locale Mappings for the 15 supported languages
const localeMap: Record<Lang, string> = {
    en: "en-US",
    es: "es-ES",
    fr: "fr-FR",
    de: "de-DE",
    it: "it-IT",
    pt: "pt-BR",
    ja: "ja-JP",
    zh: "zh-CN",
    ko: "ko-KR",
    ru: "ru-RU",
    ar: "ar-SA",
    hi: "hi-IN",
    tr: "tr-TR",
    nl: "nl-NL",
    pl: "pl-PL",
};

const locale = localeMap[lang] || "en-US";
const badgeUrl = `https://toolbox.marketingtools.apple.com/api/badges/download-on-the-app-store/black/${locale}.svg`;
---

<div class={`inline-block ${className}`}>
    <img 
        src={badgeUrl} 
        alt="Download on the App Store" 
        class="h-full w-auto block select-none pointer-events-none"
        loading="lazy"
        onerror="this.style.display='none'"
    />
</div>

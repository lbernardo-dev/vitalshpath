---
interface Props {
    type?: "iphone" | "ipad" | "watch-ultra" | "watch-s11" | "watch-se";
    model?: string; // Legacy support
    showIsland?: boolean;
    className?: string;
}

const { type, model, showIsland = true, className = "" } = Astro.props;

// Map model to type for backward compatibility
const deviceType = type || (model?.startsWith("iphone") ? "iphone" : (model?.startsWith("watch") ? "watch-s11" : "iphone"));

interface DeviceConfig {
    wrapper: string;
    screen: string;
    bezel?: string;
    actionButton?: string;
    crown?: string;
    sideButton?: string;
    antenna?: string;
}

// Realistic Apple Device Proportions (2026 Standards)
const configs: Record<string, DeviceConfig> = {
    iphone: {
        wrapper:
            "relative rounded-[3.8rem] bg-[#1a1a1a] p-[8px] overflow-hidden aspect-[9/19.5] border-[1px] border-white/15 ring-2 ring-black/50",
        screen: "w-full h-full rounded-[3.2rem] overflow-hidden bg-black relative",
    },

    ipad: {
        wrapper:
            "relative rounded-[2.8rem] bg-[#1a1a1a] p-[10px] overflow-hidden aspect-[4/3] border-[1px] border-white/10 ring-4 ring-black/30",
        screen: "w-full h-full rounded-[2rem] overflow-hidden bg-black relative",
    },

    "watch-ultra": {
        // Apple Watch Ultra 3 - Titanium (Rugged Design)
        wrapper:
            "relative rounded-[3rem] bg-[#d1d5db] p-[4px] overflow-hidden aspect-[1/1.2] border-[1.5px] border-[#9ca3af] ring-4 ring-[#e5e7eb]",
        screen: "w-full h-full rounded-[2.6rem] overflow-hidden bg-black relative z-10",

        bezel: "absolute inset-0 border-[6px] border-black/40 rounded-[3rem] pointer-events-none z-20",
        actionButton: "absolute -left-1.5 top-[35%] w-2.5 h-16 bg-[#ff6b00] rounded-r-lg z-30 shadow-md border-y border-r border-[#cc5500]",
        crown: "absolute -right-2 top-[22%] w-5 h-16 bg-[#f3f4f6] rounded-l-xl z-30 border-y border-l border-[#d1d5db] shadow-inner",
        sideButton: "absolute -right-1.5 top-[48%] w-2.5 h-20 bg-[#d1d5db] rounded-l-lg z-20 shadow-sm border-l border-zinc-400",
        antenna: "absolute top-[10%] left-1/2 -translate-x-1/2 w-[40%] h-[4px] bg-black/10 rounded-full z-0"
    },
    "watch-s11": {
        // Apple Watch Series 11 - Midnight (Slim Bezel, Rounded)
        wrapper:
            "relative rounded-[2.8rem] bg-[#020617] p-[3px] overflow-hidden aspect-[1/1.2] border-[1px] border-white/15 ring-1 ring-white/5",
        screen: "w-full h-full rounded-[2.5rem] overflow-hidden bg-black relative",

        crown: "absolute -right-1.5 top-[25%] w-3.5 h-10 bg-[#0f172a] rounded-l-lg z-30 border-l border-white/10 shadow-lg",
        sideButton: "absolute -right-1 top-[52%] w-2 h-14 bg-black/80 rounded-l-md z-20 shadow-sm"
    },
    "watch-se": {
        wrapper:
            "relative rounded-[2.2rem] bg-zinc-900 p-[3px] overflow-hidden aspect-[1/1.2] border-[1px] border-white/10",
        screen: "w-full h-full rounded-[2rem] overflow-hidden bg-black relative",

        crown: "absolute -right-1.5 top-1/4 w-3 h-10 bg-zinc-800 rounded-l-md z-10 shadow-sm",
    },
};

const activeConfig = configs[deviceType] || configs.iphone;
---

<div class={`${activeConfig.wrapper} ${className} transition-transform duration-700`}>
    <!-- Hardware Details -->
    {
        type === "watch-ultra" && "bezel" in activeConfig && (
            <>
                <div class={activeConfig.bezel} />
                <div class={activeConfig.actionButton} />
                <div class={activeConfig.crown} />
				<div class={activeConfig.sideButton} />
				<div class={activeConfig.antenna} />
            </>
        )
    }

    {
        type === "watch-s11" && "crown" in activeConfig && (
            <>
                <div class={activeConfig.crown} />
                <div class={activeConfig.sideButton} />
            </>
        )
    }

    {type === "watch-se" && "crown" in activeConfig && <div class={activeConfig.crown} />}

    <!-- Dynamic Island / Sensors for iPhone -->
    {
        deviceType === "iphone" && showIsland && (
            <div class="absolute top-4 left-1/2 -translate-x-1/2 w-[30%] h-[24px] bg-black rounded-full z-40 opacity-95 flex items-center justify-center gap-2">
				<div class="w-1.5 h-1.5 rounded-full bg-blue-500/20 blur-[1px]"></div>
				<div class="w-2 h-2 rounded-full bg-indigo-500/10"></div>
			</div>
        )
    }

    <!-- Screen Content -->
    <div class={activeConfig.screen}>
        <slot />
        <!-- Screen Shine Overlay -->
        <div class="absolute inset-0 pointer-events-none z-50 overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-tr from-transparent via-white/5 to-white/10 opacity-30"></div>
            <div class="absolute top-0 -left-1/2 w-full h-[200%] bg-white/5 skew-x-[-25deg] blur-3xl translate-x-1/2 animate-shimmer"></div>
        </div>
    </div>
</div>

<style>
    @keyframes shimmer {
        0% { transform: translateX(-150%) skewX(-25deg); }
        100% { transform: translateX(150%) skewX(-25deg); }
    }
    
    .animate-shimmer {
        animation: shimmer 8s infinite linear;
    }

    :global(.mockup-image) {
        width: 100% !important;
        height: 100% !important;
        object-fit: contain !important;
        object-position: center top !important;
        display: block !important;
        border-radius: inherit;
        background: #000;
    }
</style>

---
interface Props {
	lang: string;
}

const { lang } = Astro.props;

const messages = {
	es: {
		connection: "No se pudo cargar la cronología. Inténtalo de nuevo más tarde.",
		empty: "Aún no hay versiones publicadas en la cronología.",
		build: "Build",
	},
	en: {
		connection: "The timeline could not be loaded. Please try again later.",
		empty: "No public releases have been published to the timeline yet.",
		build: "Build",
	},
};

const copy = messages[lang as keyof typeof messages] ?? messages.en;
---

<div
	id="timeline-container"
	class="relative space-y-12 before:absolute before:left-[11px] before:top-4 before:h-[calc(100%-32px)] before:w-0.5 before:bg-slate-200 dark:before:bg-white/10 sm:space-y-16 sm:before:left-[1.65rem]"
	data-empty-message={copy.empty}
	data-error-message={copy.connection}
	data-build-label={copy.build}
>
	<div class="animate-pulse space-y-12">
		{[1, 2].map(() => (
			<div class="group relative pl-10 sm:pl-16">
				<div class="absolute left-0 top-1.5 h-6 w-6 rounded-full bg-slate-200 dark:bg-white/5 sm:h-[54px] sm:w-[54px]" />
				<div class="mb-4 h-8 w-1/3 rounded-lg bg-slate-200 dark:bg-white/5" />
				<div class="h-48 w-full rounded-[2rem] bg-slate-200 dark:bg-white/5" />
			</div>
		))}
	</div>
</div>

<template id="release-template">
	<div class="group relative pl-10 sm:pl-16 reveal-fade">
		<div class="absolute left-0 top-1.5 flex h-6 w-6 items-center justify-center rounded-full bg-white ring-4 ring-slate-50 transition-all duration-500 group-hover:scale-110 group-hover:ring-sky-500/20 dark:bg-slate-950 dark:ring-slate-900 dark:group-hover:ring-teal-400/20 sm:h-[54px] sm:w-[54px] sm:ring-8">
			<div class="h-2 w-2 rounded-full bg-sky-500 group-hover:animate-pulse sm:h-3 sm:w-3"></div>
		</div>

		<div class="flex flex-col gap-5">
			<div class="flex flex-wrap items-center gap-4">
				<div class="flex items-baseline gap-2">
					<span class="version-text text-3xl font-black tracking-tight text-slate-950 dark:text-white sm:text-4xl"></span>
					<span class="build-text text-sm font-bold text-slate-400 dark:text-slate-500"></span>
				</div>
				<time class="date-text ml-auto text-sm font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500"></time>
			</div>

			<div class="glass-container rounded-[1.75rem] border border-slate-200/80 bg-white/80 p-6 shadow-[0_32px_64px_-48px_rgba(15,23,42,0.25)] backdrop-blur-2xl transition-all duration-500 group-hover:border-sky-500/30 group-hover:bg-white/95 dark:border-white/10 dark:bg-white/[0.05] dark:group-hover:bg-white/10 sm:p-8">
				<ul class="changes-list space-y-5"></ul>
			</div>
		</div>
	</div>
</template>

<script>
	import { getSupabase } from "../../lib/supabase/client";

	type Release = {
		version: string;
		build_number: string;
		created_at: string;
		translations?: Record<string, string[]>;
	};

	function escapeHtml(value: string) {
		const span = document.createElement("span");
		span.textContent = value;
		return span.innerHTML;
	}

	function renderMessage(container: HTMLElement, message: string) {
		container.innerHTML = `
			<div class="rounded-[1.75rem] border border-slate-200 bg-white/70 p-8 text-center backdrop-blur-xl dark:border-white/10 dark:bg-white/5">
				<p class="text-base font-semibold leading-7 text-slate-500 dark:text-slate-400">${escapeHtml(message)}</p>
			</div>
		`;
	}

	async function loadTimeline() {
		const container = document.getElementById("timeline-container");
		const template = document.getElementById("release-template") as HTMLTemplateElement | null;
		const currentLang = document.documentElement.lang || "en";

		if (!container || !template) return;

		const emptyMessage = container.dataset.emptyMessage || "No public releases have been published yet.";
		const errorMessage = container.dataset.errorMessage || "The timeline could not be loaded.";
		const buildLabel = container.dataset.buildLabel || "Build";
		const supabase = getSupabase();

		if (!supabase) {
			renderMessage(container, errorMessage);
			return;
		}

		const { data, error } = await supabase
			.from("releases")
			.select("version, build_number, translations, created_at")
			.eq("is_public", true)
			.order("created_at", { ascending: false });

		const releases = data as Release[] | null;

		if (error) {
			console.error("Timeline load error:", error);
			renderMessage(container, errorMessage);
			return;
		}

		if (!releases?.length) {
			renderMessage(container, emptyMessage);
			return;
		}

		container.innerHTML = "";

		releases.forEach((release) => {
			const clone = template.content.cloneNode(true) as HTMLElement;
			const versionEl = clone.querySelector(".version-text");
			const buildEl = clone.querySelector(".build-text");
			const dateEl = clone.querySelector(".date-text");
			const listEl = clone.querySelector(".changes-list");

			if (versionEl) versionEl.textContent = `v${release.version}`;
			if (buildEl) buildEl.textContent = `${buildLabel} ${release.build_number}`;
			if (dateEl) {
				dateEl.textContent = new Date(release.created_at).toLocaleDateString(currentLang, {
					year: "numeric",
					month: "short",
					day: "numeric",
				});
			}

			const changes = release.translations?.[currentLang] || release.translations?.en || [];

			if (listEl) {
				changes.forEach((change) => {
					const li = document.createElement("li");
					li.className =
						"flex gap-4 text-[1.02rem] font-medium leading-7 text-slate-600 transition-colors duration-300 group-hover:text-slate-950 dark:text-slate-300 dark:group-hover:text-white";
					li.innerHTML = `
						<span class="mt-2.5 h-2 w-2 flex-none rounded-full bg-sky-500/30 transition-colors duration-300 group-hover:bg-sky-500"></span>
						<span>${escapeHtml(change)}</span>
					`;
					listEl.appendChild(li);
				});
			}

			container.appendChild(clone);
		});
	}

	loadTimeline();
	document.addEventListener("astro:page-load", loadTimeline);
</script>

<style>
	.glass-container {
		box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
	}

	.reveal-fade {
		animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	@keyframes reveal {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>

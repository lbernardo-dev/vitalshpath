---
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { getAppStoreUrlForLang, getDefaultAppStoreLinks } from "../../lib/app-store-links";
import { ShieldCheck, Heart, Sparkles } from "lucide-react";
import AppStoreBadge from "../common/AppStoreBadge.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());
---

<section class="py-20 sm:py-24 bg-transparent relative z-10 overflow-hidden">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        
        <div class="relative overflow-hidden rounded-[3rem] p-10 sm:p-16 lg:p-20 glass-panel border border-teal-vibrant/20 dark:border-teal-primary/30 bg-gradient-to-br from-white/80 to-slate-50/50 dark:from-slate-900/80 dark:to-slate-900/40 shadow-2xl reveal">
            <!-- Decorative Glow -->
            <div class="absolute -top-32 -right-32 w-96 h-96 bg-teal-vibrant/30 dark:bg-teal-primary/20 blur-[100px] rounded-full pointer-events-none"></div>
            <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-coral-accent/30 dark:bg-orange-accent/10 blur-[100px] rounded-full pointer-events-none"></div>

            <div class="relative z-10 flex flex-col items-center text-center">
                <div class="inline-flex items-center px-4 py-1.5 rounded-full glass-panel border border-teal-vibrant/20 dark:border-teal-primary/30 mb-8 shadow-sm">
                    <span class="text-teal-vibrant dark:text-teal-primary text-[11px] font-bold tracking-[0.2em] uppercase">
                        {copy.home.ctaBadge}
                    </span>
                </div>

                <h2 class="text-4xl sm:text-5xl lg:text-5xl font-black text-slate-900 dark:text-white mb-6 tracking-tighter text-balance">
                    {copy.home.ctaTitle}
                </h2>
                
                <p class="text-lg text-slate-600 dark:text-slate-400 font-medium mb-12 max-w-2xl mx-auto text-balance">
                    {copy.home.footnote}
                </p>

                <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
                    <a
                        href={appStoreHref}
                        class="hover:scale-105 active:scale-95 transition-all duration-300 shadow-[0_20px_40px_-15px_rgba(0,0,0,0.1)] hover:shadow-[0_30px_60px_-15px_rgba(0,0,0,0.2)] dark:hover:shadow-[0_30px_60px_-15px_rgba(255,255,255,0.05)] rounded-2xl"
                        aria-label="Download on the App Store"
                    >
                        <AppStoreBadge className="h-[60px] md:h-[64px]" lang={lang} />
                    </a>
                </div>

                <!-- Benefits Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 w-full pt-10 border-t border-slate-200/50 dark:border-white/10">
                    <div class="flex flex-col items-center text-center">
                        <div class="w-12 h-12 rounded-[1rem] bg-teal-vibrant/10 dark:bg-teal-primary/10 flex items-center justify-center text-teal-vibrant dark:text-teal-primary mb-4">
                            <ShieldCheck className="w-6 h-6" />
                        </div>
                        <h4 class="font-bold text-slate-900 dark:text-white mb-2">{copy.home.sections[2].title}</h4>
                        <p class="text-sm text-slate-600 dark:text-slate-400 font-medium">{copy.home.ctaPrivacyDetail}</p>
                    </div>
                    
                    <div class="flex flex-col items-center text-center">
                        <div class="w-12 h-12 rounded-[1rem] bg-coral-accent/10 dark:bg-orange-accent/10 flex items-center justify-center text-coral-accent dark:text-orange-accent mb-4">
                            <Heart className="w-6 h-6" />
                        </div>
                        <h4 class="font-bold text-slate-900 dark:text-white mb-2">{copy.home.ctaPremiumTitle}</h4>
                        <p class="text-sm text-slate-600 dark:text-slate-400 font-medium">{copy.home.ctaPremiumDetail}</p>
                    </div>

                    <div class="flex flex-col items-center text-center">
                        <div class="w-12 h-12 rounded-[1rem] bg-blue-500/10 dark:bg-blue-500/20 flex items-center justify-center text-blue-500 mb-4">
                            <Sparkles className="w-6 h-6" />
                        </div>
                        <h4 class="font-bold text-slate-900 dark:text-white mb-2">{copy.home.ctaCommunityTitle}</h4>
                        <p class="text-sm text-slate-600 dark:text-slate-400 font-medium">{copy.home.ctaCommunityDetail}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

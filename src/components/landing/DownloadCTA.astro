---
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { getAppStoreUrlForLang, getDefaultAppStoreLinks } from "../../lib/app-store-links";
import { ShieldCheck, Heart, Sparkles } from "lucide-react";
import AppStoreBadge from "../common/AppStoreBadge.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());
---

<section class="py-20 sm:py-24 bg-transparent">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-12">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-text dark:text-white mb-4 tracking-tight">
                {copy.home.ctaTitle}
            </h2>
            <p class="text-lg text-slate-muted leading-relaxed max-w-2xl mx-auto">
                {copy.home.footnote}
            </p>
        </div>
         
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
            <a
                href={appStoreHref}
                class="hover:scale-105 active:scale-95 transition-transform"
                aria-label="Download on the App Store"
            >
                <AppStoreBadge className="h-[60px] md:h-[64px]" lang={lang} />
            </a>
        </div>
        
        <!-- Benefits Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center p-6">
                <div class="w-12 h-12 rounded-2xl bg-teal-primary/10 flex items-center justify-center text-teal-primary mx-auto mb-4">
                    <ShieldCheck className="w-6 h-6" />
                </div>
                <h4 class="font-bold text-slate-text dark:text-white mb-2">{copy.home.sections[2].title}</h4>
                <p class="text-sm text-slate-muted">{copy.home.ctaPrivacyDetail}</p>
            </div>
            
            <div class="text-center p-6">
                <div class="w-12 h-12 rounded-2xl bg-orange-accent/10 flex items-center justify-center text-orange-accent mx-auto mb-4">
                    <Heart className="w-6 h-6" />
                </div>
                <h4 class="font-bold text-slate-text dark:text-white mb-2">{copy.home.ctaPremiumTitle}</h4>
                <p class="text-sm text-slate-muted">{copy.home.ctaPremiumDetail}</p>
            </div>

            <div class="text-center p-6">
                <div class="w-12 h-12 rounded-2xl bg-teal-primary/10 flex items-center justify-center text-teal-primary mx-auto mb-4">
                    <Sparkles className="w-6 h-6" />
                </div>
                <h4 class="font-bold text-slate-text dark:text-white mb-2">{copy.home.ctaCommunityTitle}</h4>
                <p class="text-sm text-slate-muted">{copy.home.ctaCommunityDetail}</p>
            </div>
        </div>

    </div>
</section>

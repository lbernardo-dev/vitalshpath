---
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { 
    getAppStoreUrlForLang, 
    getDefaultAppStoreLinks 
} from "../../lib/app-store-links";
import { ArrowRight, ShieldCheck, Heart } from "lucide-react";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());
---

<section class="py-24 sm:py-32 relative overflow-hidden">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <div class="reveal reveal-scale glass-panel p-8 sm:p-16 lg:p-24 overflow-hidden relative">
            <!-- Background effects -->
            <div class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-[40rem] h-[40rem] bg-teal-primary/10 blur-[120px]"></div>
            <div class="absolute bottom-0 left-0 translate-y-1/2 -translate-x-1/2 w-[30rem] h-[30rem] bg-orange-accent/10 blur-[100px]"></div>
            
            <div class="relative z-10 text-center max-w-4xl mx-auto">
                <div class="inline-flex items-center gap-2 mb-10 px-4 py-2 rounded-full border border-teal-primary/10 bg-teal-primary/5 backdrop-blur-sm">
                    <Heart className="w-4 h-4 text-orange-accent fill-orange-accent" />
                    <span class="text-[10px] font-black uppercase tracking-[0.4em] text-teal-primary">
                        VitalsPath
                    </span>
                </div>
                
                <h3 class="text-4xl sm:text-6xl font-serif text-slate-text leading-tight mb-8">
                    {lang === 'es' ? 'Tu salud, perfectamente organizada y privada' : 'Your health, perfectly organized and private'}
                </h3>
                
                <p class="text-lg sm:text-xl font-medium text-slate-muted mb-12 leading-relaxed max-w-2xl mx-auto">
                    {copy.home.footnote}
                </p>
                
                <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
                    <a
                        href={appStoreHref}
                        data-app-store-link
                        class="btn-primary flex items-center justify-center gap-3 w-full sm:w-auto"
                    >
                        {copy.home.primaryCta}
                        <ArrowRight className="w-5 h-5 transition-transform group-hover:translate-x-1" />
                    </a>
                </div>
                
                <div class="mt-20 pt-12 border-t border-slate-200 dark:border-white/10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 items-center">
                    <div class="flex items-center justify-center sm:justify-start gap-4">
                        <div class="w-14 h-14 rounded-2xl bg-teal-primary/10 flex items-center justify-center text-teal-primary border border-teal-primary/5">
                            <ShieldCheck className="w-7 h-7" />
                        </div>
                        <div class="text-left">
                            <h4 class="text-slate-text font-black text-sm uppercase tracking-wider">{copy.home.sections[2].title}</h4>
                            <p class="text-[13px] font-medium text-slate-muted leading-snug">{lang === 'es' ? 'Privacidad absoluta con cifrado de extremo a extremo.' : 'Absolute privacy with end-to-end encryption.'}</p>
                        </div>
                    </div>
                    
                    <div class="flex items-center justify-center sm:justify-start gap-4">
                        <div class="w-14 h-14 rounded-2xl bg-orange-accent/10 flex items-center justify-center text-orange-accent border border-orange-accent/5">
                            <Heart className="w-7 h-7" />
                        </div>
                        <div class="text-left">
                            <h4 class="text-slate-text font-black text-sm uppercase tracking-wider">PREMIUM CARE</h4>
                            <p class="text-[13px] font-medium text-slate-muted leading-snug">{lang === 'es' ? 'Diseñado para pacientes crónicos y cuidadores.' : 'Designed for chronic patients and caregivers.'}</p>
                        </div>
                    </div>

                    <div class="hidden lg:flex items-center justify-center sm:justify-start gap-4">
                         <div class="flex -space-x-3 overflow-hidden">
                            {[1, 2, 3, 4].map((i) => (
                                <div class="inline-block h-10 w-10 rounded-full ring-2 ring-cream dark:ring-slate-900 bg-slate-200 dark:bg-slate-800 flex items-center justify-center text-[10px] font-bold text-slate-400">
                                    {String.fromCharCode(64 + i)}
                                </div>
                            ))}
                        </div>
                        <div class="text-left">
                            <p class="text-[13px] font-medium text-slate-muted leading-snug">
                                <span class="font-bold text-teal-primary">+20k</span> {lang === 'es' ? 'usuarios activos' : 'active users'}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

---
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { getAppStoreUrlForLang, getDefaultAppStoreLinks } from "../../lib/app-store-links";
import { ShieldCheck, Heart, Sparkles, Star } from "lucide-react";
import AppStoreBadge from "../common/AppStoreBadge.astro";
import { Image } from "astro:assets";

// Import a high-impact screen for the CTA
import screenDashboard from "../../assets/images/app-mockup.png";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());


---

<section class="relative z-10 overflow-hidden bg-white py-12 sm:py-16 dark:bg-[#080b0f]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        
        <div class="relative overflow-hidden rounded-3xl border border-slate-200 bg-[linear-gradient(135deg,#f8fbff_0%,#eef8ff_60%,#ffffff_100%)] p-6 shadow-[0_40px_100px_-46px_rgba(15,23,42,0.45)] reveal sm:p-10 lg:p-12 dark:border-white/10 dark:bg-[linear-gradient(135deg,#101823_0%,#0b1316_65%,#111827_100%)]">

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center relative z-10">
                
                <!-- Left: Conversion Text -->
                <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
                    <div class="mb-6 inline-flex items-center rounded-lg bg-sky-100 px-3 py-1.5 dark:bg-teal-300/10">
                        <Star className="mr-2 h-3.5 w-3.5 fill-current text-sky-700 dark:text-teal-200" />
                        <span class="text-[10px] font-black uppercase tracking-widest text-sky-700 dark:text-teal-200">
                            {copy.home.ctaBadge}
                        </span>
                    </div>

                    <h2 class="mb-6 text-[clamp(2.1rem,5vw,4.55rem)] font-black leading-none tracking-tight text-slate-950 dark:text-white">
                        {copy.home.ctaTitle}
                    </h2>
                    
                    <p class="mb-10 max-w-xl text-lg font-medium leading-8 text-slate-600 dark:text-slate-300 md:text-xl">
                        {copy.home.heroSubtitle}
                    </p>

                    <div class="flex flex-col sm:flex-row gap-6 items-center mb-10">
                        <a
                            href={appStoreHref}
                            class="group transition-transform duration-300 hover:scale-[1.03] active:scale-[0.98]"
                            aria-label="Download on the App Store"
                        >
                            <AppStoreBadge className="h-[56px] md:h-[64px]" lang={lang} />
                        </a>
                        

                    </div>

                    <p class="max-w-md text-[11px] font-bold leading-5 tracking-tight text-slate-500 dark:text-slate-400">
                        {copy.home.footnote}
                    </p>
                </div>

                <!-- Right: High Fidelity Device Mockup -->
                <div class="relative flex justify-center lg:justify-end reveal-scale">
                    <!-- Floating Widget Mockup -->
                    <div class="absolute -left-8 top-1/4 z-20 hidden h-32 w-32 rounded-2xl border border-slate-200 bg-white/80 p-4 shadow-2xl backdrop-blur-xl sm:block dark:border-white/10 dark:bg-slate-900/80">
                        <div class="flex h-full w-full items-center justify-center rounded-xl bg-sky-100 dark:bg-teal-300/10">
                            <ShieldCheck className="h-10 w-10 text-sky-700 dark:text-teal-200" />
                        </div>
                    </div>

                    <!-- Main Phone -->
                    <div class="relative w-[250px] rotate-2 transform overflow-hidden rounded-[3rem] bg-slate-900 shadow-[0_50px_100px_-24px_rgba(0,0,0,0.5)] ring-1 ring-white/20 sm:w-[300px]">
                        <Image
                            src={screenDashboard}
                            alt="VitalsPath Dashboard"
                            class="h-auto w-full"
                        />
                    </div>
                </div>
            </div>

            <!-- Trust Bar -->
            <div class="mt-14 grid grid-cols-1 gap-6 border-t border-slate-200/70 pt-10 sm:grid-cols-3 dark:border-white/10">
                <div class="flex items-center gap-4 group">
                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-sky-100 text-sky-700 transition-transform group-hover:scale-105 dark:bg-teal-300/10 dark:text-teal-200">
                        <ShieldCheck className="h-6 w-6" />
                    </div>
                    <div>
                        <h4 class="text-sm font-black uppercase tracking-tight text-slate-950 dark:text-white">{copy.home.sections[2].title}</h4>
                        <p class="text-xs font-medium text-slate-600 dark:text-slate-300">{copy.home.ctaPrivacyDetail}</p>
                    </div>
                </div>
                <div class="flex items-center gap-4 group">
                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-orange-100 text-orange-600 transition-transform group-hover:scale-105 dark:bg-orange-300/10 dark:text-orange-200">
                        <Heart className="h-6 w-6" />
                    </div>
                    <div>
                        <h4 class="text-sm font-black uppercase tracking-tight text-slate-950 dark:text-white">{copy.home.ctaPremiumTitle}</h4>
                        <p class="text-xs font-medium text-slate-600 dark:text-slate-300">{copy.home.ctaPremiumDetail}</p>
                    </div>
                </div>
                <div class="flex items-center gap-4 group">
                    <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 transition-transform group-hover:scale-105 dark:bg-emerald-300/10 dark:text-emerald-200">
                        <Sparkles className="h-6 w-6" />
                    </div>
                    <div>
                        <h4 class="text-sm font-black uppercase tracking-tight text-slate-950 dark:text-white">{copy.home.ctaCommunityTitle}</h4>
                        <p class="text-xs font-medium text-slate-600 dark:text-slate-300">{copy.home.ctaCommunityDetail}</p>
                    </div>
                </div>
            </div>

        </div>

    </div>
</section>

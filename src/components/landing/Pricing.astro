---
import {
    Smartphone,
    Zap,
    Star,
    Shield,
    Layout as LayoutIcon,
    Bell,
    Repeat,
    BarChart3,
    Globe,
    Heart,
    Layers,
    Infinity,
    Calendar,
    Check,
} from "lucide-react";
import { type Lang } from "../../i18n/ui-locales";
import { useTranslations } from "../../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const premiumFeatures = [
    { key: "unlimited_profiles", icon: Infinity },
    { key: "smart_scheduler_ia", icon: Zap },
    { key: "advanced_analytics", icon: BarChart3 },
    { key: "health_reports", icon: Layers },
    { key: "health_status", icon: Heart },
    { key: "gamification", icon: Star },
    { key: "icloud_backup", icon: Shield },
    { key: "all_themes", icon: LayoutIcon },
    { key: "advanced_notifications", icon: Bell },
    { key: "export_pdf_csv", icon: Globe },
];
---

<section
    id="pricing"
    class="py-16 md:py-32 relative overflow-hidden bg-white dark:bg-black"
>
    <!-- Ambient background -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-500/10 blur-[150px] rounded-full"
        >
        </div>
        <div
            class="absolute bottom-0 right-0 w-[500px] h-[500px] bg-purple-500/10 blur-[120px] rounded-full"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16 md:mb-24 reveal">
            <h2
                class="text-4xl md:text-6xl font-black text-gray-900 dark:text-white mb-6 tracking-tight italic"
            >
                {t("pricing.title")}
            </h2>
            <p class="text-xl text-gray-600 dark:text-gray-400 font-medium">
                {t("pricing.subtitle")}
            </p>
        </div>

        <div class="max-w-5xl mx-auto reveal">
            <!-- Single Pricing Box -->
            <div
                class="relative p-[1px] rounded-[40px] bg-gradient-to-br from-blue-500/20 via-purple-500/20 to-pink-500/20 shadow-2xl"
            >
                <div
                    class="bg-white/80 dark:bg-zinc-900/90 rounded-[39px] backdrop-blur-3xl overflow-hidden border border-white/10"
                >
                    <div class="grid grid-cols-1 lg:grid-cols-12">
                        <!-- Left: Free Highlight -->
                        <div
                            class="lg:col-span-5 p-8 md:p-12 bg-gradient-to-br from-blue-500/5 to-transparent relative"
                        >
                            <div
                                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-500/10 text-blue-500 text-[11px] font-black uppercase tracking-widest mb-8"
                            >
                                <Zap className="w-3.5 h-3.5 fill-current" />
                                {t("pricing.free.functional_badge")}
                            </div>

                            <h3
                                class="text-4xl md:text-5xl font-black text-gray-900 dark:text-white mb-6 italic"
                            >
                                {t("pricing.free.title")}
                            </h3>

                            <p
                                class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed font-medium mb-10"
                            >
                                {t("pricing.free.description")}
                            </p>

                            <div
                                class="p-6 rounded-3xl bg-blue-500/10 border border-blue-500/20 relative overflow-hidden group hover:bg-blue-500/20 transition-colors"
                            >
                                <div
                                    class="absolute -right-8 -bottom-8 w-24 h-24 bg-blue-500/10 blur-2xl rounded-full"
                                >
                                </div>
                                <span
                                    class="text-xs font-black text-blue-500 uppercase tracking-[0.2em] block mb-2"
                                >
                                    {t("pricing.free.forever_badge")}
                                </span>
                                <p
                                    class="text-sm text-gray-700 dark:text-gray-300 font-bold"
                                >
                                    Ideal para uso individual y gestión básica
                                    familiar sin suscripción.
                                </p>
                            </div>
                        </div>

                        <!-- Right: Premium Info -->
                        <div
                            class="lg:col-span-7 p-8 md:p-12 lg:border-l border-gray-100 dark:border-white/5"
                        >
                            <div class="mb-10">
                                <h4
                                    class="text-xs font-black uppercase tracking-widest text-gray-400 mb-6"
                                >
                                    Próximas modalidades Premium:
                                </h4>
                                <div class="flex flex-wrap gap-3">
                                    {
                                        ["monthly", "annual", "lifetime"].map(
                                            (p) => (
                                                <div class="px-5 py-2.5 rounded-2xl bg-gray-50 dark:bg-white/5 border border-gray-100 dark:border-white/10 text-gray-700 dark:text-gray-300 text-xs font-black uppercase tracking-wider hover:border-blue-500/30 transition-all cursor-default">
                                                    {t(`pricing.${p}.title`)}
                                                </div>
                                            )
                                        )
                                    }
                                </div>
                            </div>

                            <div class="space-y-8">
                                <h4
                                    class="text-xs font-black uppercase tracking-widest text-gray-400"
                                >
                                    {t("pricing.premium.features_title")}
                                </h4>

                                <div
                                    class="grid grid-cols-1 sm:grid-cols-2 gap-6"
                                >
                                    {
                                        premiumFeatures.map((f) => (
                                            <div class="flex items-start gap-3 group">
                                                <div class="w-8 h-8 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-500 shrink-0 group-hover:scale-110 transition-transform">
                                                    <f.icon className="w-4 h-4" />
                                                </div>
                                                <div>
                                                    <p class="text-xs font-black text-gray-900 dark:text-white mb-1 uppercase tracking-tight">
                                                        {t(
                                                            `pricing.features.${f.key}`
                                                        )}
                                                    </p>
                                                    <p class="text-[10px] text-gray-500 dark:text-gray-500 leading-normal font-medium">
                                                        {(() => {
                                                            const specificDesc =
                                                                t(
                                                                    `pricing.features.${f.key}_desc`
                                                                );
                                                            return specificDesc.includes(
                                                                `pricing.features.${f.key}_desc`
                                                            )
                                                                ? t(
                                                                      "pricing.premium.feature_desc"
                                                                  )
                                                                : specificDesc;
                                                        })()}
                                                    </p>
                                                </div>
                                            </div>
                                        ))
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Single CTA Footer -->
                    <div
                        class="p-8 md:p-12 border-t border-gray-100 dark:border-white/5 bg-gray-50/50 dark:bg-black/20 text-center"
                    >
                        <a
                            href="#waitlist"
                            class="inline-block py-5 px-16 bg-gray-900 dark:bg-white text-white dark:text-gray-950 font-black rounded-3xl hover:scale-105 transition-all shadow-xl shadow-blue-500/10 dark:shadow-white/10 text-lg uppercase tracking-widest"
                        >
                            {t("pricing.cta_alt")}
                        </a>
                        <p
                            class="mt-6 text-xs text-gray-500 dark:text-gray-500 font-bold uppercase tracking-widest"
                        >
                            Sin compromisos · 100% Privado · Lanzamiento 2026
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // Handle Pricing CTA
    const pricingCta = document.querySelector(
        'section#pricing a[href="#waitlist"]'
    );
    if (pricingCta) {
        pricingCta.addEventListener("click", () => {
            localStorage.setItem(
                "vitalspath_interested_plan",
                "general_waitlist"
            );
        });
    }
</script>

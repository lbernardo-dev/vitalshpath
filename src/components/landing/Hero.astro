---
import { Image } from "astro:assets";
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { getAppStoreUrlForLang, getDefaultAppStoreLinks } from "../../lib/app-store-links";
import AppStoreBadge from "../common/AppStoreBadge.astro";

import screenHome from "../../assets/images/screens/screen-01-dashboard.PNG";
import screenMeds from "../../assets/images/screens/screen-04-medications.PNG";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());

const heroTitle = copy.home.heroTitle;
const periodIndex = heroTitle.indexOf('. ');
let headingPart1 = heroTitle;
let headingPart2 = "";

if (periodIndex !== -1) {
    headingPart1 = heroTitle.substring(0, periodIndex + 1);
    headingPart2 = heroTitle.substring(periodIndex + 2);
} else {
    headingPart1 = heroTitle;
}
---

<section class="relative min-h-screen flex flex-col justify-center items-center pt-40 pb-32 overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[1000px] h-[500px] bg-teal-vibrant/10 dark:bg-teal-vibrant/5 blur-[120px] rounded-[100%] -z-10 pointer-events-none"></div>

    <div class="container mx-auto px-6 relative z-10 w-full flex flex-col items-center">
        <!-- Top Column: Content -->
        <div class="flex flex-col items-center text-center max-w-5xl mx-auto reveal">
            <div class="inline-flex items-center px-4 py-1.5 rounded-full glass-panel border border-teal-vibrant/20 dark:border-teal-vibrant/10 mb-8 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-teal-vibrant animate-pulse mr-2"></span>
                <span class="text-teal-vibrant text-[11px] font-bold tracking-[0.2em] uppercase">
                    {copy.home.heroBadge || (lang === 'es' ? 'PRIVADO Y SEGURO' : 'PRIVATE & SECURE')}
                </span>
            </div>
            
            <h1 class="text-6xl sm:text-7xl md:text-8xl lg:text-[7.5rem] leading-[0.95] mb-8 font-black tracking-tighter text-balance text-slate-900 dark:text-white">
                {headingPart1}
                {headingPart2 && (
                    <span class="text-gradient block mt-2 text-5xl sm:text-6xl md:text-7xl lg:text-[6.5rem] opacity-90">{headingPart2}</span>
                )}
            </h1>

            <p class="text-xl md:text-2xl text-slate-600 dark:text-slate-400 mb-12 leading-relaxed max-w-2xl font-medium text-balance">
                {copy.home.heroSubtitle}
            </p>

            <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
                <a
                    href={appStoreHref}
                    class="hover:scale-105 transition-transform duration-400 active:scale-95 shadow-[0_0_40px_-10px_rgba(45,212,191,0.25)] hover:shadow-[0_0_60px_-10px_rgba(45,212,191,0.4)] rounded-[1.2rem] overflow-hidden"
                    aria-label="Download on the App Store"
                >
                    <AppStoreBadge className="h-[60px]" lang={lang} />
                </a>
            </div>

            <p class="text-[11px] font-medium text-slate-400 dark:text-slate-600 max-w-md italic mt-8">
                * {copy.common.medicalDisclaimer}
            </p>
        </div>

        <!-- Bottom Column: Floating Mockups -->
        <div class="relative w-full max-w-5xl mx-auto mt-24 lg:mt-32 reveal-scale stagger-2 perspective-1000">
            <!-- Glowing background behind devices -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4/5 h-4/5 bg-gradient-to-tr from-teal-vibrant/30 to-coral-accent/10 blur-[140px] rounded-full -z-10 animate-pulse-slow mix-blend-screen dark:mix-blend-lighten pointer-events-none"></div>
            
            <div class="relative flex justify-center items-center w-full aspect-[4/3] sm:aspect-[2/1] md:aspect-[21/9] lg:aspect-[2.5/1]">
                <!-- Secondary Phone (Left / Back) -->
                <div class="absolute left-[8%] md:left-[15%] lg:left-[22%] w-[45%] md:w-[32%] lg:w-[28%] z-0 transform -rotate-12 translate-y-8 sm:translate-y-12 translate-z-[-100px] opacity-70 transition-all duration-1000 ease-out hover:-rotate-6 hover:translate-y-4 hover:translate-z-[-50px] hover:opacity-100">
                    <!-- CSS Device Frame -->
                    <div class="relative w-full aspect-[1170/2532] rounded-[2.5rem] border-[8px] sm:border-[10px] border-slate-900 bg-slate-900 shadow-2xl overflow-hidden ring-1 ring-white/20">
                        <div class="absolute top-2 left-1/2 -translate-x-1/2 w-[35%] h-5 sm:h-6 bg-black rounded-full z-20"></div>
                        <Image
                            src={screenMeds}
                            alt="VitalsPath Medications Tracking"
                            class="w-full h-full object-cover rounded-[1.75rem]"
                            loading="lazy"
                        />
                    </div>
                </div>

                <!-- Main Phone (Center / Front) -->
                <div class="relative z-10 w-[55%] md:w-[40%] lg:w-[35%] transform transition-all duration-1000 ease-out hover:scale-[1.02] hover:-translate-y-4 shadow-[0_30px_60px_-15px_rgba(0,0,0,0.3)] dark:shadow-[0_30px_60px_-15px_rgba(0,0,0,0.6)] rounded-[3rem]">
                    <!-- CSS Device Frame -->
                    <div class="relative w-full aspect-[1170/2532] rounded-[3rem] border-[10px] sm:border-[14px] border-black bg-black shadow-2xl overflow-hidden ring-1 ring-white/10 dark:ring-white/20">
                        <div class="absolute top-2 sm:top-3 left-1/2 -translate-x-1/2 w-[30%] h-6 sm:h-7 bg-black rounded-full z-20"></div>
                        <Image
                            src={screenHome}
                            alt="VitalsPath Main Interface"
                            class="w-full h-full object-cover rounded-[2rem] sm:rounded-[2.25rem]"
                            loading="eager"
                        />
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<style>
    .perspective-1000 {
        perspective: 1000px;
    }
</style>

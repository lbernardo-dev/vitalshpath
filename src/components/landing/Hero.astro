---
import { Image } from "astro:assets";
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { getAppStoreUrlForLang, getDefaultAppStoreLinks } from "../../lib/app-store-links";
import { ShieldCheck, ChevronRight } from "lucide-react";

import iphoneHome from "../../assets/images/devices/iphone_home.png";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());

const titleWords = copy.home.heroTitle.split(" ");
const lastWord = titleWords.pop();
const mainTitle = titleWords.join(" ");
---

<section class="relative min-h-[100vh] flex flex-col items-center justify-start pt-40 md:pt-48 pb-0 overflow-hidden">
    <!-- Ambient Glows -->
    <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-teal-primary/10 blur-[140px] rounded-full animate-float -z-10"></div>
    <div class="absolute top-1/3 right-1/4 w-[400px] h-[400px] bg-orange-accent/5 blur-[120px] rounded-full animate-float -z-10" style="animation-delay: -3s;"></div>

    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 relative z-10 w-full flex flex-col items-center text-center">
        <!-- Badge — always visible, no reveal -->
        <div class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full glass-panel mb-8 border-white/40 shadow-sm hover:scale-105 transition-transform duration-300">
            <ShieldCheck className="w-5 h-5 text-teal-primary" />
            <span class="text-[11px] font-black uppercase tracking-[0.2em] text-teal-primary">
                {copy.home.heroBadge}
            </span>
        </div>

        <!-- Headline — always visible -->
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-[6rem] leading-[1] mb-8 font-black tracking-tighter text-slate-text">
            {mainTitle} <span class="block mt-2 text-gradient">{lastWord}</span>
        </h1>

        <!-- Subtitle — always visible -->
        <p class="text-lg sm:text-xl text-slate-muted mb-10 leading-relaxed max-w-2xl mx-auto font-medium">
            {copy.home.heroSubtitle}
        </p>

        <!-- CTAs — always visible -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mb-8 w-full">
            <a
                href={appStoreHref}
                data-app-store-link
                target="_blank"
                rel="noopener noreferrer"
                class="btn-liquid-glass w-full sm:w-auto text-slate-text dark:text-white"
            >
                <div class="flex items-center gap-3">
                    {copy.home.primaryCta}
                    <ChevronRight className="w-5 h-5" />
                </div>
            </a>
        </div>

        <!-- Medical Disclaimer — always visible -->
        <p class="text-[11px] font-medium text-slate-muted/50 max-w-md mx-auto italic mb-16">
            {copy.common.medicalDisclaimer}
        </p>

        <!-- Phone Mockup — always visible -->
        <div class="relative w-full max-w-[320px] md:max-w-[420px] mt-8">
            <!-- Glow behind phone -->
            <div class="absolute left-1/2 -translate-x-1/2 top-10 w-[120%] h-[80%] bg-teal-primary/20 blur-[100px] -z-10 rounded-[4rem]"></div>
            
            <div class="relative z-20 animate-float" style="animation-duration: 12s;">
                <div class="rounded-[3.2rem] p-3 sm:p-4 bg-white/40 dark:bg-white/5 backdrop-blur-[50px] border border-white/80 dark:border-white/10 shadow-premium">
                    <Image
                        src={iphoneHome}
                        alt="VitalsPath App Interface"
                        class="rounded-[2.5rem] shadow-sm w-full h-auto"
                        loading="eager"
                    />
                </div>

                <!-- Floating pills -->
                <div class="hidden sm:block absolute -top-4 -right-8 glass-panel py-3 px-5 shadow-xl animate-float" style="animation-delay: -2s">
                    <span class="text-[10px] font-black text-teal-primary tracking-widest uppercase">Live Sync</span>
                </div>
                <div class="hidden sm:block absolute top-[60%] -left-12 glass-panel py-3 px-5 shadow-xl animate-float" style="animation-delay: -4s">
                    <span class="text-[10px] font-black text-orange-accent tracking-widest uppercase">Privacy First</span>
                </div>
            </div>
            
            <!-- Fade gradient into next section -->
            <div class="absolute bottom-[-80px] left-0 right-0 h-48 bg-gradient-to-t from-cream-light dark:from-black to-transparent z-30 pointer-events-none"></div>
        </div>
    </div>
</section>

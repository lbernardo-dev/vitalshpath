---
import { Image } from "astro:assets";
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { getAppStoreUrlForLang, getDefaultAppStoreLinks } from "../../lib/app-store-links";
import { ShieldCheck, ChevronRight, Apple } from "lucide-react";
import AppStoreBadge from "../common/AppStoreBadge.astro";

import iphoneHome from "../../assets/images/devices/iphone_home.png";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());

const titleWords = copy.home.heroTitle.split(" ");
const lastWord = titleWords.pop();
const mainTitle = titleWords.join(" ");
---

<section class="relative min-h-[100vh] flex flex-col items-center justify-start pt-40 md:pt-48 pb-0 overflow-hidden">
    <!-- Ambient Glows -->
    <div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-teal-primary/10 blur-[140px] rounded-full animate-float -z-10"></div>
    <div class="absolute top-1/3 right-1/4 w-[400px] h-[400px] bg-orange-accent/5 blur-[120px] rounded-full animate-float -z-10" style="animation-delay: -3s;"></div>

    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 relative z-10 w-full flex flex-col items-center text-center">
        <!-- Badge — always visible, no reveal -->
        <div class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full glass-panel mb-8 border-white/40 shadow-sm hover:scale-105 transition-transform duration-300">
            <ShieldCheck className="w-5 h-5 text-teal-primary" />
            <span class="text-[11px] font-black uppercase tracking-[0.2em] text-teal-primary">
                {copy.home.heroBadge}
            </span>
        </div>

        <!-- Headline — always visible -->
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-[6rem] leading-[1.1] mb-8 font-black tracking-tighter text-slate-text text-balance">
            {mainTitle} <span class="block mt-4 text-gradient">{lastWord}</span>
        </h1>

        <!-- Subtitle — always visible -->
        <p class="text-lg sm:text-xl text-slate-muted mb-10 leading-relaxed max-w-2xl mx-auto font-medium">
            {copy.home.heroSubtitle}
        </p>

        <!-- CTAs — Hero Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mb-12 w-full reveal stagger-2">
            <a
                href={appStoreHref}
                class="hover:scale-105 transition-all duration-500 active:scale-95 shadow-2xl shadow-teal-primary/20 rounded-2xl overflow-hidden"
                aria-label="Download on the App Store"
            >
                <AppStoreBadge className="h-[52px] md:h-[60px]" />
            </a>
            
            <a href="#features" class="group flex items-center gap-2 text-slate-text dark:text-white font-bold text-sm tracking-tight px-6 py-3 rounded-2xl bg-white/10 hover:bg-white/20 border border-white/20 backdrop-blur-xl transition-all duration-300">
                {copy.home.secondaryCta || "See Features"}
                <ChevronRight className="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </a>
        </div>

        <!-- Medical Disclaimer — always visible -->
        <p class="text-[11px] font-medium text-slate-muted/50 max-w-md mx-auto italic mb-16">
            {copy.common.medicalDisclaimer}
        </p>

        <!-- Phone Mockup — Optimized without bulky borders -->
        <div class="relative w-full max-w-[340px] md:max-w-[480px] mt-12 mb-20 reveal reveal-scale stagger-3">
            <!-- Dynamic Aura -->
            <div class="absolute inset-0 bg-gradient-to-t from-teal-primary/30 to-orange-accent/20 blur-[120px] -z-10 rounded-full opacity-50 scale-110"></div>
            
            <div class="relative z-20 animate-float" style="animation-duration: 15s;">
                <!-- Removing the padded background container to solve transparency border issue -->
                <div class="relative group">
                    <!-- Subtle outer glow for the device itself -->
                    <div class="absolute inset-4 bg-white/50 blur-2xl -z-10 opacity-0 group-hover:opacity-40 transition-opacity duration-700"></div>
                    
                    <Image
                        src={iphoneHome}
                        alt="VitalsPath App Interface"
                        class="w-full h-auto drop-shadow-[0_20px_50px_rgba(0,0,0,0.12)] select-none pointer-events-none mix-multiply dark:mix-screen contrast-[1.02]"
                        loading="eager"
                    />
                </div>

                <!-- Floating interactive pills with improved glass style -->
                <div class="hidden md:block absolute -top-8 -right-12 glass-panel py-4 px-6 shadow-2xl animate-float-slow border-white/60">
                    <div class="flex flex-col items-start gap-1">
                        <span class="text-[9px] font-black text-teal-primary tracking-[0.2em] uppercase">Live Sync</span>
                        <span class="text-[12px] font-bold text-slate-text">Healthy Metrics</span>
                    </div>
                </div>
                
                <div class="hidden md:block absolute top-[65%] -left-16 glass-panel py-4 px-6 shadow-2xl animate-float border-white/60" style="animation-delay: -5s">
                    <div class="flex flex-col items-start gap-1">
                        <span class="text-[9px] font-black text-orange-accent tracking-[0.2em] uppercase">Private</span>
                        <span class="text-[12px] font-bold text-slate-text">Secure Cloud</span>
                    </div>
                </div>
            </div>
            <div class="mt-24 sm:mt-32 max-w-sm reveal stagger-4">
                <p class="text-[10px] text-slate-muted/60 uppercase tracking-widest font-black leading-relaxed">
                    * VitalsPath is not a medical device. Always consult with a healthcare professional for clinical decisions.
                </p>
            </div>
        </div>
    </div>
</section>

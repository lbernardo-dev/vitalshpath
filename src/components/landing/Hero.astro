---
import { Image } from "astro:assets";
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { getAppStoreUrlForLang, getDefaultAppStoreLinks } from "../../lib/app-store-links";
import AppStoreBadge from "../common/AppStoreBadge.astro";

import iphoneHome from "../../assets/images/devices/iphone_home.png";
import iphoneMeds from "../../assets/images/devices/iphone_meds.png";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());

const heroTitle = copy.home.heroTitle;
const periodIndex = heroTitle.indexOf('. ');
let headingPart1 = heroTitle;
let headingPart2 = "";

if (periodIndex !== -1) {
    headingPart1 = heroTitle.substring(0, periodIndex + 1);
    headingPart2 = heroTitle.substring(periodIndex + 2);
}
---

<section class="relative min-h-[90vh] flex items-center pt-32 pb-20 overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute top-1/4 -right-20 w-96 h-96 bg-teal-vibrant opacity-10 blur-[120px] rounded-full -z-10 animate-pulse-slow"></div>
    <div class="absolute bottom-1/4 -left-20 w-96 h-96 bg-coral-accent opacity-5 blur-[120px] rounded-full -z-10 animate-pulse-slow"></div>

    <div class="container mx-auto px-6 lg:px-12 relative z-10 w-full">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            
            <!-- Left Column: Content -->
            <div class="flex flex-col items-center lg:items-start text-center lg:text-left reveal">
                <span class="inline-block px-4 py-1.5 rounded-full bg-teal-vibrant/10 text-teal-vibrant text-xs font-bold tracking-widest uppercase mb-6">
                    {lang === 'es' ? 'PRIVADO Y SEGURO' : 'PRIVATE & SECURE'}
                </span>
                
                <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl leading-[1.05] mb-8 font-black tracking-tight text-balance text-slate-900 dark:text-white">
                    {headingPart1} <span class="text-gradient block">{headingPart2}</span>
                </h1>

                <p class="text-xl md:text-2xl text-slate-muted mb-12 leading-relaxed max-w-xl font-medium">
                    {copy.home.heroSubtitle}
                </p>

                <div class="flex flex-wrap gap-4 justify-center lg:justify-start">
                    <a
                        href={appStoreHref}
                        class="hover:scale-105 transition-all duration-300 active:scale-95 shadow-lg shadow-teal-vibrant/10 rounded-2xl overflow-hidden"
                        aria-label="Download on the App Store"
                    >
                        <AppStoreBadge className="h-[58px]" lang={lang} />
                    </a>
                </div>

                <p class="text-[11px] font-medium text-slate-muted/50 max-w-md italic mt-12 opacity-70">
                    * {copy.common.medicalDisclaimer}
                </p>
            </div>

            <!-- Right Column: Overlapping Mockups -->
            <div class="relative flex justify-center lg:justify-end reveal-scale stagger-2 mt-12 lg:mt-0">
                <!-- Background Glow for devices -->
                <div class="absolute inset-0 bg-gradient-to-tr from-teal-vibrant/20 to-coral-accent/20 blur-[100px] rounded-full scale-75 animate-pulse-slow -z-10"></div>
                
                <div class="relative w-full max-w-[300px] sm:max-w-[360px] lg:max-w-[420px] perspective-1000">
                    <!-- Secondary Phone (Back) -->
                    <div class="absolute -left-12 top-12 w-2/3 z-0 transform -rotate-12 translate-z-[-50px] opacity-90 transition-transform duration-700 hover:-rotate-1 hover:translate-x-4">
                        <div class="rounded-[2.5rem] overflow-hidden shadow-2xl shadow-black/10 border-[6px] border-white/50 backdrop-blur-sm">
                            <Image
                                src={iphoneMeds}
                                alt="VitalsPath Medications Tracking"
                                class="w-full h-auto"
                                loading="lazy"
                            />
                        </div>
                    </div>

                    <!-- Main Phone (Front) -->
                    <div class="relative z-10 w-4/5 ml-auto transform transition-transform duration-700 hover:scale-[1.02] hover:-rotate-1">
                        <div class="rounded-[3rem] overflow-hidden shadow-2xl shadow-slate-900/10 border-[8px] border-white/80">
                            <Image
                                src={iphoneHome}
                                alt="VitalsPath Main Interface"
                                class="w-full h-auto"
                                loading="eager"
                            />
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    .perspective-1000 {
        perspective: 1000px;
    }
</style>

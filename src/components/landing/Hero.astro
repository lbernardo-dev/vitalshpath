---
import { Image } from "astro:assets";
import appMockup from "../../assets/images/app-mockup.png";
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { getAppStoreUrlForLang, getDefaultAppStoreLinks } from "../../lib/app-store-links";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());

// Split title logic: Find the last few words to accentuate
const fullTitle = copy.home.heroTitle;
// Default to last words if the separator isn't found
const SEPARATOR = lang === 'es' ? 'en un único lugar privado.' : (lang === 'fr' ? 'en un lieu privé.' : 'in one private place.');
const parts = fullTitle.split(SEPARATOR);
const mainTitle = parts[0] || fullTitle;
const accentTitle = parts.length > 1 ? SEPARATOR : "";
---

<section class="relative overflow-hidden pt-32 pb-20 sm:pt-48 sm:pb-32 bg-transparent transition-colors duration-500">
    <!-- Premium background accents -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-10 pointer-events-none">
        <div class="absolute top-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-teal-primary/5 blur-[120px] animate-pulse"></div>
        <div class="absolute bottom-[-5%] left-[-5%] w-[40%] h-[40%] rounded-full bg-orange-accent/5 blur-[100px]" style="animation-delay: 2s"></div>
    </div>
    
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-12 lg:gap-16 items-center">
            
            <!-- Left Column: Content -->
            <div class="lg:col-span-7 xl:col-span-6 text-center lg:text-left">
                <div class="reveal reveal-scale">
                    <div class="inline-flex items-center rounded-full px-4 py-1.5 text-[10px] font-black uppercase tracking-[0.3em] text-teal-primary bg-teal-primary/10 mb-8 border border-teal-primary/10">
                        <span class="mr-2">✦</span> Private & Secure
                    </div>
                </div>
                
                <h1 class="font-serif text-[2.75rem] sm:text-7xl xl:text-8xl font-black text-slate-text leading-[1.05] tracking-tight mb-8 reveal stagger-1">
                    {mainTitle}
                    <span class="text-teal-primary dark:text-teal-light block mt-2 lg:inline lg:mt-0">
                      {accentTitle}
                    </span>
                </h1>
                
                <p class="text-lg sm:text-xl text-slate-muted leading-relaxed max-w-2xl mx-auto lg:mx-0 mb-12 reveal stagger-2">
                    {copy.home.heroSubtitle}
                </p>
                
                <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-5 reveal stagger-3">
                    <a
                        href={appStoreHref}
                        class="btn-primary w-full sm:w-auto"
                    >
                        {copy.home.primaryCta}
                    </a>
                    <a
                        href="#features"
                        class="btn-secondary w-full sm:w-auto"
                    >
                        {copy.home.secondaryCta}
                    </a>
                </div>
                
                <!-- Medical Disclaimer -->
                <p class="mt-10 text-[11px] font-medium text-slate-muted/60 max-w-md mx-auto lg:mx-0 leading-relaxed reveal stagger-4 italic">
                    {copy.common.medicalDisclaimer}
                </p>
            </div>
            
            <!-- Right Column: Visual -->
            <div class="mt-20 lg:mt-0 lg:col-span-5 xl:col-span-6 flex justify-center lg:justify-end reveal reveal-scale stagger-2">
                <div class="relative w-full max-w-[340px] sm:max-w-[480px]">
                    <!-- Main App Mockup with enhanced glassmorphism -->
                    <div class="relative z-10 animate-float">
                        <div class="rounded-[3rem] p-3 sm:p-4 bg-white/30 dark:bg-white/5 backdrop-blur-[40px] border border-white/60 dark:border-white/10 shadow-[0_50px_100px_-20px_rgba(0,0,0,0.15)] dark:shadow-[0_50px_100px_-20px_rgba(0,0,0,0.6)]">
                            <Image
                                src={appMockup}
                                alt="VitalsPath Dashboard Experience"
                                class="rounded-[2.5rem] shadow-sm w-full h-auto"
                                loading="eager"
                            />
                        </div>
                        
                        <!-- Floating Glass Tags -->
                        <div class="absolute -top-6 -right-6 glass-panel py-3 px-5 shadow-xl animate-float" style="animation-delay: -1s">
                            <span class="text-xs font-black text-teal-primary tracking-wider">SECURE SYNC</span>
                        </div>
                        <div class="absolute top-1/2 -left-8 glass-panel py-3 px-5 shadow-xl animate-float" style="animation-delay: -3.5s">
                            <span class="text-xs font-black text-orange-accent tracking-wider">VITAL ALERTS</span>
                        </div>
                    </div>
                    
                    <!-- Atmospheric light beneath device -->
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-gradient-to-tr from-teal-primary/10 via-transparent to-orange-accent/5 blur-[120px] -z-10"></div>
                </div>
            </div>
            
        </div>
    </div>
</section>

<script>
    import { setupRevealObserver } from "../../lib/reveal-observer";
    setupRevealObserver();
</script>

---
import { Image } from "astro:assets";
import appMockup from "../../assets/images/app-mockup.png";
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { getAppStoreUrlForLang, getDefaultAppStoreLinks } from "../../lib/app-store-links";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());

// Split the title for the two-tone effect (JourneyBot style)
// Example: "Keep medication, symptoms... in one private place."
// Let's make the last part "one private place" accentuated.
const titleParts = copy.home.heroTitle.split("in one private place.");
const mainTitle = titleParts[0];
const accentTitle = "one private place.";
---

<section class="relative overflow-hidden pt-32 pb-20 sm:pt-40 sm:pb-32 bg-cream dark:bg-slate-950 transition-colors duration-500">
    <!-- Decorative background elements -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-[600px] -z-10 bg-[radial-gradient(circle_at_center,rgba(0,128,160,0.08),transparent_70%)] opacity-70"></div>
    
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="lg:grid lg:grid-cols-12 lg:gap-16 items-center">
            
            <!-- Left Column: Content -->
            <div class="lg:col-span-7 xl:col-span-6 text-center lg:text-left">
                <div class="inline-flex items-center rounded-full px-3 py-1 text-xs font-black uppercase tracking-[0.2em] text-teal-primary bg-teal-primary/10 mb-6 reveal reveal-scale">
                    <span class="mr-2">✦</span> Private & Secure
                </div>
                
                <h1 class="text-5xl sm:text-6xl xl:text-7xl font-black text-slate-950 dark:text-white leading-[1.1] tracking-tight mb-8 reveal stagger-1">
                    {mainTitle}
                    <span class="text-teal-primary dark:text-teal-400 block sm:inline">
                      {accentTitle}
                    </span>
                </h1>
                
                <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto lg:mx-0 mb-10 reveal stagger-2">
                    {copy.home.heroSubtitle}
                </p>
                
                <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 reveal stagger-3">
                    <a
                        href={appStoreHref}
                        class="w-full sm:w-auto inline-flex items-center justify-center rounded-2xl bg-teal-primary px-8 py-4 text-base font-black text-white shadow-xl shadow-teal-primary/20 transition-all hover:bg-teal-primary/90 hover:scale-[1.02] active:scale-[0.98]"
                    >
                        {copy.home.primaryCta}
                    </a>
                    <a
                        href="#features"
                        class="w-full sm:w-auto inline-flex items-center justify-center rounded-2xl border-2 border-slate-200 dark:border-white/10 px-8 py-4 text-base font-bold text-slate-700 dark:text-slate-200 transition-all hover:bg-white dark:hover:bg-white/5 hover:border-slate-300 dark:hover:border-white/20 active:scale-[0.98]"
                    >
                        {copy.home.secondaryCta}
                    </a>
                </div>
                
                <!-- Medical Disclaimer - More subtle and placed here like JourneyBot's small notes -->
                <p class="mt-8 text-xs font-medium text-slate-400 dark:text-slate-500 max-w-md mx-auto lg:mx-0 leading-relaxed reveal stagger-4">
                    {copy.common.medicalDisclaimer}
                </p>
            </div>
            
            <!-- Right Column: Visual -->
            <div class="mt-16 lg:mt-0 lg:col-span-5 xl:col-span-6 relative flex justify-center lg:justify-end reveal reveal-right stagger-2">
                <div class="relative w-full max-w-[320px] sm:max-w-[420px]">
                    <!-- Main App Mockup -->
                    <div class="relative z-10 animate-float">
                        <div class="rounded-[2.5rem] p-3 bg-white/40 dark:bg-white/5 backdrop-blur-xl border border-white/50 dark:border-white/10 shadow-2xl">
                            <Image
                                src={appMockup}
                                alt="VitalsPath Dashboard Experience"
                                class="rounded-[2rem] shadow-lg w-full h-auto"
                                loading="eager"
                            />
                        </div>
                    </div>
                    
                    <!-- Decorative accents around device -->
                    <div class="absolute -top-10 -right-10 w-32 h-32 bg-orange-accent/10 rounded-full blur-3xl -z-10 animate-pulse"></div>
                    <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-teal-primary/10 rounded-full blur-3xl -z-10 animate-pulse" style="animation-delay: 1s"></div>
                </div>
            </div>
            
        </div>
    </div>
</section>

<script>
    import { setupRevealObserver } from "../../lib/reveal-observer";
    setupRevealObserver();
</script>

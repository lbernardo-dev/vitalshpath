---
import { Rocket, Sparkles, Smartphone, Users, CheckCircle, ArrowRight } from "lucide-react";
import { type Lang } from "../../i18n/ui-locales";
import { useTranslations } from "../../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="testflight-card w-full liquid-glass p-8 md:p-12 relative group">
    <!-- Recruitment Header -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-12">
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-600 dark:text-blue-400 text-xs font-bold uppercase tracking-wider mb-4">
                <Sparkles className="w-3 h-3" />
                {t("testflight.badge")}
            </div>
            <h3 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white mb-2 leading-tight">
                {t("testflight.offer")}
            </h3>
            <p class="text-blue-600 dark:text-blue-400 font-bold flex items-center gap-2">
                <CheckCircle className="w-4 h-4" />
                {t("testflight.premium_free")}
            </p>
        </div>
        
        <div class="bg-gray-900/5 dark:bg-white/5 backdrop-blur-xl px-6 py-4 rounded-3xl border border-black/5 dark:border-white/10 text-center">
            <p id="tf-slots-count" class="text-2xl font-black text-gray-900 dark:text-white mb-1">{(t("testflight.slots") as string).split(' ')[0]}</p>
            <p class="text-[10px] text-gray-500 dark:text-gray-400 uppercase font-black tracking-widest">{(t("testflight.slots") as string).split(' ').slice(1).join(' ')}</p>
        </div>
    </div>

    <!-- Beta Benefits Grid -->
    <div class="grid sm:grid-cols-2 gap-4 mb-12">
        {(t("testflight.benefits.items") as any).map((benefit: string) => (
            <div class="flex items-center gap-3 p-4 rounded-2xl bg-white/40 dark:bg-black/20 border border-white/50 dark:border-white/5 group/item hover:scale-[1.02] transition-transform">
                <div class="w-8 h-8 rounded-full bg-blue-500/10 flex items-center justify-center text-blue-600 dark:text-blue-400">
                    <CheckCircle className="w-4 h-4" />
                </div>
                <span class="text-sm font-bold text-gray-700 dark:text-gray-300">{benefit}</span>
            </div>
        ))}
    </div>

    <!-- Main CTA -->
    <div class="flex flex-col items-center gap-6">
        <a
            id="join-testflight-btn"
            href="https://testflight.apple.com/join/92qmBYvJ"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full md:w-auto px-10 py-5 bg-blue-600 hover:bg-blue-700 text-white font-black rounded-[2rem] shadow-2xl shadow-blue-500/40 hover:scale-105 active:scale-95 transition-all text-center flex items-center justify-center gap-3 group/btn"
        >
            <span class="text-lg uppercase tracking-wider">{t("testflight.cta.button")}</span>
            <Rocket className="w-6 h-6 group-hover/btn:-translate-y-1 group-hover/btn:translate-x-1 transition-transform" />
        </a>
        
        <script>
            import { trackEvent, getStats } from "../../lib/supabase/tracking";
            
            const btn = document.getElementById("join-testflight-btn");
            const slotsEl = document.getElementById("tf-slots-count");

            if (btn) {
                btn.addEventListener("click", () => {
                    trackEvent("testflight_click", {
                        source: "recruitment_card",
                        timestamp: new Date().toISOString()
                    });
                });
            }

            // Update slots count dynamically
            async function updateSlots() {
                if (!slotsEl) return;
                const stats = await getStats();
                if (stats && stats.testflight_clicks_total !== undefined) {
                    const totalSlots = 8000;
                    const used = stats.testflight_clicks_total;
                    // Format as "used/total" or just "used"
                    slotsEl.textContent = `${used}/${totalSlots}`;
                }
            }

            updateSlots();
            setInterval(updateSlots, 60000); // Update every minute
        </script>
        
        <p class="text-xs text-gray-500 dark:text-gray-400 font-medium flex items-center gap-2">
            <Smartphone className="w-4 h-4" />
            {t("testflight.cta.description")}
        </p>
    </div>

    <!-- Decorative Elements -->
    <div class="absolute -top-12 -right-12 w-48 h-48 bg-blue-500/10 rounded-full blur-3xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
</div>

<style>
    .testflight-card {
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    
    .testflight-card:hover {
        transform: translateY(-5px);
    }
</style>

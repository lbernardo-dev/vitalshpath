---
import { Image } from "astro:assets";
import {
    Smartphone,
    Tablet,
    Watch,
    Cloud,
    Sparkles,
    Share2,
} from "lucide-react";
import DeviceMockup from "../DeviceMockup.astro";

// Assets
import iphoneMockup from "../../assets/images/app-mockup.png";
import ipadHorizontal from "../../assets/images/eco-ipad-h.png";
import watchRing from "../../assets/images/eco-watch-ring.png";
import watchList from "../../assets/images/eco-watch-list.png";

import { type Lang } from "../../i18n/ui-locales";
import { useTranslations } from "../../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
    id="ecosystem"
    class="py-16 md:py-28 bg-white dark:bg-black overflow-hidden relative border-y border-gray-100 dark:border-white/5"
>
    <!-- Fluid background gradients for better continuity -->
    <div class="absolute inset-0 pointer-events-none">
        <div
            class="absolute top-0 left-1/4 w-[1000px] h-[600px] bg-blue-500/5 blur-[150px] rounded-full"
        >
        </div>
        <div
            class="absolute bottom-1/4 right-1/4 w-[1000px] h-[650px] bg-purple-500/5 blur-[150px] rounded-full"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <!-- Compact Header -->
        <div class="max-w-4xl mx-auto text-center mb-16 md:mb-24 reveal">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 mb-6"
            >
                <Cloud className="w-4 h-4 text-blue-500" />
                <span
                    class="text-[11px] font-black uppercase tracking-widest text-blue-600 dark:text-blue-400"
                >
                    {t("ecosystem.badge")}
                </span>
            </div>
            <h2
                class="text-4xl md:text-7xl font-black text-gray-900 dark:text-white mb-8 tracking-tight italic"
            >
                {t("ecosystem.title")}
            </h2>
            <p
                class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 font-medium leading-relaxed max-w-2xl mx-auto"
            >
                {t("ecosystem.subtitle")}
            </p>
        </div>

        <!-- Professional Composition (iPad Base + Overlapping iPhone/Watch) -->
        <div
            class="max-w-7xl mx-auto relative h-[450px] md:h-[750px] flex items-center justify-center pt-24"
        >
            <!-- iPad Pro Horizontal (The Main Scene) -->
            <div
                class="absolute w-full md:w-[90%] lg:w-[80%] xl:w-[75%] z-10 transform -translate-y-8 md:-translate-y-20 perspective-[2000px] reveal"
            >
                <div class="relative group">
                    <DeviceMockup
                        type="ipad"
                        className="w-full bg-zinc-800 shadow-[0_40px_80px_-20px_rgba(0,0,0,0.5)] rotate-x-1 duration-1000"
                    >
                        <Image
                            src={ipadHorizontal}
                            alt="Dashboard on iPad"
                            class="mockup-image"
                            width={1200}
                            height={900}
                            loading="lazy"
                        />
                    </DeviceMockup>
                    <!-- Display Label -->
                    <div
                        class="absolute -top-6 left-1/2 -track-x-1/2 px-5 py-2 glass-panel border-white/20 shadow-xl hidden md:block opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                        <span
                            class="text-[10px] font-black text-gray-900 dark:text-white uppercase tracking-widest"
                            >iPadOS 18 Optimized Architecture</span
                        >
                    </div>
                </div>
            </div>

            <!-- iPhone 16 Pro (Front-Left Overlap) -->
            <div
                class="absolute left-[-2%] md:left-[2%] bottom-0 md:bottom-12 w-[35%] md:w-[24%] lg:w-[20%] z-40 transform translate-y-8 md:translate-y-16 perspective-[1000px] reveal reveal-left"
            >
                <div
                    class="transform -rotate-12 hover:-rotate-6 hover:scale-105 transition-all duration-700 group cursor-pointer"
                >
                    <DeviceMockup
                        type="iphone"
                        className="w-full shadow-[0_50px_100px_-20px_rgba(0,0,0,0.6)] border-zinc-800"
                    >
                        <Image
                            src={iphoneMockup}
                            alt="iPhone Interface"
                            class="mockup-image"
                            width={320}
                            height={693}
                            loading="lazy"
                        />
                    </DeviceMockup>
                </div>
            </div>

            <!-- Apple Watch Ultra 2 (Anillo - Front-Right Overlap) -->
            <div
                class="absolute right-[5%] md:right-[15%] bottom-5 md:bottom-32 w-[30%] md:w-[22%] lg:w-[18%] z-30 transform translate-y-4 md:translate-y-8 perspective-[1000px] reveal reveal-right stagger-1"
            >
                <div
                    class="transform rotate-12 hover:rotate-6 hover:scale-110 transition-all duration-700 group cursor-pointer"
                >
                    <DeviceMockup
                        type="watch-ultra"
                        className="w-full shadow-[0_50px_100px_-20px_rgba(0,0,0,0.6)]"
                    >
                        <Image
                            src={watchRing}
                            alt="Wellness Ring on Apple Watch Ultra"
                            class="mockup-image"
                            width={200}
                            height={250}
                            loading="lazy"
                        />
                    </DeviceMockup>
                </div>
            </div>

            <!-- Apple Watch SE (Dosis - Far Front-Right Overlap) -->
            <div
                class="absolute right-[-2%] md:right-[2%] bottom-[-5%] md:bottom-0 w-[26%] md:w-[18%] lg:w-[15%] z-50 transform translate-y-12 md:translate-y-16 perspective-[1000px] reveal reveal-right stagger-2"
            >
                <div
                    class="transform rotate-[-3deg] hover:rotate-0 hover:scale-115 transition-all duration-700 group cursor-pointer"
                >
                    <DeviceMockup
                        type="watch-se"
                        className="w-full shadow-[0_40px_80px_-15px_rgba(0,0,0,0.5)] border-zinc-900"
                    >
                        <Image
                            src={watchList}
                            alt="Schedule on Apple Watch SE"
                            class="mockup-image"
                            width={200}
                            height={250}
                            loading="lazy"
                        />
                    </DeviceMockup>
                </div>
            </div>

            <!-- Premium Sync Pill Component (Desktop) -->
            <div
                class="absolute -bottom-24 z-50 hidden lg:flex reveal reveal-scale stagger-3"
            >
                <div
                    class="px-8 py-5 rounded-[2.5rem] liquid-glass border-white/20 shadow-2xl flex items-center gap-6"
                >
                    <div
                        class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-500/20 to-purple-600/20 glass-panel flex items-center justify-center text-blue-500 shadow-lg shrink-0"
                    >
                        <Share2 className="w-6 h-6 animate-pulse" />
                    </div>
                    <div>
                        <p
                            class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-none mb-1 leading-none italic pb-0.5"
                        >
                            NATIVE ECOSYSTEM SYNC
                        </p>
                        <p
                            class="text-sm font-black text-gray-900 dark:text-white uppercase leading-none"
                        >
                            SwiftData + HealthKit Cloud Core
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Integrated Info Grid (Compact Specs) -->
        <div
            class="mt-40 md:mt-64 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-6xl mx-auto"
        >
            <div
                class="group p-8 rounded-[3rem] bg-gray-50 dark:bg-zinc-900/50 border border-gray-100 dark:border-white/5 flex flex-col items-center text-center hover:bg-white dark:hover:bg-zinc-800 transition-all shadow-sm hover:shadow-xl hover:-translate-y-2"
            >
                <div
                    class="w-14 h-14 rounded-2xl bg-blue-500/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform"
                >
                    <Smartphone className="w-7 h-7 text-blue-500" />
                </div>
                <span
                    class="text-[11px] font-black text-gray-400 uppercase tracking-widest mb-1"
                    >iPhone</span
                >
                <p class="text-base font-black text-gray-900 dark:text-white">
                    iOS 18+
                </p>
            </div>

            <div
                class="group p-8 rounded-[3rem] bg-gray-50 dark:bg-zinc-900/50 border border-gray-100 dark:border-white/5 flex flex-col items-center text-center hover:bg-white dark:hover:bg-zinc-800 transition-all shadow-sm hover:shadow-xl hover:-translate-y-2"
            >
                <div
                    class="w-14 h-14 rounded-2xl bg-purple-500/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform"
                >
                    <Tablet className="w-7 h-7 text-purple-500" />
                </div>
                <span
                    class="text-[11px] font-black text-gray-400 uppercase tracking-widest mb-1"
                    >iPad</span
                >
                <p class="text-base font-black text-gray-900 dark:text-white">
                    iPadOS 18+
                </p>
            </div>

            <div
                class="group p-8 rounded-[3rem] bg-gray-50 dark:bg-zinc-900/50 border border-gray-100 dark:border-white/5 flex flex-col items-center text-center hover:bg-white dark:hover:bg-zinc-800 transition-all shadow-sm hover:shadow-xl hover:-translate-y-2"
            >
                <div
                    class="w-14 h-14 rounded-2xl bg-pink-500/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform"
                >
                    <Watch className="w-7 h-7 text-pink-500" />
                </div>
                <span
                    class="text-[11px] font-black text-gray-400 uppercase tracking-widest mb-1"
                    >Watch</span
                >
                <p class="text-base font-black text-gray-900 dark:text-white">
                    watchOS 11+
                </p>
            </div>

            <div
                class="group p-8 rounded-[3rem] bg-blue-500/5 dark:bg-blue-500/10 border border-blue-500/20 flex flex-col items-center text-center hover:bg-blue-500/20 transition-all shadow-sm hover:shadow-xl hover:-translate-y-2"
            >
                <div
                    class="w-14 h-14 rounded-2xl bg-blue-500/20 flex items-center justify-center mb-5 group-hover:rotate-12 transition-transform"
                >
                    <Sparkles className="w-7 h-7 text-cyan-500" />
                </div>
                <span
                    class="text-[11px] font-black text-blue-500 uppercase tracking-widest mb-1"
                    >Health Data</span
                >
                <p class="text-base font-black text-gray-900 dark:text-white">
                    Ecosystem Native
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    /* Premium hardware tilt */
    .rotate-x-1 {
        transform: rotateX(1deg);
    }
</style>

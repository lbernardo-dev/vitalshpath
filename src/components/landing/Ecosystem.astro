---
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { Activity, LayoutTemplate, Zap, Smartphone, Watch, Layout } from "lucide-react";
import { Image } from "astro:assets";

// High fidelity assets for the ecosystem collage
import watchVitals from "../../assets/images/devices/watch_vitals_clean.png";
import screenWidgets from "../../assets/images/screens/screen-21-widgets-gallery.PNG";
import screenLiveActivity from "../../assets/images/screens/screen-27-live-activity.PNG";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);

// Specific icons for items
const ecosystemIcons = [Layout, Watch, Activity];
---

<section id="ecosystem" class="py-6 sm:py-10 relative overflow-hidden bg-slate-50/30 dark:bg-black/40">
    <!-- Sophisticated background pattern -->
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(#2dd4bf 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8 relative">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
            
            <!-- Left Side: Content Hierarchy -->
            <div class="reveal">
                <div class="inline-flex items-center px-4 py-1.5 rounded-full bg-teal-vibrant/5 border border-teal-vibrant/20 mb-8">
                    <span class="text-teal-vibrant text-[10px] font-black tracking-[0.3em] uppercase">
                        {copy.home.ecosystemLabel}
                    </span>
                </div>
                
                <h2 class="text-5xl md:text-6xl font-black text-slate-900 dark:text-white tracking-tighter text-balance mb-6 uppercase italic">
                    {copy.home.ecosystemTitle}
                </h2>
                
                <p class="text-xl text-slate-600 dark:text-slate-400 font-medium mb-10 max-w-xl leading-relaxed">
                    {copy.home.ecosystemBody}
                </p>

                <div class="grid grid-cols-1 gap-8">
                    {copy.home.ecosystemItems.map((item, index) => {
                        const Icon = ecosystemIcons[index % ecosystemIcons.length];
                        return (
                            <div class={`reveal stagger-${index + 1} flex items-start group`}>
                                <div class="flex-shrink-0 mt-1">
                                    <div class="w-14 h-14 rounded-2xl bg-white dark:bg-slate-800 flex items-center justify-center border border-slate-200 dark:border-white/10 shadow-sm transform transition-all duration-500 group-hover:scale-110 group-hover:bg-teal-vibrant group-hover:text-white">
                                        <Icon className="w-7 h-7" />
                                    </div>
                                </div>
                                <div class="ml-6">
                                    <h3 class="text-xl font-black text-slate-900 dark:text-white mb-2 tracking-tight group-hover:text-teal-vibrant transition-colors">
                                        {item.title}
                                    </h3>
                                    <p class="text-base text-slate-600 dark:text-slate-400 font-medium leading-relaxed">
                                        {item.description}
                                    </p>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>

            <!-- Right Side: The Ecosystem Collage -->
            <div class="relative py-12 lg:py-0 reveal-scale perspective-2000 h-[500px] sm:h-[600px] flex items-center justify-center">
                
                <!-- Background Glow -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-gradient-to-tr from-teal-vibrant/20 to-blue-500/10 blur-[100px] rounded-full z-0 opacity-50"></div>

                <!-- Apple Watch (Front/Center) -->
                <div class="absolute z-30 w-[240px] sm:w-[320px] transform transition-transform duration-1000 hover:scale-105 hover:-translate-y-4 hover:rotate-1">
                    <Image
                        src={watchVitals}
                        alt="VitalsPath on Apple Watch"
                        class="w-full h-auto object-contain drop-shadow-[0_40px_60px_rgba(0,0,0,0.3)] mockup-clean-blend-watch"
                    />
                </div>

                <!-- Live Activity Mockup (Floating Right) -->
                <div class="absolute z-40 top-1/4 -right-4 sm:-right-8 w-[200px] sm:w-[260px] transform rotate-3 transition-all duration-700 hover:rotate-0 hover:scale-110 animate-float translate-y-12">
                    <div class="relative rounded-[2rem] border-[6px] border-slate-900 bg-black overflow-hidden shadow-2xl overflow-hidden ring-1 ring-white/20">
                         <div class="absolute top-1 left-1/2 -translate-x-1/2 w-16 h-4 bg-black rounded-full z-20"></div>
                         <Image
                            src={screenLiveActivity}
                            alt="Live Activity"
                            class="w-full h-auto"
                        />
                    </div>
                    <div class="absolute -bottom-2 -right-2 px-3 py-1 rounded-full bg-teal-vibrant text-[10px] font-black text-white shadow-xl uppercase tracking-widest z-50">
                        {lang === 'es' ? 'EN VIVO' : 'LIVE'}
                    </div>
                </div>

                <!-- Widget Mockup (Floating Left/Bottom) -->
                <div class="absolute z-20 -bottom-4 -left-4 sm:-left-12 w-[180px] sm:w-[240px] transform -rotate-6 transition-all duration-700 hover:rotate-0 hover:scale-110 animate-pulse-slow">
                     <div class="relative rounded-[2.5rem] border-[8px] border-slate-900 bg-slate-900 overflow-hidden shadow-2xl ring-1 ring-white/10">
                         <Image
                            src={screenWidgets}
                            alt="Widgets Gallery"
                            class="w-full h-auto"
                        />
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    @keyframes float {
        0%, 100% { transform: translateY(0) rotate(3deg); }
        50% { transform: translateY(-20px) rotate(5deg); }
    }
    .animate-float {
        animation: float 6s ease-in-out infinite;
    }
</style>

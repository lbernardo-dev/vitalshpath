---
import { Image } from "astro:assets";
import {
    Smartphone,
    Tablet,
    Watch,
    Cloud,
    Sparkles,
    Share2,
} from "lucide-react";
import DeviceMockup from "../DeviceMockup.astro";

// Assets
import iphoneMockup from "../../assets/images/app-mockup.png";
import ipadHorizontal from "../../assets/images/eco-ipad-h.png";
import watchRing from "../../assets/images/eco-watch-ring.png";
import watchList from "../../assets/images/eco-watch-list.png";

import { type Lang } from "../../i18n/ui-locales";
import { useTranslations } from "../../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
    id="ecosystem"
    class="py-16 md:py-28 bg-white dark:bg-black overflow-hidden relative border-y border-gray-100 dark:border-white/5"
>
    <!-- Continuity Gradients -->
    <div class="absolute inset-0 pointer-events-none">
        <div
            class="absolute top-0 left-1/4 w-[1000px] h-[600px] bg-blue-500/5 blur-[150px] rounded-full"
        >
        </div>
        <div
            class="absolute bottom-0 right-1/4 w-[1000px] h-[600px] bg-purple-500/5 blur-[150px] rounded-full"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <!-- Compact Header -->
        <div class="max-w-4xl mx-auto text-center mb-16 md:mb-24 reveal">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 mb-6"
            >
                <Cloud className="w-4 h-4 text-blue-500" />
                <span
                    class="text-[11px] font-black uppercase tracking-widest text-blue-600 dark:text-blue-400"
                >
                    {t("ecosystem.badge")}
                </span>
            </div>
            <h2
                class="text-4xl md:text-7xl font-black text-gray-900 dark:text-white mb-8 tracking-tight italic"
            >
                {t("ecosystem.title")}
            </h2>
            <p
                class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 font-medium leading-relaxed max-w-2xl mx-auto"
            >
                {t("ecosystem.subtitle")}
            </p>
        </div>

        <!-- High-Impact 3D Device Cluster -->
        <div
            class="max-w-7xl mx-auto relative h-[500px] md:h-[750px] flex items-center justify-center pt-20"
        >
            <!-- iPad Pro (The Foundation) -->
            <div
                class="absolute w-[95%] md:w-[85%] lg:w-[75%] z-10 transform -translate-y-12 md:-translate-y-20 perspective-[2000px] reveal"
            >
                <div class="relative transform group">
                    <DeviceMockup
                        type="ipad"
                        className="w-full bg-zinc-800 rotate-x-2 transition-transform duration-1000 hover:rotate-x-0"
                    >
                        <Image
                            src={ipadHorizontal}
                            alt="iPad Interface"
                            class="mockup-image"
                        />
                    </DeviceMockup>
                    <!-- Floating Display Label -->
                    <div
                        class="absolute -top-6 left-1/2 -translate-x-1/2 px-5 py-2 rounded-full glass-panel border-white/20 shadow-xl opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap hidden md:block"
                    >
                        <span
                            class="text-xs font-black text-gray-900 dark:text-white uppercase tracking-widest"
                            >iPadOS 18 Liquid Rendering</span
                        >
                    </div>
                </div>
            </div>

            <!-- iPhone 16 Pro (Front Center-Left) -->
            <div
                class="absolute left-0 md:left-[5%] bottom-4 md:bottom-12 w-[35%] md:w-[25%] lg:w-[20%] z-40 transform translate-y-8 md:translate-y-16 perspective-[1000px] reveal reveal-left"
            >
                <div
                    class="transform -rotate-6 transition-all duration-700 hover:rotate-0 hover:scale-110 group"
                >
                    <DeviceMockup
                        type="iphone"
                        className="w-full shadow-[0_50px_100px_-20px_rgba(0,0,0,0.5)] border-zinc-800"
                    >
                        <Image
                            src={iphoneMockup}
                            alt="iPhone Interface"
                            class="mockup-image"
                        />
                    </DeviceMockup>
                    <div
                        class="absolute top-10 left-1/2 -track-x-1/2 px-3 py-1 bg-black rounded-full border border-white/10 text-[9px] font-black text-cyan-400 uppercase tracking-widest hidden md:flex items-center gap-1 z-50"
                    >
                        <Sparkles className="w-2 h-2" /> Live
                    </div>
                </div>
            </div>

            <!-- Apple Watch Ultra 2 (Front Center-Right - Ring View) -->
            <div
                class="absolute right-[5%] md:right-[15%] bottom-10 md:bottom-32 w-[30%] md:w-[22%] lg:w-[18%] z-30 transform translate-y-4 md:translate-y-8 perspective-[1000px] reveal reveal-right stagger-1"
            >
                <div
                    class="transform rotate-3 transition-all duration-700 hover:rotate-0 hover:scale-115 group"
                >
                    <DeviceMockup
                        type="watch-ultra"
                        className="w-full shadow-[0_50px_100px_-20px_rgba(0,0,0,0.6)]"
                    >
                        <Image
                            src={watchRing}
                            alt="Watch Rings View"
                            class="mockup-image"
                        />
                    </DeviceMockup>
                    <div
                        class="absolute -top-4 -right-4 w-12 h-12 rounded-2xl bg-orange-500 flex items-center justify-center text-white shadow-lg rotate-12 group-hover:rotate-0 transition-transform hidden md:flex"
                    >
                        <Watch className="w-6 h-6" />
                    </div>
                </div>
            </div>

            <!-- Apple Watch SE (Further Back-Right - List View) -->
            <div
                class="absolute right-0 md:right-[2%] bottom-0 w-[25%] md:w-[18%] lg:w-[14%] z-20 transform translate-y-12 perspective-[1000px] reveal reveal-right stagger-2"
            >
                <div
                    class="transform -rotate-12 transition-all duration-1000 hover:rotate-0 hover:scale-110"
                >
                    <DeviceMockup
                        type="watch-se"
                        className="w-full shadow-[0_30px_60px_-10px_rgba(0,0,0,0.4)]"
                    >
                        <Image
                            src={watchList}
                            alt="Watch List View"
                            class="mockup-image"
                        />
                    </DeviceMockup>
                </div>
            </div>

            <!-- Sync Pill (Desktop) -->
            <div
                class="absolute -bottom-20 z-50 hidden lg:flex reveal reveal-scale"
            >
                <div
                    class="px-8 py-5 rounded-[2.5rem] liquid-glass border-white/20 shadow-2xl flex items-center gap-6 stagger-3"
                >
                    <div
                        class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white shadow-lg"
                    >
                        <Share2 className="w-6 h-6" />
                    </div>
                    <div>
                        <p
                            class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-none mb-1"
                        >
                            REAL-TIME ECOSYSTEM SYNC
                        </p>
                        <p
                            class="text-sm font-black text-gray-900 dark:text-white uppercase"
                        >
                            iCloud + SwiftData + HealthKit
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Integrated Specs Grid -->
        <div
            class="mt-40 md:mt-56 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-6xl mx-auto"
        >
            <div
                class="group p-8 rounded-[3rem] bg-gray-50 dark:bg-zinc-900/50 border border-gray-100 dark:border-white/5 flex flex-col items-center text-center hover:bg-white dark:hover:bg-zinc-800 transition-all shadow-sm hover:shadow-xl hover:-translate-y-2"
            >
                <div
                    class="w-14 h-14 rounded-2xl bg-blue-500/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform"
                >
                    <Smartphone className="w-7 h-7 text-blue-500" />
                </div>
                <span
                    class="text-[11px] font-black text-gray-400 uppercase tracking-widest mb-1"
                    >iPhone App</span
                >
                <p class="text-base font-black text-gray-900 dark:text-white">
                    iOS 18+
                </p>
            </div>

            <div
                class="group p-8 rounded-[3rem] bg-gray-50 dark:bg-zinc-900/50 border border-gray-100 dark:border-white/5 flex flex-col items-center text-center hover:bg-white dark:hover:bg-zinc-800 transition-all shadow-sm hover:shadow-xl hover:-translate-y-2"
            >
                <div
                    class="w-14 h-14 rounded-2xl bg-purple-500/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform"
                >
                    <Tablet className="w-7 h-7 text-purple-500" />
                </div>
                <span
                    class="text-[11px] font-black text-gray-400 uppercase tracking-widest mb-1"
                    >iPad Version</span
                >
                <p class="text-base font-black text-gray-900 dark:text-white">
                    iPadOS 18+
                </p>
            </div>

            <div
                class="group p-8 rounded-[3rem] bg-gray-50 dark:bg-zinc-900/50 border border-gray-100 dark:border-white/5 flex flex-col items-center text-center hover:bg-white dark:hover:bg-zinc-800 transition-all shadow-sm hover:shadow-xl hover:-translate-y-2"
            >
                <div
                    class="w-14 h-14 rounded-2xl bg-pink-500/10 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform"
                >
                    <Watch className="w-7 h-7 text-pink-500" />
                </div>
                <span
                    class="text-[11px] font-black text-gray-400 uppercase tracking-widest mb-1"
                    >Watch Complications</span
                >
                <p class="text-base font-black text-gray-900 dark:text-white">
                    watchOS 11+
                </p>
            </div>

            <div
                class="group p-8 rounded-[3rem] bg-blue-500/5 dark:bg-blue-500/10 border border-blue-500/20 flex flex-col items-center text-center hover:bg-blue-500/20 transition-all shadow-sm hover:shadow-xl hover:-translate-y-2"
            >
                <div
                    class="w-14 h-14 rounded-2xl bg-blue-500/20 flex items-center justify-center mb-5 group-hover:rotate-12 transition-transform"
                >
                    <Sparkles className="w-7 h-7 text-cyan-500" />
                </div>
                <span
                    class="text-[11px] font-black text-blue-500 uppercase tracking-widest mb-1"
                    >Health Data</span
                >
                <p class="text-base font-black text-gray-900 dark:text-white">
                    Natively Synced
                </p>
            </div>
        </div>
    </div>
</section>

<style>
    .rotate-x-2 {
        transform: rotateX(2deg);
    }
</style>

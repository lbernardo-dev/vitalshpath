---
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { Activity, Watch, Layout } from "lucide-react";
import { Image } from "astro:assets";

// High fidelity assets for the ecosystem collage
import watchVitals from "../../assets/images/eco-watch-ring.png";
import screenWidgets from "../../assets/images/screens/screen-21-widgets-gallery.PNG";
import screenLiveActivity from "../../assets/images/screens/screen-27-live-activity.PNG";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);

// Specific icons for items
const ecosystemIcons = [Layout, Watch, Activity];
---

<section id="ecosystem" class="relative overflow-hidden border-y border-slate-200 bg-slate-50 py-14 sm:py-20 dark:border-white/10 dark:bg-[#0c1117]">
    <!-- Sophisticated background pattern -->
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(#2dd4bf 1px, transparent 1px); background-size: 40px 40px;"></div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8 relative">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
            
            <!-- Left Side: Content Hierarchy -->
            <div class="reveal">
                <div class="mb-6 inline-flex items-center rounded-lg bg-sky-100 px-3 py-1.5 dark:bg-teal-300/10">
                    <span class="text-[11px] font-black uppercase tracking-[0.22em] text-sky-700 dark:text-teal-200">
                        {copy.home.ecosystemLabel}
                    </span>
                </div>
                
                <h2 class="mb-6 text-[clamp(2.2rem,5vw,4.5rem)] font-black leading-none tracking-tight text-slate-950 dark:text-white">
                    {copy.home.ecosystemTitle}
                </h2>
                
                <p class="mb-10 max-w-xl text-lg font-medium leading-8 text-slate-600 dark:text-slate-300 md:text-xl">
                    {copy.home.ecosystemBody}
                </p>

                <div class="grid grid-cols-1 gap-5">
                    {copy.home.ecosystemItems.map((item, index) => {
                        const Icon = ecosystemIcons[index % ecosystemIcons.length];
                        return (
                            <div class={`group flex items-start rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition-colors duration-300 hover:border-sky-200 reveal stagger-${index + 1} dark:border-white/10 dark:bg-white/[0.04] dark:hover:border-teal-300/30`}>
                                <div class="flex-shrink-0 mt-1">
                                    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-sky-50 text-sky-700 transition-colors duration-300 group-hover:bg-sky-600 group-hover:text-white dark:bg-teal-300/10 dark:text-teal-200 dark:group-hover:bg-teal-300 dark:group-hover:text-slate-950">
                                        <Icon className="h-6 w-6" />
                                    </div>
                                </div>
                                <div class="ml-4">
                                    <h3 class="mb-1 text-lg font-black tracking-tight text-slate-950 transition-colors group-hover:text-sky-700 dark:text-white dark:group-hover:text-teal-200">
                                        {item.title}
                                    </h3>
                                    <p class="text-sm font-medium leading-6 text-slate-600 dark:text-slate-300">
                                        {item.description}
                                    </p>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>

            <!-- Right Side: The Ecosystem Collage -->
            <div class="relative flex h-[500px] items-center justify-center py-12 reveal-scale perspective-2000 sm:h-[600px] lg:py-0">
                
                <!-- Background Glow -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-gradient-to-tr from-teal-vibrant/20 to-blue-500/10 blur-[100px] rounded-full z-0 opacity-50"></div>

                <!-- Apple Watch (Front/Center) -->
                <div class="absolute z-30 w-[190px] transform transition-transform duration-700 hover:-translate-y-3 sm:w-[250px]">
                    <Image
                        src={watchVitals}
                        alt="VitalsPath on Apple Watch"
                        class="h-auto w-full object-contain drop-shadow-[0_40px_60px_rgba(0,0,0,0.24)]"
                    />
                </div>

                <!-- Live Activity Mockup (Floating Right) -->
                <div class="absolute right-0 top-1/4 z-40 w-[180px] translate-y-12 rotate-3 transform transition-all duration-700 hover:rotate-0 sm:-right-8 sm:w-[240px]">
                    <div class="relative overflow-hidden rounded-[1.7rem] border-[6px] border-slate-950 bg-black shadow-2xl ring-1 ring-white/20">
                         <div class="absolute top-1 left-1/2 -translate-x-1/2 w-16 h-4 bg-black rounded-full z-20"></div>
                         <Image
                            src={screenLiveActivity}
                            alt="Live Activity"
                            class="w-full h-auto"
                        />
                    </div>
                    <div class="absolute -bottom-2 -right-2 z-50 rounded-lg bg-sky-600 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-white shadow-xl dark:bg-teal-300 dark:text-slate-950">
                        {lang === 'es' ? 'EN VIVO' : 'LIVE'}
                    </div>
                </div>

                <!-- Widget Mockup (Floating Left/Bottom) -->
                <div class="absolute -bottom-4 -left-4 z-20 w-[170px] -rotate-6 transform transition-all duration-700 hover:rotate-0 sm:-left-12 sm:w-[230px]">
                     <div class="relative overflow-hidden rounded-[2rem] border-[8px] border-slate-950 bg-slate-900 shadow-2xl ring-1 ring-white/10">
                         <Image
                            src={screenWidgets}
                            alt="Widgets Gallery"
                            class="w-full h-auto"
                        />
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    @keyframes float {
        0%, 100% { transform: translateY(0) rotate(3deg); }
        50% { transform: translateY(-20px) rotate(5deg); }
    }
    .animate-float {
        animation: float 6s ease-in-out infinite;
    }
</style>

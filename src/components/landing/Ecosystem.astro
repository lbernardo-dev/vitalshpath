---
import { Image } from "astro:assets";
import {
    Smartphone,
    Tablet,
    Watch,
    Cloud,
    Smartphone as iPhoneIcon,
} from "lucide-react";
import ecosystemMockup from "../../assets/images/ecosystem-mockup.png";
import { type Lang } from "../../i18n/ui-locales";
import { useTranslations } from "../../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
    id="ecosystem"
    class="py-24 md:py-32 bg-white dark:bg-black overflow-hidden border-y border-gray-100 dark:border-white/5 relative"
>
    <!-- Ambient backgrounds -->
    <div class="absolute inset-0 pointer-events-none">
        <div
            class="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-blue-50/50 dark:from-blue-500/5 to-transparent"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div
            class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center"
        >
            <!-- Content -->
            <div class="reveal reveal-left">
                <div
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 mb-8"
                >
                    <Cloud className="w-4 h-4 text-blue-500" />
                    <span
                        class="text-xs font-black uppercase tracking-widest text-gray-600 dark:text-gray-400"
                    >
                        {t("ecosystem.badge")}
                    </span>
                </div>

                <h2
                    class="text-4xl md:text-6xl font-black text-gray-900 dark:text-white mb-8 tracking-tight italic"
                >
                    {t("ecosystem.title")}
                </h2>

                <p
                    class="text-xl text-gray-600 dark:text-gray-400 mb-12 font-medium leading-relaxed"
                >
                    {t("ecosystem.subtitle")}
                </p>

                <div class="grid grid-cols-3 gap-6 mb-12">
                    <div
                        class="p-6 rounded-[2.5rem] bg-gray-50 dark:bg-zinc-900/50 border border-gray-100 dark:border-white/10 hover:border-blue-500/30 transition-all group"
                    >
                        <Smartphone
                            className="w-8 h-8 text-blue-500 mb-4 group-hover:scale-110 transition-transform"
                        />
                        <h4
                            class="text-sm font-black text-gray-900 dark:text-white uppercase mb-1"
                        >
                            {t("ecosystem.iphone.name")}
                        </h4>
                        <span
                            class="text-[10px] font-bold text-gray-500 dark:text-gray-500 uppercase tracking-widest"
                            >{t("ecosystem.iphone.os")}</span
                        >
                    </div>
                    <div
                        class="p-6 rounded-[2.5rem] bg-gray-50 dark:bg-zinc-900/50 border border-gray-100 dark:border-white/10 hover:border-blue-500/30 transition-all group"
                    >
                        <Tablet
                            className="w-8 h-8 text-purple-500 mb-4 group-hover:scale-110 transition-transform"
                        />
                        <h4
                            class="text-sm font-black text-gray-900 dark:text-white uppercase mb-1"
                        >
                            {t("ecosystem.ipad.name")}
                        </h4>
                        <span
                            class="text-[10px] font-bold text-gray-500 dark:text-gray-500 uppercase tracking-widest"
                            >{t("ecosystem.ipad.os")}</span
                        >
                    </div>
                    <div
                        class="p-6 rounded-[2.5rem] bg-gray-50 dark:bg-zinc-900/50 border border-gray-100 dark:border-white/10 hover:border-blue-500/30 transition-all group"
                    >
                        <Watch
                            className="w-8 h-8 text-pink-500 mb-4 group-hover:scale-110 transition-transform"
                        />
                        <h4
                            class="text-sm font-black text-gray-900 dark:text-white uppercase mb-1"
                        >
                            Watch
                        </h4>
                        <span
                            class="text-[10px] font-bold text-gray-500 dark:text-gray-500 uppercase tracking-widest"
                            >{t("ecosystem.watch.os")}</span
                        >
                    </div>
                </div>

                <div
                    class="flex items-center gap-4 py-8 border-t border-gray-100 dark:border-white/5"
                >
                    <div class="flex -space-x-4">
                        <div
                            class="w-12 h-12 rounded-2xl bg-blue-500/10 flex items-center justify-center text-blue-500 border-4 border-white dark:border-black backdrop-blur-sm"
                        >
                            <Cloud className="w-6 h-6" />
                        </div>
                        <div
                            class="w-12 h-12 rounded-2xl bg-purple-500/10 flex items-center justify-center text-purple-500 border-4 border-white dark:border-black backdrop-blur-sm"
                        >
                            <iPhoneIcon className="w-6 h-6"></iPhoneIcon>
                        </div>
                    </div>
                    <p
                        class="text-xs font-bold text-gray-500 dark:text-gray-400 max-w-xs uppercase tracking-tight leading-tight"
                    >
                        {t("ecosystem.description")}
                    </p>
                </div>
            </div>

            <!-- Image/Mockup -->
            <div class="relative group reveal reveal-right">
                <!-- Circular highlight behind image -->
                <div
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-blue-500/5 blur-[120px] rounded-full pointer-events-none group-hover:bg-blue-500/10 transition-all duration-700"
                >
                </div>

                <div
                    class="relative p-2 md:p-4 rounded-[40px] bg-white/50 dark:bg-zinc-900/30 backdrop-blur-3xl border border-white/20 dark:border-white/5 shadow-2xl"
                >
                    <Image
                        src={ecosystemMockup}
                        alt="VitalsPath Apple Ecosystem (iPhone, iPad, Watch)"
                        class="rounded-[32px] w-full h-auto shadow-2xl grayscale-[0.2] group-hover:grayscale-0 transition-all duration-700"
                    />
                </div>

                <!-- Floating badges for premium feel -->
                <div
                    class="absolute -top-6 -right-6 md:-top-12 md:-right-12 p-6 rounded-[2rem] bg-white/80 dark:bg-zinc-900/80 backdrop-blur-3xl border border-gray-100 dark:border-white/10 shadow-xl hidden md:block animate-bounce-subtle"
                >
                    <div class="flex items-center gap-3">
                        <div
                            class="w-10 h-10 rounded-full bg-green-500/10 flex items-center justify-center text-green-500"
                        >
                            <Check className="w-5 h-5" />
                        </div>
                        <div>
                            <p
                                class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-none mb-1"
                            >
                                Sync
                            </p>
                            <p
                                class="text-xs font-black text-gray-900 dark:text-white uppercase"
                            >
                                Real-Time iCloud
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .animate-bounce-subtle {
        animation: bounce-subtle 4s ease-in-out infinite;
    }
    @keyframes bounce-subtle {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }
</style>

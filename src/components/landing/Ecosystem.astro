---
import { Image } from "astro:assets";
import {
    Smartphone,
    Tablet,
    Watch,
    Cloud,
    Sparkles,
    Share2,
} from "lucide-react";

// Assets
import iphoneMockup from "../../assets/images/app-mockup.png";
import ipadHorizontal from "../../assets/images/eco-ipad-h.png";
import watchRing from "../../assets/images/eco-watch-ring.png";
import watchList from "../../assets/images/eco-watch-list.png";

import { type Lang } from "../../i18n/ui-locales";
import { useTranslations } from "../../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
    id="ecosystem"
    class="py-16 md:py-24 bg-white dark:bg-black overflow-hidden relative border-y border-gray-100 dark:border-white/5"
>
    <!-- Fluid background gradients for continuity -->
    <div class="absolute inset-0 pointer-events-none">
        <div
            class="absolute top-0 left-1/4 w-[800px] h-[600px] bg-blue-500/5 blur-[120px] rounded-full"
        >
        </div>
        <div
            class="absolute bottom-0 right-1/4 w-[800px] h-[600px] bg-purple-500/5 blur-[120px] rounded-full"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <!-- Header: More compact -->
        <div class="max-w-4xl mx-auto text-center mb-16 md:mb-20">
            <div
                class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 mb-6"
            >
                <Cloud className="w-3.5 h-3.5 text-blue-500" />
                <span
                    class="text-[10px] font-black uppercase tracking-widest text-blue-600 dark:text-blue-400"
                >
                    {t("ecosystem.badge")}
                </span>
            </div>
            <h2
                class="text-3xl md:text-6xl font-black text-gray-900 dark:text-white mb-6 tracking-tight italic"
            >
                {t("ecosystem.title")}
            </h2>
            <p
                class="text-lg md:text-xl text-gray-600 dark:text-gray-400 font-medium max-w-2xl mx-auto"
            >
                {t("ecosystem.subtitle")}
            </p>
        </div>

        <!-- Overlapping Device Mosaic: Much tighter and horizontal -->
        <div
            class="relative max-w-6xl mx-auto h-[400px] md:h-[600px] mb-16 md:mb-24 flex items-center justify-center"
        >
            <!-- iPad: The Base -->
            <div
                class="absolute w-[85%] md:w-[70%] lg:w-[65%] z-10 transform -translate-y-4 md:-translate-y-8"
            >
                <div
                    class="relative p-1.5 rounded-[40px] bg-white/50 dark:bg-zinc-900/30 backdrop-blur-xl border border-white/20 dark:border-white/10 shadow-[0_32px_64px_-16px_rgba(0,0,0,0.15)] dark:shadow-[0_32px_64px_-16px_rgba(0,0,0,0.5)] transition-transform duration-700 hover:scale-[1.02]"
                >
                    <Image
                        src={ipadHorizontal}
                        alt="iPad Interface"
                        class="rounded-[34px] w-full h-auto"
                    />
                </div>
            </div>

            <!-- iPhone: Overlapping Left -->
            <div
                class="absolute left-0 md:left-4 bottom-0 w-[30%] md:w-[22%] lg:w-[18%] z-30 transform translate-y-8 md:translate-y-12"
            >
                <div
                    class="relative p-1.5 rounded-[48px] bg-zinc-900 shadow-[0_32px_64px_-12px_rgba(0,0,0,0.3)] border-2 border-zinc-800 transition-all duration-700 hover:scale-105 hover:-rotate-2"
                >
                    <Image
                        src={iphoneMockup}
                        alt="iPhone Interface"
                        class="rounded-[42px] w-full h-auto"
                    />
                    <!-- Live Activity Badge -->
                    <div
                        class="absolute -top-3 left-1/2 -track-x-1/2 px-3 py-1 rounded-full bg-black border border-white/10 text-[8px] font-black text-cyan-400 uppercase tracking-widest whitespace-nowrap hidden md:block"
                    >
                        Dynamic Island
                    </div>
                </div>
            </div>

            <!-- Watch Duo: Overlapping Right -->
            <div
                class="absolute right-0 md:right-8 bottom-0 w-[35%] md:w-[28%] lg:w-[24%] z-20 flex flex-col items-end gap-2 md:gap-4 transform translate-y-4 md:translate-y-8"
            >
                <div
                    class="relative p-1 rounded-[2.2rem] bg-zinc-950 border border-zinc-800 shadow-2xl transition-all duration-700 hover:scale-110 hover:rotate-2 group"
                >
                    <Image
                        src={watchRing}
                        alt="Watch UI 1"
                        class="rounded-[2rem] w-full h-auto"
                    />
                </div>
                <div
                    class="relative p-1 rounded-[2.2rem] bg-zinc-950 border border-zinc-800 shadow-2xl transition-all duration-700 hover:scale-110 hover:-rotate-2 mr-4 md:mr-12 group"
                >
                    <Image
                        src={watchList}
                        alt="Watch UI 2"
                        class="rounded-[2rem] w-full h-auto"
                    />
                </div>
            </div>

            <!-- Floating Info Pill: Desktop Only -->
            <div
                class="absolute -bottom-8 right-1/4 z-40 hidden lg:block reveal"
            >
                <div
                    class="px-6 py-4 rounded-[2rem] bg-white/90 dark:bg-zinc-900/90 backdrop-blur-3xl border border-gray-100 dark:border-white/10 shadow-2xl flex items-center gap-4"
                >
                    <div
                        class="w-10 h-10 rounded-2xl bg-gradient-to-br from-blue-500 to-purple-500 flex items-center justify-center text-white"
                    >
                        <Share2 className="w-5 h-5" />
                    </div>
                    <div>
                        <p
                            class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-none mb-1"
                        >
                            {lang === "es" ? "Sincronización" : "Sync"}
                        </p>
                        <p
                            class="text-xs font-black text-gray-900 dark:text-white uppercase"
                        >
                            SwiftData / iCloud
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- System Requirements: Integrated & Horizontal -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-5xl mx-auto">
            <div
                class="p-6 rounded-[2.5rem] bg-gray-50 dark:bg-zinc-900/50 border border-gray-100 dark:border-white/5 flex flex-col items-center text-center group hover:bg-white dark:hover:bg-zinc-800 transition-all"
            >
                <Smartphone
                    className="w-6 h-6 text-blue-500 mb-3 group-hover:scale-110 transition-transform"
                />
                <span
                    class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1"
                    >iPhone</span
                >
                <p class="text-sm font-black text-gray-900 dark:text-white">
                    iOS 18+
                </p>
            </div>
            <div
                class="p-6 rounded-[2.5rem] bg-gray-50 dark:bg-zinc-900/50 border border-gray-100 dark:border-white/5 flex flex-col items-center text-center group hover:bg-white dark:hover:bg-zinc-800 transition-all"
            >
                <Tablet
                    className="w-6 h-6 text-purple-500 mb-3 group-hover:scale-110 transition-transform"
                />
                <span
                    class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1"
                    >iPad</span
                >
                <p class="text-sm font-black text-gray-900 dark:text-white">
                    iPadOS 18+
                </p>
            </div>
            <div
                class="p-6 rounded-[2.5rem] bg-gray-50 dark:bg-zinc-900/50 border border-gray-100 dark:border-white/5 flex flex-col items-center text-center group hover:bg-white dark:hover:bg-zinc-800 transition-all"
            >
                <Watch
                    className="w-6 h-6 text-pink-500 mb-3 group-hover:scale-110 transition-transform"
                />
                <span
                    class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-1"
                    >Watch</span
                >
                <p class="text-sm font-black text-gray-900 dark:text-white">
                    watchOS 11+
                </p>
            </div>
            <div
                class="p-6 rounded-[2.5rem] bg-blue-500/5 dark:bg-blue-500/10 border border-blue-500/20 flex flex-col items-center justify-center text-center group hover:bg-blue-500/10 transition-all"
            >
                <Sparkles
                    className="w-6 h-6 text-cyan-500 mb-3 group-hover:rotate-12 transition-transform"
                />
                <span
                    class="text-[10px] font-black text-blue-500 uppercase tracking-widest mb-1"
                    >Integrated</span
                >
                <p class="text-sm font-black text-gray-900 dark:text-white">
                    Apple Health
                </p>
            </div>
        </div>
    </div>
</section>

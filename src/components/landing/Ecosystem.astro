---
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { Activity, LayoutTemplate, Zap } from "lucide-react";
import { Image } from "astro:assets";
import watchVitals from "../../assets/images/devices/watch_vitals_clean.png";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);

// Icons mapping for ecosystem items
const icons = [LayoutTemplate, Zap, Activity]; 
---

<section id="ecosystem" class="py-24 sm:py-32 relative overflow-hidden bg-slate-50/50 dark:bg-black/20">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
            
            <!-- Left Side: Text and Checklist -->
            <div class="reveal">
                <div class="inline-flex items-center px-4 py-1.5 rounded-full glass-panel border border-teal-vibrant/20 dark:border-teal-vibrant/10 mb-8 shadow-sm">
                    <span class="text-teal-vibrant text-[11px] font-bold tracking-[0.2em] uppercase">
                        {copy.home.ecosystemLabel}
                    </span>
                </div>
                
                <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tighter text-balance mb-6">
                    {copy.home.ecosystemTitle}
                </h2>
                
                <p class="text-xl text-slate-600 dark:text-slate-400 font-medium mb-12 max-w-2xl leading-relaxed">
                    {copy.home.ecosystemBody}
                </p>

                <div class="space-y-8">
                    {copy.home.ecosystemItems.map((item, index) => {
                        const Icon = icons[index % icons.length];
                        return (
                            <div class={`reveal stagger-${index + 1} flex items-start group`}>
                                <div class="flex-shrink-0 mt-1">
                                    <div class="w-12 h-12 rounded-2xl bg-teal-vibrant/10 dark:bg-teal-vibrant/20 flex items-center justify-center transform transition-transform duration-500 group-hover:scale-110 group-hover:-rotate-6 border border-teal-vibrant/20">
                                        <Icon className="w-6 h-6 text-teal-vibrant" />
                                    </div>
                                </div>
                                <div class="ml-6">
                                    <h3 class="text-2xl font-black text-slate-900 dark:text-white mb-2 tracking-tight block group-hover:text-teal-vibrant transition-colors duration-300">
                                        {item.title}
                                    </h3>
                                    <p class="text-lg text-slate-600 dark:text-slate-400 font-medium">
                                        {item.description}
                                    </p>
                                </div>
                            </div>
                        );
                    })}
                </div>
            </div>

            <!-- Right Side: Giant Apple Watch -->
            <div class="relative flex justify-center items-center py-10 lg:py-0 reveal-scale stagger-3 perspective-1000 mt-8 lg:mt-0">
                <!-- Glowing background behind the watch -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4/5 h-4/5 bg-gradient-to-tr from-teal-vibrant/30 to-blue-500/20 blur-[100px] rounded-full z-0 animate-pulse-slow pointer-events-none mix-blend-multiply dark:mix-blend-screen"></div>
                
                <!-- Giant Watch Mockup container -->
                <div class="relative z-10 w-full max-w-[340px] sm:max-w-[420px] transform transition-transform duration-1000 hover:scale-105 hover:-translate-y-4 hover:rotate-2">
                    <Image
                        src={watchVitals}
                        alt="VitalsPath on Apple Watch"
                        class="w-full h-auto object-contain rounded-[3rem] mockup-clean-blend-watch"
                        loading="lazy"
                    />
                </div>
            </div>

        </div>
    </div>
</section>

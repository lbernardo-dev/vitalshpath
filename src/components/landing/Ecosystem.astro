---
import { Image } from "astro:assets";
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import widgetScreen from "../../assets/images/screens/screen-20-widgets-home.PNG";
import watchListScreen from "../../assets/images/eco-watch-list.png";
import liveActivityScreen from "../../assets/images/screens/screen-27-live-activity2.PNG";
import { Smartphone, Watch, Zap } from "lucide-react";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);

// Localized items for ecosystem
const localizedItems: Record<string, any[]> = {
    en: [
        { title: "Widgets", description: "Check medications and vitals directly from your home screen.", icon: Smartphone },
        { title: "Apple Watch", description: "Fast actions and quick logging right on your wrist.", icon: Watch },
        { title: "Live Activities", description: "Stay updated on active doses in real-time.", icon: Zap }
    ],
    es: [
        { title: "Widgets", description: "Consulta medicación y constantes desde tu pantalla de inicio.", icon: Smartphone },
        { title: "Apple Watch", description: "Acciones rápidas y registros directos desde tu muñeca.", icon: Watch },
        { title: "Live Activities", description: "Mantente al día de tus tomas activas en tiempo real.", icon: Zap }
    ],
    fr: [
        { title: "Widgets", description: "Consultez vos médicaments et constantes depuis l'écran d'accueil.", icon: Smartphone },
        { title: "Apple Watch", description: "Actions rapides et enregistrements directs à votre poignet.", icon: Watch },
        { title: "Live Activities", description: "Restez à jour sur vos doses actives en temps réel.", icon: Zap }
    ]
};

const items = localizedItems[lang as string] || localizedItems.en;
---

<section id="ecosystem" class="py-24 sm:py-32 overflow-hidden bg-transparent">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <div class="lg:grid lg:grid-cols-2 gap-20 items-center">
            <div class="reveal">
                <h2 class="text-[10px] font-black uppercase tracking-[0.3em] text-teal-primary mb-4">
                    Ecosystem
                </h2>
                <h3 class="font-serif text-4xl sm:text-6xl font-black text-slate-text leading-[1.1] mb-8">
                    {copy.home.sections[1].title}
                </h3>
                <p class="text-xl text-slate-muted leading-relaxed mb-12 max-w-xl">
                    {copy.home.sections[1].body}
                </p>
                
                <div class="space-y-4">
                    {items.map((item, index) => (
                        <div class={`reveal stagger-${index + 1} flex items-center gap-6 p-6 premium-card hover:bg-white/70 dark:hover:bg-white/10 group`}>
                            <div class="w-12 h-12 rounded-2xl bg-teal-primary/10 flex items-center justify-center text-teal-primary shrink-0 group-hover:scale-110 transition-transform duration-500">
                                <item.icon className="w-6 h-6" />
                            </div>
                            <div>
                                <h4 class="text-lg font-bold text-slate-text mb-0.5">
                                    {item.title}
                                </h4>
                                <p class="text-slate-muted text-sm group-hover:text-slate-text transition-colors">
                                    {item.description}
                                </p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <div class="mt-20 lg:mt-0 relative reveal reveal-scale stagger-2">
                <!-- Decorative background elements -->
                <div class="absolute -inset-10 bg-teal-primary blur-[150px] opacity-10 dark:opacity-20 animate-pulse"></div>
                
                <div class="relative glass-panel p-4 sm:p-8 rounded-[3.5rem] border-white/40 dark:border-white/5">
                    <div class="grid grid-cols-2 gap-4 sm:gap-6">
                        <div class="space-y-4 sm:space-y-6">
                            <div class="rounded-[2rem] overflow-hidden border border-white/40 shadow-2xl rotate-[-3deg] hover:rotate-0 transition-all duration-1000 group">
                                <Image src={widgetScreen} alt="VitalsPath Widgets" class="w-full h-auto group-hover:scale-105 transition-transform duration-1000" />
                            </div>
                            <div class="rounded-[2.5rem] overflow-hidden border border-white/40 shadow-2xl rotate-[2deg] hover:rotate-0 transition-all duration-1000 group">
                                <Image src={watchListScreen} alt="VitalsPath Apple Watch" class="w-full h-auto group-hover:scale-105 transition-transform duration-1000" />
                            </div>
                        </div>
                        <div class="flex items-center">
                            <div class="rounded-[2rem] overflow-hidden border border-white/40 shadow-2xl rotate-[4deg] hover:rotate-0 transition-all duration-1000 group">
                                <Image src={liveActivityScreen} alt="VitalsPath Live Activities" class="w-full h-auto group-hover:scale-105 transition-transform duration-1000" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

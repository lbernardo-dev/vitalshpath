---
import { Image } from "astro:assets";
import {
    Smartphone,
    Tablet,
    Watch,
    Cloud,
    Check,
    Infinity,
    Sparkles,
} from "lucide-react";

// Assets
import iphoneMockup from "../../assets/images/app-mockup.png";
import ipadHorizontal from "../../assets/images/eco-ipad-h.png";
import watchRing from "../../assets/images/eco-watch-ring.png";
import watchList from "../../assets/images/eco-watch-list.png";

import { type Lang } from "../../i18n/ui-locales";
import { useTranslations } from "../../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
    id="ecosystem"
    class="py-24 md:py-40 bg-white dark:bg-black overflow-hidden border-y border-gray-100 dark:border-white/5 relative"
>
    <!-- Premium Ambient Glow -->
    <div class="absolute inset-0 pointer-events-none">
        <div
            class="absolute top-1/4 -left-24 w-[600px] h-[600px] bg-blue-500/10 blur-[150px] rounded-full"
        >
        </div>
        <div
            class="absolute bottom-1/4 -right-24 w-[600px] h-[600px] bg-purple-500/10 blur-[150px] rounded-full"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <!-- Section Header -->
        <div class="max-w-4xl mx-auto text-center mb-24 md:mb-32">
            <div
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-50 dark:bg-blue-500/10 border border-blue-100 dark:border-blue-500/20 mb-8"
            >
                <Cloud className="w-4 h-4 text-blue-500" />
                <span
                    class="text-[11px] font-black uppercase tracking-widest text-blue-600 dark:text-blue-400"
                >
                    {t("ecosystem.badge")}
                </span>
            </div>
            <h2
                class="text-4xl md:text-7xl font-black text-gray-900 dark:text-white mb-8 tracking-tight italic"
            >
                {t("ecosystem.title")}
            </h2>
            <p
                class="text-xl md:text-2xl text-gray-600 dark:text-gray-400 font-medium leading-relaxed max-w-2xl mx-auto"
            >
                {t("ecosystem.subtitle")}
            </p>
        </div>

        <!-- Devices Showcase -->
        <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center max-w-7xl mx-auto"
        >
            <!-- Left: iPad Showcase (The biggest) -->
            <div class="lg:col-span-12 xl:col-span-8">
                <div class="relative group">
                    <!-- Glass Container -->
                    <div
                        class="relative p-2 rounded-[48px] bg-gradient-to-br from-white/40 to-white/10 dark:from-white/5 dark:to-transparent border border-white/20 dark:border-white/5 shadow-2xl overflow-hidden hover:scale-[1.01] transition-all duration-700"
                    >
                        <div
                            class="absolute inset-0 bg-blue-500/5 dark:bg-blue-500/2 opacity-0 group-hover:opacity-100 transition-opacity duration-700"
                        >
                        </div>
                        <Image
                            src={ipadHorizontal}
                            alt="VitalsPath on iPad Pro (Horizontal)"
                            class="rounded-[40px] w-full h-auto shadow-2xl relative z-10 block"
                        />

                        <!-- Floating Device Detail -->
                        <div
                            class="absolute top-8 right-8 z-20 hidden md:block"
                        >
                            <div
                                class="px-6 py-4 rounded-[2rem] bg-white/80 dark:bg-zinc-900/80 backdrop-blur-3xl border border-white/20 dark:border-white/5 shadow-xl"
                            >
                                <div class="flex items-center gap-3">
                                    <div
                                        class="w-10 h-10 rounded-2xl bg-purple-500/10 flex items-center justify-center text-purple-500"
                                    >
                                        <Tablet className="w-5 h-5" />
                                    </div>
                                    <div>
                                        <p
                                            class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-none mb-1"
                                        >
                                            Display
                                        </p>
                                        <p
                                            class="text-xs font-black text-gray-900 dark:text-white uppercase"
                                        >
                                            iPadOS 18 Optimized
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: iPhone & Watch Duo -->
            <div
                class="lg:col-span-12 xl:col-span-4 flex flex-col gap-12 sm:flex-row xl:flex-col items-center justify-center"
            >
                <!-- iPhone Mockup (Real App Screenshot) -->
                <div class="relative group w-full max-w-[320px]">
                    <div
                        class="relative p-2 rounded-[60px] bg-gray-900 shadow-2xl border-4 border-gray-800 dark:border-zinc-800"
                    >
                        <Image
                            src={iphoneMockup}
                            alt="VitalsPath on iPhone 16 Pro"
                            class="rounded-[52px] w-full h-auto shadow-inner"
                        />
                        <!-- Dynamic Island Badge -->
                        <div
                            class="absolute top-10 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full bg-black border border-white/10 text-[9px] font-black text-cyan-400 uppercase tracking-widest flex items-center gap-2"
                        >
                            <Sparkles className="w-3 h-3" />
                            Live Activities
                        </div>
                    </div>

                    <div class="mt-8 text-center sm:text-left xl:text-center">
                        <h4
                            class="text-lg font-black text-gray-900 dark:text-white uppercase italic"
                        >
                            {t("ecosystem.iphone.name")}
                        </h4>
                        <p
                            class="text-xs font-bold text-blue-500 uppercase tracking-[0.2em]"
                        >
                            {t("ecosystem.iphone.os")}
                        </p>
                    </div>
                </div>

                <!-- Watch Duo (Real App Screenshots) -->
                <div class="flex flex-col items-center xl:w-full">
                    <div
                        class="flex -space-x-16 sm:-space-x-20 xl:-space-x-24 items-center group"
                    >
                        <!-- Watch Ring -->
                        <div
                            class="relative z-10 hover:z-30 hover:scale-110 transition-all duration-500 p-2 rounded-[2.5rem] bg-zinc-950 border border-zinc-800 shadow-2xl"
                        >
                            <Image
                                src={watchRing}
                                alt="VitalsPath on Apple Watch Ring"
                                class="rounded-[2.2rem] w-[140px] sm:w-[160px] h-auto"
                            />
                        </div>
                        <!-- Watch List -->
                        <div
                            class="relative z-20 hover:z-30 hover:scale-110 transition-all duration-500 p-2 rounded-[2.5rem] bg-zinc-950 border border-zinc-800 shadow-2xl rotate-[3deg]"
                        >
                            <Image
                                src={watchList}
                                alt="VitalsPath on Apple Watch Schedule"
                                class="rounded-[2.2rem] w-[140px] sm:w-[160px] h-auto"
                            />
                        </div>
                    </div>

                    <div class="mt-8 text-center sm:text-left xl:text-center">
                        <h4
                            class="text-lg font-black text-gray-900 dark:text-white uppercase italic"
                        >
                            Apple Watch
                        </h4>
                        <p
                            class="text-xs font-bold text-pink-500 uppercase tracking-[0.2em]"
                        >
                            {t("ecosystem.watch.os")}
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sync Info Banner -->
        <div class="mt-24 md:mt-40 max-w-4xl mx-auto stagger-1">
            <div
                class="p-8 md:p-12 rounded-[3rem] bg-gradient-to-br from-blue-500/5 to-purple-500/5 border border-blue-500/10 dark:border-white/5 relative overflow-hidden text-center backdrop-blur-3xl"
            >
                <div
                    class="absolute -top-12 -right-12 w-40 h-40 bg-blue-500/10 blur-[60px] rounded-full"
                >
                </div>
                <div
                    class="absolute -bottom-12 -left-12 w-40 h-40 bg-purple-500/10 blur-[60px] rounded-full"
                >
                </div>

                <h3
                    class="text-2xl font-black text-gray-900 dark:text-white mb-6 uppercase tracking-tight italic"
                >
                    Sincronización {
                        lang === "es" ? "en tiempo real" : "Real-Time Sync"
                    }
                </h3>
                <p
                    class="text-gray-600 dark:text-gray-400 font-medium leading-relaxed max-w-2xl mx-auto"
                >
                    {t("ecosystem.description")}
                </p>

                <div class="flex flex-wrap justify-center gap-4 mt-8">
                    {
                        ["HealthKit", "iCloud", "SwiftData"].map((val) => (
                            <div class="px-5 py-2 rounded-2xl bg-white dark:bg-white/5 border border-gray-100 dark:border-white/10 text-[10px] font-black uppercase tracking-widest text-gray-500 dark:text-gray-500">
                                {val}
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .animate-bounce-subtle {
        animation: bounce-subtle 4s ease-in-out infinite;
    }
    @keyframes bounce-subtle {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-10px);
        }
    }
</style>

---
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { 
    Activity, 
    Pill, 
    Calendar, 
    Smartphone, 
    ShieldCheck, 
    Stethoscope
} from "lucide-react";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);

const iconMap: Record<string, any> = {
    // English
    "Medication and dose tracking": Pill,
    "Vitals and measurements": Activity,
    "Appointments and follow-up tasks": Calendar,
    "Widgets, Live Activities and Apple Watch": Smartphone,
    // Spanish
    "Seguimiento de medicación y dosis": Pill,
    "Constantes y mediciones": Activity,
    "Citas y tareas de seguimiento": Calendar,
    "Widgets, Live Activities y Apple Watch": Smartphone,
    // French
    "Suivi des médicaments et des doses": Pill,
    "Constantes et mesures": Activity,
    "Rendez-vous et tâches de suivi": Calendar,
    "Widgets, Live Activities et Apple Watch": Smartphone,
};

const getIcon = (title: string) => {
    return iconMap[title] || ShieldCheck;
};

// Refined colors for the icons to match the premium theme
const iconColors = [
    "text-teal-primary bg-teal-primary/10",
    "text-orange-accent bg-orange-accent/10",
    "text-indigo-600 bg-indigo-600/10",
    "text-emerald-600 bg-emerald-600/10",
];
---

<section id="features" class="py-24 sm:py-32 bg-transparent transition-colors duration-500">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <div class="text-center mb-20 max-w-3xl mx-auto">
            <h2 class="text-[10px] font-black uppercase tracking-[0.3em] text-teal-primary mb-4 reveal reveal-scale">
                Features
            </h2>
            <h3 class="font-serif text-4xl sm:text-6xl font-black text-slate-text px-4 reveal stagger-1 leading-tight">
                {copy.home.featureListTitle}
            </h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8 cursor-default">
            {
                copy.home.featureListItems.map((feature, index) => {
                    const Icon = getIcon(feature);
                    const colorStyles = iconColors[index % iconColors.length];
                    
                    return (
                        <div class={`reveal reveal-scale stagger-${(index % 4) + 1} group p-8 premium-card hover:bg-white/70 dark:hover:bg-white/10`}>
                            <div class={`w-14 h-14 ${colorStyles} rounded-2xl flex items-center justify-center mb-8 border border-current/10 group-hover:scale-110 group-hover:rotate-3 transition-all duration-700`}>
                                <Icon className="w-7 h-7" />
                            </div>
                            <h4 class="text-xl font-bold text-slate-text mb-2 leading-tight">
                                {feature}
                            </h4>
                        </div>
                    );
                })
            }
        </div>
        
        <!-- Large visual card - JourneyBot style -->
        <div class="mt-24 reveal stagger-5">
            <div class="rounded-[3rem] bg-white/40 dark:bg-white/5 p-8 sm:p-16 lg:p-20 border border-white/60 dark:border-white/10 overflow-hidden relative group">
                <!-- Inner glow -->
                <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-teal-primary/30 to-transparent"></div>
                
                <div class="lg:grid lg:grid-cols-2 gap-16 items-center relative z-10">
                    <div>
                        <div class="inline-flex items-center rounded-full px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-orange-accent bg-orange-accent/10 mb-6 border border-orange-accent/10">
                            Expert Care
                        </div>
                        <h4 class="font-serif text-4xl sm:text-5xl font-black text-slate-text mb-8 leading-[1.1]">
                            {copy.home.sections[0].title}
                        </h4>
                        <p class="text-lg text-slate-muted leading-relaxed max-w-xl">
                            {copy.home.sections[0].body}
                        </p>
                    </div>
                    <div class="mt-12 lg:mt-0 flex justify-center lg:justify-end">
                        <div class="relative">
                            <div class="absolute inset-0 bg-teal-primary blur-[100px] opacity-10 group-hover:opacity-20 transition-opacity"></div>
                            <div class="p-8 rounded-[3rem] bg-white/20 dark:bg-black/20 backdrop-blur-3xl border border-white/40 dark:border-white/5 shadow-inner">
                                <Stethoscope className="w-24 h-24 sm:w-40 sm:h-40 text-teal-primary relative z-10 opacity-80" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
                  </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

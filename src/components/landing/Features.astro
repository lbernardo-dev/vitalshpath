---
import { Image } from "astro:assets";
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { 
    Activity, 
    Pill, 
    Calendar, 
    Smartphone, 
    ShieldCheck, 
    Stethoscope
} from "lucide-react";

// New feature mockups
import iphoneMeds from "../../assets/images/devices/iphone_meds.png";
import iphoneSynthom from "../../assets/images/devices/iphone_synthom.png";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);

// Generic icon getter based on index for simplicity across 15 languages
const icons = [Pill, Activity, Calendar, Smartphone];
const getIcon = (index: number) => icons[index % icons.length] || ShieldCheck;

const iconColors = [
    "text-teal-primary bg-teal-primary/10 border-teal-primary/20",
    "text-orange-accent bg-orange-accent/10 border-orange-accent/20",
    "text-indigo-500 bg-indigo-500/10 border-indigo-500/20",
    "text-emerald-500 bg-emerald-500/10 border-emerald-500/20",
];
---

<section id="features" class="py-32 sm:py-40 bg-transparent transition-colors duration-[1.2s] relative">
    
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 relative z-10">
        
        <div class="text-center mb-20 max-w-4xl mx-auto">
            <h2 class="text-[11px] font-black uppercase tracking-[0.3em] text-teal-primary mb-6 reveal reveal-scale">
                Features
            </h2>
            <h3 class="text-4xl sm:text-6xl md:text-7xl font-black text-slate-text px-4 reveal stagger-1 leading-[1.15] tracking-tighter">
                {copy.home.featureListTitle}
            </h3>
        </div>

        <!-- Glass Grid (Ritualist Style) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-32">
            {
                copy.home.featureListItems.map((feature, index) => {
                    const Icon = getIcon(index);
                    const colorStyles = iconColors[index % iconColors.length];
                    
                    return (
                        <div class={`reveal reveal-scale stagger-${(index % 4) + 1} group p-8 sm:p-10 premium-card`}>
                            <div class={`w-14 h-14 ${colorStyles} rounded-[1.2rem] flex items-center justify-center mb-8 border transition-transform duration-700 group-hover:scale-110 group-hover:rotate-6 shadow-sm`}>
                                <Icon className="w-6 h-6" />
                            </div>
                            <h4 class="text-xl font-bold text-slate-text mb-2 leading-tight tracking-tight">
                                {feature}
                            </h4>
                        </div>
                    );
                })
            }
        </div>
        
        <!-- Premium Visual Cards -->
        <div class="space-y-32">
            <!-- Card 01: Specialized Tracking -->
            <div class="reveal stagger-1 rounded-[4rem] bg-gradient-to-br from-white/40 to-white/10 dark:from-white/5 dark:to-transparent p-8 sm:p-12 lg:p-20 border border-white/80 dark:border-white/10 overflow-hidden relative group backdrop-blur-3xl shadow-premium-soft">
                <div class="absolute -top-[20%] -right-[10%] w-[70%] h-[140%] bg-teal-primary/10 blur-[100px] -z-10 rounded-full animate-pulse-slow"></div>
                
                <div class="lg:grid lg:grid-cols-2 gap-16 items-center relative z-10">
                    <div class="order-2 lg:order-1 mt-12 lg:mt-0 flex justify-center">
                        <div class="relative max-w-[340px] animate-float">
                            <Image
                                src={iphoneMeds}
                                alt="Medication Tracking"
                                class="w-full h-auto drop-shadow-premium select-none pointer-events-none mix-blend-multiply dark:mix-blend-screen contrast-[1.02]"
                            />
                        </div>
                    </div>
                    
                    <div class="order-1 lg:order-2">
                        <div class="inline-flex items-center rounded-full px-5 py-2 text-[10px] font-black uppercase tracking-[0.25em] text-teal-primary bg-teal-primary/10 mb-8 border border-teal-primary/20">
                            01. Personal Health
                        </div>
                        <h4 class="text-4xl sm:text-6xl font-black text-slate-text mb-8 leading-[1.1] tracking-tighter text-balance uppercase">
                            {copy.home.sections[0].title}
                        </h4>
                        <p class="text-xl text-slate-muted leading-relaxed font-medium mb-10">
                            {copy.home.sections[0].body}
                        </p>
                        <div class="flex flex-wrap gap-4">
                            {["Intelligent Alerts", "Family Sync", "Privacy First"].map(tag => (
                                <span class="px-4 py-2 rounded-xl bg-teal-primary/5 border border-teal-primary/10 text-[11px] font-bold text-teal-primary uppercase tracking-widest">{tag}</span>
                            ))}
                        </div>
                    </div>
                </div>
            </div>

            <!-- Card 02: Symptoms & Insights -->
            <div class="reveal stagger-2 rounded-[4rem] bg-gradient-to-bl from-white/40 to-white/10 dark:from-white/5 dark:to-transparent p-8 sm:p-12 lg:p-20 border border-white/80 dark:border-white/10 overflow-hidden relative group backdrop-blur-3xl shadow-premium-soft">
                <div class="absolute -bottom-[20%] -left-[10%] w-[70%] h-[140%] bg-orange-accent/10 blur-[100px] -z-10 rounded-full animate-pulse-slow" style="animation-delay: -3s"></div>

                 <div class="lg:grid lg:grid-cols-2 gap-16 items-center relative z-10">
                    <div>
                        <div class="inline-flex items-center rounded-full px-5 py-2 text-[10px] font-black uppercase tracking-[0.25em] text-orange-accent bg-orange-accent/10 mb-8 border border-orange-accent/20">
                            02. Smart Analytics
                        </div>
                        <h4 class="text-4xl sm:text-6xl font-black text-slate-text mb-8 leading-[1.1] tracking-tighter text-balance uppercase">
                            {copy.home.sections[1].title}
                        </h4>
                        <p class="text-xl text-slate-muted leading-relaxed font-medium mb-10">
                            {copy.home.sections[1].body}
                        </p>
                         <div class="flex flex-wrap gap-4">
                            {["Symptom Trends", "PDF Reports", "Doc Connect"].map(tag => (
                                <span class="px-4 py-2 rounded-xl bg-orange-accent/5 border border-orange-accent/10 text-[11px] font-bold text-orange-accent uppercase tracking-widest">{tag}</span>
                            ))}
                        </div>
                    </div>

                    <div class="mt-12 lg:mt-0 flex justify-center">
                        <div class="relative max-w-[340px] animate-float" style="animation-delay: -4s">
                            <Image 
                                src={iphoneSynthom} 
                                alt="Symptom Tracking" 
                                class="w-full h-auto drop-shadow-[0_30px_60px_rgba(0,0,0,0.12)]" 
                            />
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>


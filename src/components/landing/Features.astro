---
import { Image } from "astro:assets";
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";

// Import all necessary screens for the expanded bento grid
import screenMeds from "../../assets/images/screens/screen-04-medications.PNG";
import screenSymptoms from "../../assets/images/screens/screen-13-symptoms.PNG";
import screenAppointments from "../../assets/images/screens/screen-11-appointments.PNG";
import screenLiveActivity from "../../assets/images/screens/screen-27-live-activity.PNG";
import screenWidgets from "../../assets/images/screens/screen-20-widgets-home.PNG";
import screenWellness from "../../assets/images/screens/screen-18-wellness.PNG";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);

// Map bento cards to their respective images and colors (6 cards)
const cardMetadata = [
    { 
        image: screenMeds, 
        color: "teal", 
        glow: "hover:shadow-[0_40px_80px_-20px_rgba(45,212,191,0.2)]",
        bgGlow: "from-teal-vibrant/10",
        badgeStyle: "bg-teal-vibrant/10 text-teal-vibrant dark:bg-teal-vibrant/20 dark:text-teal-300"
    },
    { 
        image: screenSymptoms, 
        color: "orange", 
        glow: "hover:shadow-[0_40px_80px_-20px_rgba(251,146,60,0.2)]",
        bgGlow: "from-coral-accent/10",
        badgeStyle: "bg-coral-accent/10 text-coral-accent dark:bg-coral-accent/20 dark:text-orange-300"
    },
    { 
        image: screenWellness, 
        color: "emerald", 
        glow: "hover:shadow-[0_40px_80px_-20px_rgba(16,185,129,0.2)]",
        bgGlow: "from-emerald-500/10",
        badgeStyle: "bg-emerald-500/10 text-emerald-600 dark:bg-emerald-500/20 dark:text-emerald-300"
    },
    { 
        image: screenAppointments, 
        color: "indigo", 
        glow: "hover:shadow-[0_40px_80px_-20px_rgba(99,102,241,0.25)]",
        bgGlow: "from-indigo-500/10",
        badgeStyle: "bg-indigo-500/10 text-indigo-600 dark:bg-indigo-500/20 dark:text-indigo-300"
    },
    { 
        image: screenWidgets, 
        color: "cyan", 
        glow: "hover:shadow-[0_40px_80px_-20px_rgba(6,182,212,0.25)]",
        bgGlow: "from-cyan-500/10",
        badgeStyle: "bg-cyan-500/10 text-cyan-600 dark:bg-cyan-500/20 dark:text-cyan-300"
    },
    { 
        image: screenLiveActivity, 
        color: "rose", 
        glow: "hover:shadow-[0_40px_80px_-20px_rgba(244,63,94,0.25)]",
        bgGlow: "from-rose-500/10",
        badgeStyle: "bg-rose-500/10 text-rose-600 dark:bg-rose-500/20 dark:text-rose-300"
    }
];

const allCards = copy.home.bentoCards.map((card, i) => ({
    ...card, 
    ...cardMetadata[i]
}));
---

<section id="features" class="relative overflow-hidden bg-white py-12 sm:py-16 dark:bg-[#080b0f]">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
        
        <!-- Section Title -->
        <div class="mb-12 max-w-4xl reveal">
            <h2 class="mb-4 text-[clamp(2.1rem,5vw,4.4rem)] font-black leading-none tracking-tight text-slate-950 dark:text-white">
                {copy.home.featureListTitle}
            </h2>
            <p class="max-w-2xl text-lg font-medium leading-8 text-slate-600 dark:text-slate-300 md:text-xl">
                {copy.home.featureListSubtitle}
            </p>
        </div>

        <!-- Bento Grid Expanded -->
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
            {allCards.map((card, index) => (
                <div class={`group relative flex min-h-[560px] flex-col justify-between overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 transition-all duration-500 hover:-translate-y-1 hover:bg-white ${card.glow} reveal-scale stagger-${index % 3 + 1} dark:border-white/10 dark:bg-white/[0.04] dark:hover:bg-white/[0.07]`}>
                    
                    <!-- Card Content (Top) -->
                    <div class="z-10 p-6 pb-0 sm:p-7">
                        <div class={`mb-4 inline-flex rounded-lg px-2.5 py-1 ${card.badgeStyle || card.badge} text-[10px] font-black uppercase tracking-[0.16em]`}>
                            {card.badge}
                        </div>
                        <h3 class="mb-3 text-2xl font-black leading-none tracking-tight text-slate-950 dark:text-white sm:text-3xl">
                            {card.title}
                        </h3>
                        <p class="mb-5 text-sm font-medium leading-6 text-slate-600 dark:text-slate-300 sm:text-base">
                            {card.body}
                        </p>
                        <div class="flex flex-wrap gap-1.5">
                            {card.tags.map((tag: string) => (
                                <span class="rounded-md bg-white px-2.5 py-1 text-[10px] font-extrabold uppercase tracking-wide text-slate-500 ring-1 ring-slate-200 dark:bg-white/5 dark:text-slate-300 dark:ring-white/10">
                                    {tag}
                                </span>
                            ))}
                        </div>
                    </div>

                    <!-- Image Container (Bottom) -->
                    <div class="relative mt-auto flex aspect-[4/3] w-full items-start justify-center overflow-hidden px-6 sm:px-10">
                        <!-- Subtle inner glow -->
                        <div class={`absolute inset-x-0 bottom-0 z-0 h-2/3 bg-gradient-to-t ${card.bgGlow} to-transparent`}></div>
                        <div class="relative z-10 w-full max-w-[185px] translate-y-4 transform transition-transform duration-700 group-hover:translate-y-0 sm:max-w-[205px]">
                            <!-- Device Frame -->
                            <div class="relative aspect-[1170/2532] w-full overflow-hidden rounded-[2rem] border-[7px] border-slate-950 bg-slate-900 shadow-2xl ring-1 ring-white/10">
                                <!-- Dynamic Notch -->
                                <div class="absolute top-1.5 sm:top-2 left-1/2 -translate-x-1/2 w-[35%] h-4 sm:h-5 bg-black rounded-full z-20"></div>
                                <Image
                                    src={card.image}
                                    alt={card.title}
                                    class="w-full h-full object-cover"
                                    loading="lazy"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>

    </div>
</section>

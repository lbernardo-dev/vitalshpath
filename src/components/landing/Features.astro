---
import { Image } from "astro:assets";
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";

import iphoneMeds from "../../assets/images/devices/iphone_meds.png";
import iphoneSynthom from "../../assets/images/devices/iphone_synthom.png";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
---

<section id="features" class="py-20 sm:py-24 bg-slate-50 dark:bg-slate-900/50">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        
        <!-- Section Title -->
        <div class="text-center mb-16 max-w-3xl mx-auto">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-text dark:text-white mb-4 tracking-tight">
                {copy.home.featureListTitle}
            </h2>
        </div>

        <!-- Feature Cards -->
        <div class="space-y-16">
            <!-- Card 01 -->
            <div class="lg:grid lg:grid-cols-2 gap-12 items-center">
                <div class="order-2 lg:order-1">
                    <div class="text-sm font-bold text-teal-primary uppercase tracking-widest mb-3">
                        {copy.home.featureTags[0][0]}
                    </div>
                    <h3 class="text-2xl sm:text-3xl font-black text-slate-text dark:text-white mb-4 tracking-tight">
                        {copy.home.sections[0].title}
                    </h3>
                    <p class="text-lg text-slate-muted leading-relaxed">
                        {copy.home.sections[0].body}
                    </p>
                    <div class="flex flex-wrap gap-2 mt-6">
                        {copy.home.featureTags[0].map((tag: string) => (
                            <span class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-xs font-medium text-slate-600 dark:text-slate-300">{tag}</span>
                        ))}
                    </div>
                </div>
                <div class="order-1 lg:order-2 mt-8 lg:mt-0">
                    <div class="relative rounded-[2.5rem] overflow-hidden shadow-2xl">
                        <Image
                            src={iphoneMeds}
                            alt="Medication Tracking"
                            class="w-full h-auto"
                        />
                    </div>
                </div>
            </div>

            <!-- Card 02 -->
            <div class="lg:grid lg:grid-cols-2 gap-12 items-center">
                <div>
                    <div class="text-sm font-bold text-orange-accent uppercase tracking-widest mb-3">
                        {copy.home.featureTags[1][0]}
                    </div>
                    <h3 class="text-2xl sm:text-3xl font-black text-slate-text dark:text-white mb-4 tracking-tight">
                        {copy.home.sections[1].title}
                    </h3>
                    <p class="text-lg text-slate-muted leading-relaxed">
                        {copy.home.sections[1].body}
                    </p>
                    <div class="flex flex-wrap gap-2 mt-6">
                        {copy.home.featureTags[1].map((tag: string) => (
                            <span class="px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-xs font-medium text-slate-600 dark:text-slate-300">{tag}</span>
                        ))}
                    </div>
                </div>
                <div class="mt-8 lg:mt-0">
                    <div class="relative rounded-[2.5rem] overflow-hidden shadow-2xl">
                        <Image 
                            src={iphoneSynthom} 
                            alt="Symptom Tracking" 
                            class="w-full h-auto"
                        />
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

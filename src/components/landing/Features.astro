---
import { Image } from "astro:assets";
import { type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import { 
    Activity, 
    Pill, 
    Calendar, 
    Smartphone, 
    ShieldCheck, 
    Stethoscope
} from "lucide-react";

// New feature mockups
import iphoneMeds from "../../assets/images/devices/iphone_meds.png";
import iphoneSynthom from "../../assets/images/devices/iphone_synthom.png";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);

// Generic icon getter based on index for simplicity across 15 languages
const icons = [Pill, Activity, Calendar, Smartphone];
const getIcon = (index: number) => icons[index % icons.length] || ShieldCheck;

const iconColors = [
    "text-teal-primary bg-teal-primary/10 border-teal-primary/20",
    "text-orange-accent bg-orange-accent/10 border-orange-accent/20",
    "text-indigo-500 bg-indigo-500/10 border-indigo-500/20",
    "text-emerald-500 bg-emerald-500/10 border-emerald-500/20",
];
---

<section id="features" class="py-32 sm:py-40 bg-transparent transition-colors duration-[1.2s] relative">
    
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 relative z-10">
        
        <div class="text-center mb-20 max-w-4xl mx-auto">
            <h2 class="text-[11px] font-black uppercase tracking-[0.3em] text-teal-primary mb-6 reveal reveal-scale">
                Features
            </h2>
            <h3 class="text-4xl sm:text-6xl md:text-7xl font-black text-slate-text px-4 reveal stagger-1 leading-[1.05] tracking-tighter">
                {copy.home.featureListTitle}
            </h3>
        </div>

        <!-- Glass Grid (Ritualist Style) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-32">
            {
                copy.home.featureListItems.map((feature, index) => {
                    const Icon = getIcon(index);
                    const colorStyles = iconColors[index % iconColors.length];
                    
                    return (
                        <div class={`reveal reveal-scale stagger-${(index % 4) + 1} group p-8 sm:p-10 premium-card`}>
                            <div class={`w-14 h-14 ${colorStyles} rounded-[1.2rem] flex items-center justify-center mb-8 border transition-transform duration-700 group-hover:scale-110 group-hover:rotate-6 shadow-sm`}>
                                <Icon className="w-6 h-6" />
                            </div>
                            <h4 class="text-xl font-bold text-slate-text mb-2 leading-tight tracking-tight">
                                {feature}
                            </h4>
                        </div>
                    );
                })
            }
        </div>
        
        <!-- Premium Visual Cards -->
        <div class="space-y-16">
            <!-- Card 01: Specialized Tracking -->
            <div class="reveal stagger-1 rounded-[3.5rem] bg-white/40 dark:bg-white/5 p-10 sm:p-16 lg:p-24 border border-white/80 dark:border-white/10 overflow-hidden relative group backdrop-blur-3xl shadow-sm">
                <!-- Ambient Backdrop -->
                <div class="absolute -top-[20%] -right-[10%] w-[60%] h-[120%] bg-gradient-to-br from-teal-primary/10 via-transparent to-transparent blur-[80px] -z-10 rounded-full"></div>
                
                <div class="lg:grid lg:grid-cols-2 gap-16 items-center relative z-10">
                    <div class="order-2 lg:order-1 mt-16 lg:mt-0 flex justify-center lg:justify-start">
                        <div class="relative max-w-[320px] animate-float">
                            <!-- Glow -->
                            <div class="absolute inset-0 bg-teal-primary blur-[80px] opacity-20 -z-10"></div>
                            
                            <div class="p-3 rounded-[3rem] bg-white/30 dark:bg-black/30 backdrop-blur-3xl border border-white/60 dark:border-white/10 shadow-premium">
                                <Image src={iphoneMeds} alt="Medication Tracking" class="rounded-[2.5rem] w-full h-auto" />
                            </div>
                        </div>
                    </div>
                    
                    <div class="order-1 lg:order-2">
                        <div class="inline-flex items-center rounded-full px-5 py-2 text-[10px] font-black uppercase tracking-widest text-teal-primary bg-teal-primary/10 mb-8 border border-teal-primary/20">
                            01. Core Health
                        </div>
                        <h4 class="text-4xl sm:text-6xl font-black text-slate-text mb-8 leading-[1] tracking-tighter">
                            {copy.home.sections[0].title}
                        </h4>
                        <p class="text-xl text-slate-muted leading-relaxed font-medium">
                            {copy.home.sections[0].body}
                        </p>
                    </div>
                </div>
            </div>

            <!-- Card 02: Symptoms & Insights -->
            <div class="reveal stagger-2 rounded-[3.5rem] bg-white/40 dark:bg-white/5 p-10 sm:p-16 lg:p-24 border border-white/80 dark:border-white/10 overflow-hidden relative group backdrop-blur-3xl shadow-sm">
                <!-- Ambient Backdrop -->
                <div class="absolute -bottom-[20%] -left-[10%] w-[60%] h-[120%] bg-gradient-to-tr from-orange-accent/10 via-transparent to-transparent blur-[80px] -z-10 rounded-full"></div>

                 <div class="lg:grid lg:grid-cols-2 gap-16 items-center relative z-10">
                    <div>
                        <div class="inline-flex items-center rounded-full px-5 py-2 text-[10px] font-black uppercase tracking-widest text-orange-accent bg-orange-accent/10 mb-8 border border-orange-accent/20">
                            02. Smart Insights
                        </div>
                        <h4 class="text-4xl sm:text-6xl font-black text-slate-text mb-8 leading-[1] tracking-tighter">
                            {copy.home.sections[1].title}
                        </h4>
                        <p class="text-xl text-slate-muted leading-relaxed font-medium">
                            {copy.home.sections[1].body}
                        </p>
                    </div>

                    <div class="mt-16 lg:mt-0 flex justify-center lg:justify-end">
                        <div class="relative max-w-[320px] animate-float" style="animation-delay: -2s">
                            <!-- Glow -->
                            <div class="absolute inset-0 bg-orange-accent blur-[80px] opacity-20 -z-10"></div>
                            
                            <div class="p-3 rounded-[3rem] bg-white/30 dark:bg-black/30 backdrop-blur-3xl border border-white/60 dark:border-white/10 shadow-premium">
                                <Image src={iphoneSynthom} alt="Symptom Tracking" class="rounded-[2.5rem] w-full h-auto" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>


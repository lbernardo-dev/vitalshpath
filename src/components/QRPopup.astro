---
import { QrCode, X, Smartphone, Info } from "lucide-react";
import { type Lang } from "../i18n/ui-locales";
import { useTranslations } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div id="qr-popup" class="fixed inset-0 z-[100] hidden">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" id="qr-overlay"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[90%] max-w-md">
        <div class="liquid-glass p-8 rounded-[2.5rem] shadow-2xl relative overflow-hidden group">
            <!-- Background Glow -->
            <div class="absolute -top-24 -right-24 w-48 h-48 bg-blue-500/20 rounded-full blur-3xl group-hover:bg-blue-500/30 transition-colors"></div>
            
            <button id="close-qr" class="absolute top-6 right-6 p-2 rounded-full hover:bg-gray-100 dark:hover:bg-white/10 transition-colors">
                <X className="w-5 h-5 text-gray-500" />
            </button>

            <div class="flex flex-col items-center text-center">
                <div class="w-16 h-16 rounded-2xl bg-blue-600 flex items-center justify-center mb-6 shadow-xl shadow-blue-500/40">
                    <QrCode className="w-8 h-8 text-white" />
                </div>

                <h3 class="text-2xl font-black text-gray-900 dark:text-white mb-3">
                    {t("nav.testflight")}
                </h3>
                
                <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed mb-8">
                    {t("testflight.subtitle")}
                </p>

                <div class="bg-white p-4 rounded-3xl shadow-inner mb-8 group-hover:scale-105 transition-transform">
                    <!-- QR Placeholder - In real usage you'd generate a real QR or use an image -->
                    <div class="w-48 h-48 bg-gray-50 flex items-center justify-center border-2 border-dashed border-gray-200 rounded-2xl">
                        <img 
                            src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=https://testflight.apple.com/join/92qmBYvJ" 
                            alt="QR Code to join TestFlight"
                            class="w-full h-full"
                        />
                    </div>
                </div>

                <div class="flex flex-col items-center gap-3 w-full">
                    <a 
                        href="https://testflight.apple.com/join/92qmBYvJ" 
                        class="w-full py-4 bg-blue-600 text-white font-black rounded-2xl shadow-lg hover:opacity-90 transition-opacity"
                    >
                        {t("testflight.cta.button")}
                    </a>
                    
                    <p class="text-[10px] text-gray-400 uppercase font-black tracking-widest flex items-center gap-2">
                        <Smartphone className="w-3 h-3" />
                        {t("testflight.cta.description")}
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const popup = document.getElementById('qr-popup');
    const closeBtn = document.getElementById('close-qr');
    const overlay = document.getElementById('qr-overlay');

    function openPopup() {
        if (popup) {
            popup.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }
    }

    function closePopup() {
        if (popup) {
            popup.classList.add('hidden');
            document.body.style.overflow = '';
        }
    }

    closeBtn?.addEventListener('click', closePopup);
    overlay?.addEventListener('click', closePopup);

    // Expose to window for global access
    (window as any).openQRPopup = openPopup;
</script>

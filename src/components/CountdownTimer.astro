---
import { Timer, Zap } from "lucide-react";
import { type Lang } from "../i18n/ui-locales";
import { useTranslations } from "../i18n";

interface Props {
    lang: Lang;
    endDate: string; // ISO format
}

const { lang, endDate } = Astro.props;
const t = useTranslations(lang);
---

<div id="beta-countdown" class="hidden">
    <div class="inline-flex items-center gap-4 px-6 py-3 rounded-2xl bg-gradient-to-r from-orange-500/10 via-red-500/10 to-orange-500/10 border border-orange-500/20 backdrop-blur-md shadow-xl">
        <div class="flex items-center gap-2 pr-4 border-r border-orange-500/20">
            <div class="relative">
                <Timer className="w-5 h-5 text-orange-500 animate-pulse" />
                <div class="absolute inset-0 bg-orange-500/20 blur-sm rounded-full animate-ping"></div>
            </div>
            <span class="text-xs font-black uppercase tracking-widest text-orange-500">Beta</span>
        </div>
        
        <div class="flex items-center gap-4">
            <div class="flex flex-col items-center">
                <span id="days" class="text-xl font-black text-gray-900 dark:text-white leading-none">00</span>
                <span class="text-[9px] uppercase font-bold text-gray-400">Días</span>
            </div>
            <div class="text-gray-300 dark:text-gray-600 font-bold mb-4">:</div>
            <div class="flex flex-col items-center">
                <span id="hours" class="text-xl font-black text-gray-900 dark:text-white leading-none">00</span>
                <span class="text-[9px] uppercase font-bold text-gray-400">Horas</span>
            </div>
            <div class="text-gray-300 dark:text-gray-600 font-bold mb-4">:</div>
            <div class="flex flex-col items-center">
                <span id="minutes" class="text-xl font-black text-gray-900 dark:text-white leading-none">00</span>
                <span class="text-[9px] uppercase font-bold text-gray-400">Min</span>
            </div>
        </div>

        <div class="ml-2 pl-4 border-l border-orange-500/20 flex flex-col justify-center">
            <p class="text-[10px] font-black text-gray-500 dark:text-gray-400 uppercase tracking-tighter">Fin de Beta pública</p>
            <p class="text-xs font-bold text-orange-600 dark:text-orange-400">31 de Marzo</p>
        </div>
    </div>
</div>

<script define:vars={{ endDate }}>
    function updateCountdown() {
        const target = new Date(endDate).getTime();
        const now = new Date().getTime();
        const diff = target - now;

        const container = document.getElementById('beta-countdown');
        if (diff <= 0) {
            if (container) container.classList.add('hidden');
            return;
        }

        if (container) container.classList.remove('hidden');

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));

        const daysEl = document.getElementById('days');
        const hoursEl = document.getElementById('hours');
        const minsEl = document.getElementById('minutes');

        if (daysEl) daysEl.textContent = days.toString().padStart(2, '0');
        if (hoursEl) hoursEl.textContent = hours.toString().padStart(2, '0');
        if (minsEl) minsEl.textContent = minutes.toString().padStart(2, '0');
    }

    updateCountdown();
    setInterval(updateCountdown, 60000);
</script>

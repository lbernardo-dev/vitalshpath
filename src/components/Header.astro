---
import { Image } from "astro:assets";
import { Menu, X, Rocket } from "lucide-react";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSelector from "./LanguageSelector.astro";
import appIcon from "../assets/images/AppIcon_v2.png";
import { type Lang } from "../i18n/ui-locales";
import { useTranslations } from "../i18n";

interface Props {
    lang: Lang;
    isLanding?: boolean;
}

const { lang, isLanding = false } = Astro.props;
const t = useTranslations(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header role="banner" class="fixed top-0 left-0 right-0 z-50 bg-white/80 dark:bg-gray-900/80 backdrop-blur-xl border-b border-gray-200 dark:border-gray-800 transition-all duration-300">
    <nav
        class="pt-safe"
        aria-label="Main navigation"
    >
        <div class="container mx-auto px-4 md:px-6 py-2.5 md:py-4">
            <div class="flex items-center justify-between h-11 md:h-12">
                <a
                    href={`${baseUrl}/${lang}/`}
                    class="flex items-center gap-2 flex-shrink-0"
                >
                    <Image
                        src={appIcon}
                        alt=""
                        class="w-7 h-7 md:w-8 md:h-8 rounded-xl shadow-sm"
                        width={32}
                        height={32}
                        aria-hidden="true"
                    />
                    <span
                        class="text-base md:text-lg font-bold text-gray-900 dark:text-white hidden sm:block"
                        >VitalsPath</span
                    >
                </a>

                <div class="hidden md:flex items-center gap-8">
                    {
                        isLanding ? (
                            <>
                                <a
                                    href="#features"
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.features")}
                                </a>
                                <a
                                    href="#smart-scheduler"
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.scheduler")}
                                </a>
                                <a
                                    href="#gallery"
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.ecosystem")}
                                </a>
                                <a
                                    href="#benefits"
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.benefits")}
                                </a>
                                <a
                                    href="#pricing"
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.pricing")}
                                </a>
                            </>
                        ) : (
                            <>
                                <a
                                    href={`${baseUrl}/${lang}/#features`}
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.features")}
                                </a>
                                <a
                                    href={`${baseUrl}/${lang}/#smart-scheduler`}
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.scheduler")}
                                </a>
                                <a
                                    href={`${baseUrl}/${lang}/#gallery`}
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.ecosystem")}
                                </a>
                                <a
                                    href={`${baseUrl}/${lang}/#benefits`}
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.benefits")}
                                </a>
                                <a
                                    href={`${baseUrl}/${lang}/#pricing`}
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.pricing")}
                                </a>
                            </>
                        )
                    }
                </div>

                <div class="flex items-center gap-2 md:gap-3 flex-shrink-0">
                    <div class="flex-shrink-0">
                        <LanguageSelector lang={lang} />
                    </div>
                    <div class="hidden sm:flex flex-shrink-0">
                        <ThemeToggle />
                    </div>
                    
                    <a
                        id="header-testflight-btn"
                        href="https://testflight.apple.com/join/92qmBYvJ"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex-shrink-0 px-2.5 py-2 md:px-5 md:py-2.5 bg-blue-600 text-white text-xs md:text-sm font-bold rounded-xl hover:opacity-90 transition-all flex items-center justify-center shadow-lg shadow-blue-500/20"
                        aria-label={t("nav.testflight")}
                    >
                        <span class="sm:hidden flex items-center gap-1.5">
                            <Rocket className="w-4 h-4" />
                            <span class="sr-only">Join</span>
                        </span>
                        <span class="hidden sm:inline">{t("nav.testflight")}</span
                        >
                    </a>

                    <!-- Mobile Menu Button -->
                    <button
                        id="mobile-menu-btn"
                        class="md:hidden flex-shrink-0 p-2 rounded-xl bg-gray-100 dark:bg-white/10 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white transition-colors relative"
                        aria-label="Toggle menu"
                    >
                        <div id="menu-icon" class="block pointer-events-none"><Menu className="w-5 h-5" /></div>
                        <div id="close-icon" class="hidden pointer-events-none"><X className="w-5 h-5" /></div>
                    </button>

                    <script>
                        import { trackEvent } from "../lib/supabase/tracking";

                        function setupMobileMenu() {
                            const mobileBtn = document.getElementById("mobile-menu-btn");
                            const mobileMenu = document.getElementById("mobile-menu");
                            const menuIcon = document.getElementById("menu-icon");
                            const closeIcon = document.getElementById("close-icon");
                            const btn = document.getElementById("header-testflight-btn");

                            // Track event listener
                            btn?.addEventListener("click", () => {
                                trackEvent("testflight_click", { source: "header_nav" });
                            });

                            if (!mobileBtn || !mobileMenu) return;

                            const toggleMenu = (show: boolean) => {
                                if (show) {
                                    mobileMenu.classList.remove("hidden");
                                    // Small delay for transition if needed
                                    requestAnimationFrame(() => {
                                        mobileMenu.classList.add("opacity-100");
                                        menuIcon?.classList.add("hidden");
                                        menuIcon?.classList.remove("block");
                                        closeIcon?.classList.remove("hidden");
                                        closeIcon?.classList.add("block");
                                    });
                                    document.body.style.overflow = "hidden";
                                } else {
                                    mobileMenu.classList.add("hidden");
                                    mobileMenu.classList.remove("opacity-100");
                                    menuIcon?.classList.remove("hidden");
                                    menuIcon?.classList.add("block");
                                    closeIcon?.classList.add("hidden");
                                    closeIcon?.classList.remove("block");
                                    document.body.style.overflow = "";
                                }
                            };

                            mobileBtn.addEventListener("click", (e) => {
                                e.stopPropagation();
                                const isHidden = mobileMenu.classList.contains("hidden");
                                toggleMenu(isHidden);
                            });

                            // Close menu on link click
                            const mobileLinks = mobileMenu.querySelectorAll("a");
                            mobileLinks.forEach(link => {
                                link.addEventListener("click", () => toggleMenu(false));
                            });

                            // Close on escape
                            document.addEventListener("keydown", (e) => {
                                if (e.key === "Escape") toggleMenu(false);
                            });
                        }

                        // Initial setup
                        setupMobileMenu();

                        // Re-setup on Astro page load
                        document.addEventListener("astro:page-load", setupMobileMenu);
                    </script>
                </div>
            </div>
        </div>

        <!-- Mobile Menu Drawer -->
        <div id="mobile-menu" class="hidden md:hidden fixed inset-0 top-[calc(60px+env(safe-area-inset-top))] transition-all duration-300 z-40">
            <div class="absolute inset-0 bg-white/95 dark:bg-gray-900/95 backdrop-blur-xl p-6 flex flex-col gap-6 overflow-y-auto pb-safe">
                <nav class="flex flex-col gap-6">
                    {
                        isLanding ? (
                            <>
                                <a href="#features" class="text-xl font-bold text-gray-900 dark:text-white">{t("nav.features")}</a>
                                <a href="#smart-scheduler" class="text-xl font-bold text-gray-900 dark:text-white">{t("nav.scheduler")}</a>
                                <a href="#gallery" class="text-xl font-bold text-gray-900 dark:text-white">{t("nav.ecosystem")}</a>
                                <a href="#benefits" class="text-xl font-bold text-gray-900 dark:text-white">{t("nav.benefits")}</a>
                                <a href="#pricing" class="text-xl font-bold text-gray-900 dark:text-white">{t("nav.pricing")}</a>
                            </>
                        ) : (
                            <>
                                <a href={`${baseUrl}/${lang}/#features`} class="text-xl font-bold text-gray-900 dark:text-white">{t("nav.features")}</a>
                                <a href={`${baseUrl}/${lang}/#smart-scheduler`} class="text-xl font-bold text-gray-900 dark:text-white">{t("nav.scheduler")}</a>
                                <a href={`${baseUrl}/${lang}/#gallery`} class="text-xl font-bold text-gray-900 dark:text-white">{t("nav.ecosystem")}</a>
                                <a href={`${baseUrl}/${lang}/#benefits`} class="text-xl font-bold text-gray-900 dark:text-white">{t("nav.benefits")}</a>
                                <a href={`${baseUrl}/${lang}/#pricing`} class="text-xl font-bold text-gray-900 dark:text-white">{t("nav.pricing")}</a>
                            </>
                        )
                    }
                </nav>
                
                <div class="pt-8 border-t border-gray-200 dark:border-gray-800 flex flex-col gap-6">
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-gray-900 dark:text-white">Idioma</span>
                        <LanguageSelector lang={lang} />
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="font-bold text-gray-900 dark:text-white">Tema</span>
                        <ThemeToggle />
                    </div>
                </div>

                <div class="mt-auto pt-8">
                    <a
                        href="https://testflight.apple.com/join/92qmBYvJ"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-full py-4 bg-blue-600 text-white font-black rounded-2xl shadow-lg flex items-center justify-center gap-3"
                    >
                        <Rocket className="w-5 h-5" />
                        {t("nav.testflight")}
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>

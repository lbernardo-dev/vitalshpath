---
import { Image } from "astro:assets";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSelector from "./LanguageSelector.astro";
import appIcon from "../assets/images/AppIcon_v2.png";
import { type Lang } from "../i18n/ui-locales";
import { getSiteCopy } from "../content/site-copy";
import { 
    getAppStoreUrlForLang, 
    getDefaultAppStoreLinks 
} from "../lib/app-store-links";
import AppStoreBadge from "./common/AppStoreBadge.astro";
import { Menu, X, Globe, ChevronRight } from "lucide-react";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());

const navItems = [
    { href: `${baseUrl}/${lang}/`, label: copy.nav.home },
    {
        href: `${baseUrl}/${lang}/release-features/`,
        label: copy.nav.releaseFeatures,
    },
    { href: `${baseUrl}/${lang}/roadmap/`, label: copy.nav.roadmap },
    { href: `${baseUrl}/${lang}/privacy/`, label: copy.nav.privacy },
    { href: `${baseUrl}/${lang}/feedback/`, label: copy.nav.support },
];
---

<header id="main-header" class="glass-header">
    <nav class="mx-auto max-w-7xl px-3 sm:px-6 lg:px-8 py-3">
        <div class="flex items-center justify-between gap-4 sm:gap-8 bg-white/40 dark:bg-white/5 backdrop-blur-3xl px-5 sm:px-8 py-2.5 sm:py-3.5 rounded-full border border-white/80 dark:border-white/5 shadow-premium transition-all duration-500">
            <!-- Logo Section -->
            <a
                href={`${baseUrl}/${lang}/`}
                class="flex items-center gap-3 group transition-all duration-500"
            >
                <div class="relative">
                    <img
                        src={appIcon.src}
                        alt="VitalsPath Icon"
                        width="32"
                        height="32"
                        class="h-8 w-8 rounded-[0.8rem] shadow-sm relative z-10 transition-transform group-hover:scale-110 mockup-clean-blend"
                    />
                </div>
                <span class="hidden sm:block text-[13px] font-black tracking-[0.15em] text-slate-text uppercase">
                    VITALSPATH
                </span>
            </a>

            <!-- Desktop Nav Section -->
            <nav class="hidden md:flex items-center gap-4 p-1.5 rounded-2xl glass-panel-dark border-white/20">
                <div class="flex items-center px-2 border-r border-white/10 mr-2">
                    {navItems.map((item) => (
                        <a
                            href={item.href}
                            class="px-3 py-2 text-[12px] font-bold text-slate-text/70 dark:text-white/70 hover:text-slate-text dark:hover:text-white hover:bg-white/10 rounded-xl transition-all duration-300"
                        >
                            {item.label}
                        </a>
                    ))}
                </div>

                <div class="flex items-center gap-3 pr-2">
                    <LanguageSelector lang={lang} />
                    <ThemeToggle />
                </div>
                
                <a
                    href={appStoreHref}
                    class="hover:scale-105 transition-all duration-300 active:scale-95 rounded-xl overflow-hidden shadow-lg shadow-teal-primary/5 shrink-0"
                    aria-label="Download on the App Store"
                >
                    <AppStoreBadge className="h-[36px]" lang={lang} />
                </a>
            </nav>

        <div
            id="mobile-menu-overlay"
            class="fixed inset-0 z-[200] translate-x-full invisible pointer-events-none transition-all duration-500 ease-premium bg-white/95 dark:bg-[#1A1A1A]/98 backdrop-blur-2xl md:hidden overflow-hidden"
        >
            <div class="flex flex-col h-full relative p-8">
                <!-- Close Button inside overlay -->
                <div class="flex justify-end p-2 pb-6">
                    <button
                        id="close-menu-button"
                        class="p-4 rounded-2xl bg-slate-text/5 text-slate-text dark:text-white active:scale-90 transition-transform"
                        aria-label="Close menu"
                    >
                        <X className="h-8 w-8" />
                    </button>
                </div>

                <nav class="flex flex-col gap-5 flex-1 justify-center items-center text-center">
                    {navItems.map((item, index) => (
                        <a
                            href={item.href}
                            class="text-4xl font-black text-slate-text dark:text-white hover:text-teal-vibrant transition-all tracking-tighter uppercase active:scale-95 reveal-fade"
                        >
                            {item.label}
                        </a>
                    ))}
                    
                    <div class="mt-4 pt-4 border-t border-slate-text/10 flex flex-col items-center gap-6 w-full max-w-xs">
                        <div class="flex items-center gap-4 bg-slate-text/5 p-4 rounded-2xl w-full justify-between">
                            <span class="text-xs font-bold text-slate-text/40 dark:text-white/40 uppercase tracking-widest">{lang === 'es' ? 'IDIOMA' : (lang === 'en' ? 'LANGUAGE' : 'LANGUE')}</span>
                            <LanguageSelector lang={lang} />
                        </div>
                        
                        <a
                            href={appStoreHref}
                            class="hover:scale-105 transition-all duration-300 active:scale-95 shadow-2xl shadow-teal-vibrant/10 rounded-2xl overflow-hidden"
                            aria-label="Download on the App Store"
                        >
                            <AppStoreBadge className="h-[55px]" lang={lang} />
                        </a>
                    </div>
                </nav>
            </div>
        </div>

        <div class="flex items-center gap-3 md:hidden">
            <ThemeToggle />
            <button
                id="mobile-menu-button"
                type="button"
                class="flex items-center justify-center p-2.5 rounded-xl bg-slate-text/5 text-slate-text dark:text-white"
                aria-label="Toggle navigation"
            >
                <Menu className="h-6 w-6" />
            </button>
        </div>
    </nav>
</header>

<script>
    function setupMobileMenu() {
        const mobileMenu = document.getElementById("mobile-menu-overlay");
        const mobileMenuButton = document.getElementById("mobile-menu-button");
        const closeMenuButton = document.getElementById("close-menu-button");
        
        if (!mobileMenu || !mobileMenuButton || !closeMenuButton) return;

        const mobileLinks = mobileMenu.querySelectorAll("a");

        function openMenu() {
            if (!mobileMenu) return;
            mobileMenu.classList.remove("translate-x-full", "invisible", "pointer-events-none");
            mobileMenu.classList.add("translate-x-0");
            document.body.style.overflow = "hidden";
            
            // Stagger reveal links
            mobileLinks.forEach((link, index) => {
                setTimeout(() => {
                    link.classList.add("is-visible");
                }, 100 + index * 40);
            });
        }

        function closeMenu() {
            if (!mobileMenu) return;
            mobileMenu.classList.add("translate-x-full", "invisible", "pointer-events-none");
            mobileMenu.classList.remove("translate-x-0");
            document.body.style.overflow = "";
            
            // Hide links
            mobileLinks.forEach((link) => {
                link.classList.remove("is-visible");
            });
        }

        mobileMenuButton.addEventListener("click", openMenu);
        closeMenuButton.addEventListener("click", closeMenu);

        mobileLinks.forEach((link) => {
            link.addEventListener("click", closeMenu);
        });
        
        // Failsafe: if menu is open but window is resized to desktop, close it
        window.addEventListener('resize', () => {
            if (window.innerWidth >= 768 && !mobileMenu.classList.contains("translate-x-full")) {
                closeMenu();
            }
        });
    }

    setupMobileMenu();
    document.addEventListener("astro:page-load", setupMobileMenu);
</script>


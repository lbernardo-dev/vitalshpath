---
import { Image } from "astro:assets";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSelector from "./LanguageSelector.astro";
import appIcon from "../assets/images/AppIcon_v2.png";
import { type Lang } from "../i18n/ui-locales";
import { useTranslations } from "../i18n";

interface Props {
    lang: Lang;
    isLanding?: boolean;
}

const { lang, isLanding = false } = Astro.props;
const t = useTranslations(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header role="banner" class="fixed top-0 left-0 right-0 z-50">
    <nav
        class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-xl border-b border-gray-200 dark:border-gray-800"
        aria-label="Main navigation"
    >
        <div class="container mx-auto px-4 md:px-6 py-3 md:py-4">
            <div class="flex items-center justify-between">
                <a
                    href={`${baseUrl}/${lang}/`}
                    class="flex items-center gap-2 flex-shrink-0"
                >
                    <Image
                        src={appIcon}
                        alt=""
                        class="w-8 h-8 rounded-xl"
                        width={32}
                        height={32}
                        aria-hidden="true"
                    />
                    <span
                        class="text-lg font-bold text-gray-900 dark:text-white hidden sm:block"
                        >VitalsPath</span
                    >
                </a>

                <div class="hidden md:flex items-center gap-8">
                    {
                        isLanding ? (
                            <>
                                <a
                                    href="#features"
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.features")}
                                </a>
                                <a
                                    href="#smart-scheduler"
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.scheduler")}
                                </a>
                                <a
                                    href="#gallery"
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.ecosystem")}
                                </a>
                                <a
                                    href="#benefits"
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.benefits")}
                                </a>
                                <a
                                    href="#pricing"
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.pricing")}
                                </a>
                            </>
                        ) : (
                            <>
                                <a
                                    href={`${baseUrl}/${lang}/#features`}
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.features")}
                                </a>
                                <a
                                    href={`${baseUrl}/${lang}/#smart-scheduler`}
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.scheduler")}
                                </a>
                                <a
                                    href={`${baseUrl}/${lang}/#gallery`}
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.ecosystem")}
                                </a>
                                <a
                                    href={`${baseUrl}/${lang}/#benefits`}
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.benefits")}
                                </a>
                                <a
                                    href={`${baseUrl}/${lang}/#pricing`}
                                    class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
                                >
                                    {t("nav.pricing")}
                                </a>
                            </>
                        )
                    }
                </div>

                <div class="flex items-center gap-2 md:gap-3">
                    <LanguageSelector lang={lang} />
                    <ThemeToggle />
                    <a
                        href="https://testflight.apple.com/join/92qmBYvJ"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-3 py-2 md:px-5 md:py-2.5 bg-blue-600 text-white text-sm font-bold rounded-xl hover:opacity-90 transition-all flex items-center justify-center shadow-lg shadow-blue-500/20"
                        aria-label={t("nav.testflight")}
                    >
                        <span class="sm:hidden">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="lucide lucide-rocket"
                            >
                                <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.71.71-2.5.71-2.5s-1.79 0-2.71-.5z"></path>
                                <path d="M8 12.5c0 4 2.5 6 2.5 6l3.5-2c1.5-3 3.5-1.5 3.5-1.5s4.5-3.5 1-13c-9.5-3.5-13 1-13 1s-1.5 2 1.5 3.5l-2 3.5-3 1.5c-4 0-6 2.5-6 2.5l2 3.5"></path>
                                <path d="M12 10.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z"></path>
                            </svg>
                        </span>
                        <span class="hidden sm:inline">{t("nav.testflight")}</span
                        >
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>

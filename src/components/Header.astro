---
import { Image } from "astro:assets";
import { Menu, X } from "lucide-react";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSelector from "./LanguageSelector.astro";
import appIcon from "../assets/images/AppIcon_v2.png";
import { type Lang } from "../i18n/ui-locales";
import { getSiteCopy } from "../content/site-copy";
import {
    getDefaultAppStoreLinks,
    getAppStoreUrlForLang,
} from "../lib/app-store-links";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());

const navItems = [
    { href: `${baseUrl}/${lang}/`, label: copy.nav.home },
    {
        href: `${baseUrl}/${lang}/release-features/`,
        label: copy.nav.releaseFeatures,
    },
    { href: `${baseUrl}/${lang}/roadmap/`, label: copy.nav.roadmap },
    { href: `${baseUrl}/${lang}/privacy/`, label: copy.nav.privacy },
    { href: `${baseUrl}/${lang}/feedback/`, label: copy.nav.support },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-slate-200/80 bg-white/88 backdrop-blur-xl dark:border-white/10 dark:bg-slate-950/88">
    <nav class="pt-safe" aria-label="Main navigation">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
            <a
                href={`${baseUrl}/${lang}/`}
                class="flex items-center gap-3 text-slate-950 dark:text-white"
            >
                <Image
                    src={appIcon}
                    alt=""
                    width={36}
                    height={36}
                    class="h-9 w-9 rounded-2xl shadow-sm"
                    aria-hidden="true"
                />
                <div class="hidden sm:block">
                    <p class="text-sm font-black tracking-[0.22em] text-sky-600">
                        VITALSPATH
                    </p>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        {copy.common.medicalDisclaimer}
                    </p>
                </div>
            </a>

            <div class="hidden items-center gap-6 lg:flex">
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            class="text-sm font-semibold text-slate-600 transition-colors hover:text-slate-950 dark:text-slate-300 dark:hover:text-white"
                        >
                            {item.label}
                        </a>
                    ))
                }
            </div>

            <div class="flex items-center gap-2 sm:gap-3">
                <LanguageSelector lang={lang} />
                <div class="hidden sm:flex">
                    <ThemeToggle />
                </div>
                <a
                    href={appStoreHref}
                    data-app-store-link
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hidden rounded-2xl bg-sky-600 px-4 py-2.5 text-sm font-black text-white shadow-[0_16px_40px_-18px_rgba(2,132,199,0.9)] transition-all hover:bg-sky-700 sm:inline-flex"
                >
                    {copy.home.primaryCta}
                </a>
                <button
                    id="mobile-menu-button"
                    type="button"
                    class="inline-flex rounded-2xl bg-slate-100 p-2.5 text-slate-700 dark:bg-white/10 dark:text-slate-200 lg:hidden"
                    aria-label="Toggle navigation"
                    aria-expanded="false"
                >
                    <Menu className="h-5 w-5" />
                </button>
            </div>
        </div>

        <div
            id="mobile-menu"
            class="hidden border-t border-slate-200/80 bg-white/96 px-4 py-5 dark:border-white/10 dark:bg-slate-950/96 lg:hidden"
        >
            <div class="flex flex-col gap-4">
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            class="rounded-2xl px-3 py-2 text-base font-semibold text-slate-700 transition-colors hover:bg-slate-100 hover:text-slate-950 dark:text-slate-200 dark:hover:bg-white/5 dark:hover:text-white"
                        >
                            {item.label}
                        </a>
                    ))
                }
                <a
                    href={appStoreHref}
                    data-app-store-link
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-2 inline-flex items-center justify-center rounded-2xl bg-sky-600 px-4 py-3 text-center text-sm font-black text-white shadow-[0_16px_40px_-18px_rgba(2,132,199,0.9)] transition-all hover:bg-sky-700"
                >
                    {copy.home.primaryCta}
                </a>
            </div>
        </div>
    </nav>
</header>

<script>
    function setupHeader() {
        const button = document.getElementById("mobile-menu-button");
        const menu = document.getElementById("mobile-menu");

        if (!button || !menu) return;

        const closeMenu = () => {
            menu.classList.add("hidden");
            button.setAttribute("aria-expanded", "false");
            const icon = button.querySelector("svg");
            if (icon) {
                icon.remove();
            }
            const replacement = document.createElement("span");
            replacement.innerHTML =
                '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>';
            button.appendChild(replacement.firstChild);
        };

        const openMenu = () => {
            menu.classList.remove("hidden");
            button.setAttribute("aria-expanded", "true");
            const icon = button.querySelector("svg");
            if (icon) {
                icon.remove();
            }
            const replacement = document.createElement("span");
            replacement.innerHTML =
                '<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>';
            button.appendChild(replacement.firstChild);
        };

        closeMenu();

        button.onclick = () => {
            const isHidden = menu.classList.contains("hidden");
            if (isHidden) openMenu();
            else closeMenu();
        };

        menu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", closeMenu);
        });
    }

    setupHeader();
    document.addEventListener("astro:page-load", setupHeader);
</script>

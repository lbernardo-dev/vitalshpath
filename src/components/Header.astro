---
import { Image } from "astro:assets";
import { Menu } from "lucide-react";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSelector from "./LanguageSelector.astro";
import appIcon from "../assets/images/AppIcon_v2.png";
import { type Lang } from "../i18n/ui-locales";
import { getSiteCopy } from "../content/site-copy";
import {
    getDefaultAppStoreLinks,
    getAppStoreUrlForLang,
} from "../lib/app-store-links";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());

const navItems = [
    { href: `${baseUrl}/${lang}/`, label: copy.nav.home },
    {
        href: `${baseUrl}/${lang}/release-features/`,
        label: copy.nav.releaseFeatures,
    },
    { href: `${baseUrl}/${lang}/roadmap/`, label: copy.nav.roadmap },
    { href: `${baseUrl}/${lang}/privacy/`, label: copy.nav.privacy },
    { href: `${baseUrl}/${lang}/feedback/`, label: copy.nav.support },
];
---

<header id="main-header" class="glass-header">
    <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-3">
        <div class="flex items-center justify-between gap-8 bg-white/40 dark:bg-white/5 backdrop-blur-3xl px-6 lg:px-8 py-2.5 rounded-full border border-white/80 dark:border-white/10 shadow-sm transition-all">
            <!-- Logo Section -->
            <a
                href={`${baseUrl}/${lang}/`}
                class="flex items-center gap-3 group transition-all duration-500"
            >
                <div class="relative">
                    <Image
                        src={appIcon}
                        alt="VitalsPath Icon"
                        width={32}
                        height={32}
                        class="h-8 w-8 rounded-[0.8rem] shadow-sm relative z-10 transition-transform group-hover:scale-110"
                    />
                </div>
                <span class="hidden sm:block text-[11px] font-black tracking-[0.2em] text-slate-text uppercase">
                    VITALSPATH
                </span>
            </a>

            <!-- Desktop Nav -->
            <div class="hidden lg:flex items-center">
                <div class="flex items-center gap-6">
                    {
                        navItems.map((item) => (
                            <a
                                href={item.href}
                                class="text-[11px] font-bold uppercase tracking-widest text-slate-text/70 transition-all hover:text-teal-primary dark:hover:text-teal-400"
                            >
                                {item.label}
                            </a>
                        ))
                    }
                </div>
            </div>

            <!-- Actions Section -->
            <div class="flex items-center gap-3">
                <div class="hidden sm:flex items-center gap-2">
                    <LanguageSelector lang={lang} />
                    <ThemeToggle />
                </div>
                
                <a
                    href={appStoreHref}
                    data-app-store-link
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hidden sm:flex items-center justify-center rounded-full bg-slate-text dark:bg-white px-5 py-2.5 text-[10px] font-black uppercase tracking-widest text-white dark:text-black transition-all hover:scale-[1.05]"
                >
                    {copy.home.primaryCta}
                </a>

                <button
                    id="mobile-menu-button"
                    type="button"
                    class="lg:hidden flex items-center justify-center p-2 text-slate-text"
                    aria-label="Toggle navigation"
                >
                    <Menu className="h-5 w-5" />
                </button>
            </div>
        </div>

        <!-- Mobile Menu Overlay -->
        <div
            id="mobile-menu"
            class="hidden fixed inset-0 z-[100] bg-white/60 dark:bg-black/80 backdrop-blur-3xl lg:hidden animate-in fade-in duration-300"
        >
            <div class="flex flex-col h-full p-8 pt-24 space-y-8">
                <button 
                    id="mobile-menu-close"
                    class="absolute top-8 right-8 p-3 rounded-full bg-slate-text/5 text-slate-text"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>

                <div class="flex flex-col gap-8">
                    {
                        navItems.map((item) => (
                            <a
                                href={item.href}
                                class="text-3xl font-black uppercase tracking-tighter text-slate-text hover:text-teal-primary transition-colors"
                            >
                                {item.label}
                            </a>
                        ))
                    }
                </div>
                
                <div class="mt-auto space-y-8">
                    <div class="flex items-center justify-between p-4 rounded-2xl bg-slate-text/5">
                        <LanguageSelector lang={lang} />
                        <ThemeToggle />
                    </div>

                    <a
                        href={appStoreHref}
                        data-app-store-link
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-primary w-full flex justify-center py-5 text-sm"
                    >
                        {copy.home.primaryCta}
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>

<script>
    function setupMobileMenu() {
        const button = document.getElementById("mobile-menu-button");
        const closeButton = document.getElementById("mobile-menu-close");
        const menu = document.getElementById("mobile-menu");

        if (!button || !menu) return;

        const toggleMenu = () => {
            const isHidden = menu.classList.contains("hidden");
            if (isHidden) {
                menu.classList.remove("hidden");
                document.body.style.overflow = "hidden"; // Prevent background scroll
                button.setAttribute("aria-expanded", "true");
            } else {
                menu.classList.add("hidden");
                document.body.style.overflow = ""; // Re-enable background scroll
                button.setAttribute("aria-expanded", "false");
            }
        };

        button.onclick = toggleMenu;
        if (closeButton) closeButton.onclick = toggleMenu;

        // Close on escape
        window.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !menu.classList.contains('hidden')) {
                toggleMenu();
            }
        });

        // Close on link click
        const links = menu.querySelectorAll('a');
        links.forEach(link => {
            link.onclick = () => {
                menu.classList.add('hidden');
                document.body.style.overflow = "";
            };
        });
    }

    setupMobileMenu();
    document.addEventListener("astro:page-load", setupMobileMenu);
</script>


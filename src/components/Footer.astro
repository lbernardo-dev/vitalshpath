---
import { Image } from "astro:assets";
import appIcon from "../assets/images/AppIcon_v2.png";
import { type Lang } from "../i18n/ui-locales";
import { getSiteCopy } from "../content/site-copy";
import {
    getDefaultAppStoreLinks,
    getAppStoreUrlForLang,
} from "../lib/app-store-links";
import { appStoreLabels } from "../lib/app-store-labels";
import { supportEmail } from "../lib/site-config";
import { ArrowRight } from "lucide-react";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());
const reviewHref = getDefaultAppStoreLinks().reviewUrl;
---

<footer class="border-t border-slate-200/40 bg-transparent dark:border-white/5 mt-32 reveal transition-colors duration-[1.2s] relative">
    <div class="absolute inset-0 bg-gradient-to-b from-transparent to-cream-light/30 dark:to-slate-950/50 -z-10 pointer-events-none"></div>
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
        <div class="grid gap-12 sm:gap-16 lg:grid-cols-[2fr,1fr,1fr]">
            <div class="space-y-8">
                <div class="flex items-center gap-5">
                    <Image
                        src={appIcon}
                        alt="VitalsPath"
                        width={56}
                        height={56}
                        class="h-14 w-14 rounded-[1.2rem] shadow-premium"
                    />
                    <div class="space-y-1">
                        <p class="text-[11px] font-black tracking-[0.4em] text-teal-primary uppercase">
                            VITALSPATH
                        </p>
                        <p class="text-[13px] font-bold text-slate-muted">
                            {copy.meta.description}
                        </p>
                    </div>
                </div>

                <p class="max-w-xl text-sm font-medium leading-relaxed text-slate-400">
                    {copy.footer.legalNote}
                </p>

                <div class="flex flex-col sm:flex-row gap-4 pt-6">
                    <a
                        href={appStoreHref}
                        data-app-store-link
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-footer-primary"
                    >
                        <span>{copy.home.primaryCta}</span>
                    </a>
                    <a
                        href={reviewHref}
                        data-app-store-review-link
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-footer-secondary"
                    >
                        {appStoreLabels[lang].rate}
                    </a>
                </div>
            </div>

            <div class="space-y-8">
                <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-slate-400 dark:text-slate-500">
                    SITEMAP
                </h2>
                <div class="flex flex-col gap-5 text-sm font-bold text-slate-600 dark:text-slate-400">
                    <a href={`${baseUrl}/${lang}/privacy/`} class="hover:text-teal-primary transition-colors hover:translate-x-1 duration-300 inline-block">{copy.footer.privacy}</a>
                    <a href={`${baseUrl}/${lang}/feedback/`} class="hover:text-teal-primary transition-colors hover:translate-x-1 duration-300 inline-block">{copy.footer.support}</a>
                    <a href={`${baseUrl}/${lang}/release-features/`} class="hover:text-teal-primary transition-colors hover:translate-x-1 duration-300 inline-block">
                        {copy.footer.releaseFeatures}
                    </a>
                    <a href={`${baseUrl}/${lang}/roadmap/`} class="hover:text-teal-primary transition-colors hover:translate-x-1 duration-300 inline-block">{copy.footer.roadmap}</a>
                </div>
            </div>

            <div class="space-y-8">
                <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-slate-400 dark:text-slate-500">
                    LEGAL & CONTACT
                </h2>
                <div class="flex flex-col gap-5 text-sm font-bold text-slate-600 dark:text-slate-400">
                    <a href={`${baseUrl}/${lang}/terms/`} class="hover:text-teal-primary transition-colors hover:translate-x-1 duration-300 inline-block">{copy.footer.terms}</a>
                    <a href={`${baseUrl}/${lang}/disclaimer/`} class="hover:text-teal-primary transition-colors hover:translate-x-1 duration-300 inline-block">
                        {copy.footer.disclaimer}
                    </a>
                    <a href={`${baseUrl}/${lang}/subscription/`} class="hover:text-teal-primary transition-colors hover:translate-x-1 duration-300 inline-block">
                        {copy.footer.subscription}
                    </a>
                    <a href={`mailto:${supportEmail}`} class="hover:text-teal-primary transition-colors hover:translate-x-1 duration-300 inline-block">
                        {supportEmail}
                    </a>
                </div>
            </div>
        </div>
        
        <div class="mt-24 pt-8 border-t border-slate-200/40 dark:border-white/5 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-[11px] font-black tracking-widest text-[#8b919d]">
                &copy; {new Date().getFullYear()} VITALSPATH. {lang === 'es' ? 'TODOS LOS DERECHOS RESERVADOS.' : 'ALL RIGHTS RESERVED.'}
            </p>
        </div>
    </div>
</footer>

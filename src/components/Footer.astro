---
import { Image } from "astro:assets";
import appIcon from "../assets/images/AppIcon_v2.png";
import { type Lang } from "../i18n/ui-locales";
import { getSiteCopy } from "../content/site-copy";
import {
    getDefaultAppStoreLinks,
    getAppStoreUrlForLang,
} from "../lib/app-store-links";
import { appStoreLabels } from "../lib/app-store-labels";
import { supportEmail } from "../lib/site-config";
import { ArrowRight, Star, Heart } from "lucide-react";
import AppStoreBadge from "./common/AppStoreBadge.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());
const reviewHref = getDefaultAppStoreLinks().reviewUrl;
---

<footer class="bg-[#0a0c10] dark:bg-black text-white/90 border-t border-white/5 relative overflow-hidden transition-colors duration-[1.2s]">
    <!-- Subtle Gradient Glow -->
    <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-teal-vibrant/5 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="mx-auto max-w-7xl px-6 py-8 sm:py-12">
        <div class="grid gap-12 lg:grid-cols-[1.5fr,1fr,1fr] xl:grid-cols-[2fr,1fr,1fr]">
            
            <!-- Brand & Info -->
            <div class="space-y-6">
                <div class="flex items-center gap-4">
                    <Image
                        src={appIcon}
                        alt="VitalsPath"
                        width={48}
                        height={48}
                        class="h-12 w-12 rounded-xl shadow-2xl ring-1 ring-white/10"
                    />
                    <div class="space-y-0.5">
                        <p class="text-[10px] font-black tracking-[0.5em] text-teal-vibrant uppercase">
                            VITALSPATH
                        </p>
                        <p class="text-sm font-bold text-slate-400">
                            {copy.meta.description}
                        </p>
                    </div>
                </div>

                <p class="max-w-md text-[13px] font-medium leading-relaxed text-slate-500">
                    {copy.footer.legalNote}
                </p>

                <div class="flex flex-wrap items-center gap-6 pt-2">
                    <a
                        href={appStoreHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:scale-105 active:scale-95 transition-all duration-300 drop-shadow-[0_10px_30px_rgba(45,212,191,0.2)]"
                    >
                        <AppStoreBadge className="h-[44px]" lang={lang} />
                    </a>
                    <a
                        href={reviewHref}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/5 border border-white/10 text-[10px] font-black uppercase tracking-widest hover:bg-white/10 transition-all duration-300"
                    >
                        <Star className="w-3.5 h-3.5 fill-current text-white" />
                        {appStoreLabels[lang].rate}
                    </a>
                </div>
            </div>

            <!-- Links: Sitemap -->
            <div class="space-y-6">
                <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-slate-500">
                    SITEMAP
                </h2>
                <nav class="flex flex-col gap-4 text-xs font-bold text-slate-400">
                    <a href={`${baseUrl}/${lang}/privacy/`} class="hover:text-teal-vibrant transition-colors">{copy.footer.privacy}</a>
                    <a href={`${baseUrl}/${lang}/feedback/`} class="hover:text-teal-vibrant transition-colors">{copy.footer.support}</a>
                    <a href={`${baseUrl}/${lang}/release-features/`} class="hover:text-teal-vibrant transition-colors">{copy.footer.releaseFeatures}</a>
                    <a href={`${baseUrl}/${lang}/roadmap/`} class="hover:text-teal-vibrant transition-colors">{copy.footer.roadmap}</a>
                    <a href={`${baseUrl}/${lang}/timeline/`} class="hover:text-teal-vibrant transition-colors">{copy.footer.timeline || (lang === 'es' ? 'Cronología' : 'Timeline')}</a>
                </nav>
            </div>

            <!-- Links: Legal -->
            <div class="space-y-6">
                <h2 class="text-[10px] font-black uppercase tracking-[0.4em] text-slate-500">
                    LEGAL
                </h2>
                <nav class="flex flex-col gap-4 text-xs font-bold text-slate-400">
                    <a href={`${baseUrl}/${lang}/terms/`} class="hover:text-teal-vibrant transition-colors">{copy.footer.terms}</a>
                    <a href={`${baseUrl}/${lang}/disclaimer/`} class="hover:text-teal-vibrant transition-colors">{copy.footer.disclaimer}</a>
                    <a href={`${baseUrl}/${lang}/subscription/`} class="hover:text-teal-vibrant transition-colors">{copy.footer.subscription}</a>
                    <a href={`mailto:${supportEmail}`} class="hover:text-teal-vibrant transition-colors lowercase">{supportEmail}</a>
                </nav>
            </div>
        </div>
        
        <!-- Bottom Bar -->
        <div class="mt-8 pt-6 border-t border-white/5 flex flex-col sm:flex-row justify-between items-center gap-6">
            <p class="text-[10px] font-black tracking-widest text-slate-600 uppercase">
                &copy; {new Date().getFullYear()} VITALSPATH • MADE WITH PRECISION
            </p>
            
            <div class="flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/5">
                <div class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-[9px] font-black text-slate-400 uppercase tracking-tighter">
                    VitalsPath 2.0.0 • In preparation
                </span>
            </div>
        </div>
    </div>
</footer>

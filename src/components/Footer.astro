---
import { Image } from "astro:assets";
import appIcon from "../assets/images/AppIcon_v2.png";
import { type Lang } from "../i18n/ui-locales";
import { getSiteCopy } from "../content/site-copy";
import {
    getDefaultAppStoreLinks,
    getAppStoreUrlForLang,
} from "../lib/app-store-links";
import { appStoreLabels } from "../lib/app-store-labels";
import { supportEmail } from "../lib/site-config";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());
const reviewHref = getDefaultAppStoreLinks().reviewUrl;
---

<footer class="border-t border-slate-200/80 bg-white dark:border-white/10 dark:bg-slate-950">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
        <div class="grid gap-10 lg:grid-cols-[1.3fr,1fr,1fr]">
            <div class="space-y-5">
                <div class="flex items-center gap-3">
                    <Image
                        src={appIcon}
                        alt="VitalsPath"
                        width={40}
                        height={40}
                        class="h-10 w-10 rounded-2xl"
                    />
                    <div>
                        <p class="text-sm font-black tracking-[0.22em] text-sky-600">
                            VITALSPATH
                        </p>
                        <p class="text-sm text-slate-500 dark:text-slate-400">
                            {copy.meta.description}
                        </p>
                    </div>
                </div>

                <p class="max-w-xl text-sm leading-6 text-slate-600 dark:text-slate-300">
                    {copy.footer.legalNote}
                </p>

                <div class="flex flex-wrap gap-3">
                    <a
                        href={appStoreHref}
                        data-app-store-link
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center rounded-2xl bg-sky-600 px-4 py-2.5 text-sm font-black text-white transition-colors hover:bg-sky-700"
                    >
                        {copy.home.primaryCta}
                    </a>
                    <a
                        href={reviewHref}
                        data-app-store-review-link
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center rounded-2xl border border-slate-200 px-4 py-2.5 text-sm font-bold text-slate-700 transition-colors hover:border-slate-300 hover:text-slate-950 dark:border-white/10 dark:text-slate-200 dark:hover:border-white/20 dark:hover:text-white"
                    >
                        {appStoreLabels[lang].rate}
                    </a>
                </div>
            </div>

            <div class="space-y-4">
                <h2 class="text-sm font-black uppercase tracking-[0.22em] text-slate-400">
                    VitalsPath
                </h2>
                <div class="flex flex-col gap-3 text-sm font-medium text-slate-600 dark:text-slate-300">
                    <a href={`${baseUrl}/${lang}/privacy/`}>{copy.footer.privacy}</a>
                    <a href={`${baseUrl}/${lang}/feedback/`}>{copy.footer.support}</a>
                    <a href={`${baseUrl}/${lang}/release-features/`}>
                        {copy.footer.releaseFeatures}
                    </a>
                    <a href={`${baseUrl}/${lang}/roadmap/`}>{copy.footer.roadmap}</a>
                </div>
            </div>

            <div class="space-y-4">
                <h2 class="text-sm font-black uppercase tracking-[0.22em] text-slate-400">
                    Legal
                </h2>
                <div class="flex flex-col gap-3 text-sm font-medium text-slate-600 dark:text-slate-300">
                    <a href={`${baseUrl}/${lang}/terms/`}>{copy.footer.terms}</a>
                    <a href={`${baseUrl}/${lang}/disclaimer/`}>
                        {copy.footer.disclaimer}
                    </a>
                    <a href={`${baseUrl}/${lang}/subscription/`}>
                        {copy.footer.subscription}
                    </a>
                    <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
                </div>
            </div>
        </div>
    </div>
</footer>

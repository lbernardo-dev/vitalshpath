---
import { Image } from "astro:assets";
import appIcon from "../assets/images/AppIcon_v2.png";
import { type Lang } from "../i18n/ui-locales";
import { getSiteCopy } from "../content/site-copy";
import {
    getDefaultAppStoreLinks,
    getAppStoreUrlForLang,
} from "../lib/app-store-links";
import { appStoreLabels } from "../lib/app-store-labels";
import { supportEmail } from "../lib/site-config";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const copy = getSiteCopy(lang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const appStoreHref = getAppStoreUrlForLang(lang, getDefaultAppStoreLinks());
const reviewHref = getDefaultAppStoreLinks().reviewUrl;
---

<footer class="border-t border-slate-200/50 bg-cream/50 dark:border-white/5 dark:bg-slate-950/80 reveal">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6">
        <div class="grid gap-10 lg:grid-cols-[1.3fr,1fr,1fr]">
            <div class="space-y-5">
                <div class="flex items-center gap-3">
                    <Image
                        src={appIcon}
                        alt="VitalsPath"
                        width={40}
                        height={40}
                        class="h-10 w-10 rounded-2xl"
                    />
                    <div class="space-y-1">
                        <p class="text-sm font-black tracking-[0.25em] text-teal-primary uppercase">
                            VITALSPATH
                        </p>
                        <p class="text-sm font-medium text-slate-500 dark:text-slate-400">
                            {copy.meta.description}
                        </p>
                    </div>
                </div>

                <p class="max-w-xl text-sm leading-6 text-slate-600 dark:text-slate-300">
                    {copy.footer.legalNote}
                </p>

                <div class="flex flex-wrap gap-3">
                    <a
                        href={appStoreHref}
                        data-app-store-link
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center rounded-2xl bg-teal-primary px-5 py-3 text-sm font-black text-white transition-all hover:bg-teal-600 hover:scale-105 active:scale-95 shadow-lg shadow-teal-primary/20"
                    >
                        {copy.home.primaryCta}
                    </a>
                    <a
                        href={reviewHref}
                        data-app-store-review-link
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center rounded-2xl border border-slate-200/50 bg-white/50 px-5 py-3 text-sm font-bold text-slate-700 transition-all hover:border-slate-300 hover:text-teal-primary dark:border-white/10 dark:bg-white/5 dark:text-slate-200 dark:hover:border-white/20 dark:hover:text-white"
                    >
                        {appStoreLabels[lang].rate}
                    </a>
                </div>
            </div>

                <h2 class="text-xs font-black uppercase tracking-[0.25em] text-slate-400 mb-6">
                    Links
                </h2>
                <div class="flex flex-col gap-4 text-sm font-bold text-slate-600 dark:text-slate-300">
                    <a href={`${baseUrl}/${lang}/privacy/`} class="hover:text-teal-primary transition-colors">{copy.footer.privacy}</a>
                    <a href={`${baseUrl}/${lang}/feedback/`} class="hover:text-teal-primary transition-colors">{copy.footer.support}</a>
                    <a href={`${baseUrl}/${lang}/release-features/`} class="hover:text-teal-primary transition-colors">
                        {copy.footer.releaseFeatures}
                    </a>
                    <a href={`${baseUrl}/${lang}/roadmap/`} class="hover:text-teal-primary transition-colors">{copy.footer.roadmap}</a>
                </div>
            </div>

            <div class="space-y-6">
                <h2 class="text-xs font-black uppercase tracking-[0.25em] text-slate-400">
                    Legal
                </h2>
                <div class="flex flex-col gap-4 text-sm font-bold text-slate-600 dark:text-slate-300">
                    <a href={`${baseUrl}/${lang}/terms/`} class="hover:text-teal-primary transition-colors">{copy.footer.terms}</a>
                    <a href={`${baseUrl}/${lang}/disclaimer/`} class="hover:text-teal-primary transition-colors">
                        {copy.footer.disclaimer}
                    </a>
                    <a href={`${baseUrl}/${lang}/subscription/`} class="hover:text-teal-primary transition-colors">
                        {copy.footer.subscription}
                    </a>
                    <a href={`mailto:${supportEmail}`} class="hover:text-teal-primary transition-colors">{supportEmail}</a>
                </div>
            </div>
        </div>
    </div>
</footer>

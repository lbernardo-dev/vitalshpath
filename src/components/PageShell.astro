---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { type Lang } from "../i18n/ui-locales";

interface Props {
    lang: Lang;
    title: string;
    intro: string;
    pageTitle?: string;
    pageDescription?: string;
    badge?: string;
}

const {
    lang,
    title,
    intro,
    pageTitle = `${title} | VitalsPath`,
    pageDescription = intro,
    badge = "VitalsPath",
} = Astro.props;
---

<Layout lang={lang} pageTitle={pageTitle} pageDescription={pageDescription}>
    <main class="min-h-screen bg-white dark:bg-slate-950">
        <Header lang={lang} />

        <section class="relative overflow-hidden pb-20 pt-28 sm:pb-24 sm:pt-32">
            <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,rgba(14,165,233,0.14),transparent_40%),radial-gradient(circle_at_bottom_right,rgba(20,184,166,0.1),transparent_35%)]"></div>
            <div class="mx-auto max-w-5xl px-4 sm:px-6">
                <div class="rounded-[2rem] border border-slate-200/80 bg-white/88 p-6 shadow-[0_30px_100px_-55px_rgba(15,23,42,0.35)] backdrop-blur-xl dark:border-white/10 dark:bg-white/5 sm:p-10">
                    <div class="inline-flex rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-[11px] font-black uppercase tracking-[0.22em] text-sky-700 dark:border-sky-500/20 dark:bg-sky-500/10 dark:text-sky-300">
                        {badge}
                    </div>
                    <h1 class="mt-5 max-w-4xl text-4xl font-black tracking-tight text-slate-950 dark:text-white sm:text-5xl">
                        {title}
                    </h1>
                    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600 dark:text-slate-300">
                        {intro}
                    </p>
                    <div class="mt-10">
                        <slot />
                    </div>
                </div>
            </div>
        </section>

        <Footer lang={lang} />
    </main>
</Layout>

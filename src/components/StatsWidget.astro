---
import { type Lang } from "../i18n/ui-locales";
import { useTranslations } from "../i18n";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div
    id="stats-widget"
    class="mt-4 opacity-0 transition-opacity duration-500 w-full overflow-x-auto"
>
    <div
        class="inline-flex items-center gap-6 p-2 px-4 bg-gray-50 dark:bg-gray-800/40 border border-gray-100 dark:border-gray-800 rounded-2xl whitespace-nowrap"
    >
        <div
            class="flex items-center gap-2 pr-4 border-r border-gray-200 dark:border-gray-700"
        >
            <div class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse">
            </div>
            <span
                class="text-[10px] uppercase tracking-tighter font-black text-gray-400 dark:text-gray-500"
                >Live</span
            >
        </div>

        <div class="flex items-center gap-6">
            <div class="flex items-center gap-1.5">
                <svg
                    class="w-3.5 h-3.5 text-blue-500/70"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    ></path>
                </svg>
                <div class="flex items-center gap-1">
                    <span
                        class="text-[11px] text-gray-500 dark:text-gray-400 font-medium"
                        >Ahora:</span
                    >
                    <span
                        id="stat-online"
                        class="text-xs font-bold text-gray-900 dark:text-white"
                        >0</span
                    >
                </div>
            </div>

            <div class="flex items-center gap-1.5">
                <svg
                    class="w-3.5 h-3.5 text-purple-500/70"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"
                    ></path>
                </svg>
                <div class="flex items-center gap-1">
                    <span
                        class="text-[11px] text-gray-500 dark:text-gray-400 font-medium"
                        >Hoy:</span
                    >
                    <span
                        id="stat-today"
                        class="text-xs font-bold text-gray-900 dark:text-white"
                        >0</span
                    >
                </div>
            </div>

            <div class="flex items-center gap-1.5 pl-4 border-l border-gray-200 dark:border-gray-700">
                <div class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></div>
                <div class="flex items-center gap-1">
                    <span class="text-[11px] text-gray-500 dark:text-gray-400 font-medium">Plazas:</span>
                    <span id="stat-slots" class="text-xs font-bold text-gray-900 dark:text-white">0/8,000</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    import { getStats, trackPageView, updateHeartbeat } from "../lib/supabase/tracking";

    async function updateStats() {
        try {
            const stats = await getStats();

            if (stats) {
                const onlineEl = document.getElementById("stat-online");
                const todayEl = document.getElementById("stat-today");
                const totalVisitorsEl = document.getElementById("stat-total-visitors");
                const slotsEl = document.getElementById("stat-slots");
                const widget = document.getElementById("stats-widget");

                if (onlineEl) onlineEl.textContent = (stats.online_now || 0).toString();
                if (todayEl) todayEl.textContent = (stats.today_visitors || 0).toString();
                if (totalVisitorsEl) totalVisitorsEl.textContent = (stats.total_visitors || 0).toString();
                if (slotsEl && stats.testflight_clicks_total !== undefined) {
                    slotsEl.textContent = `${stats.testflight_clicks_total}/8,000`;
                }

                if (widget) widget.classList.remove("opacity-0");
            }
        } catch (e) {
            console.error("Stats error:", e);
            const widget = document.getElementById("stats-widget");
            if (widget) widget.classList.remove("opacity-0");
        }
    }

    // Initialize tracking and stats
    const page = window.location.pathname;
    const lang = document.documentElement.lang || "es";
    trackPageView(page, lang);
    updateStats();
    
    // Set intervals
    setInterval(() => updateHeartbeat(), 30000);
    setInterval(updateStats, 30000);
</script>

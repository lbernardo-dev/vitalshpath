---
import { languages, supportedLangs, type Lang } from "../i18n/ui-locales";
import { ChevronDown, Globe } from "lucide-react";

interface Props {
    lang: Lang;
}

const { lang: currentLang } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const normalizedPath = Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`;

const translateHref = (lang: Lang) =>
    normalizedPath.replace(
        new RegExp(`^${baseUrl}/${currentLang}(?=/|$)`),
        `${baseUrl}/${lang}`,
    );
---

<div class="relative language-selector inline-flex items-center">
    <button
        type="button"
        class="flex items-center gap-2.5 px-4 py-2.5 rounded-full bg-white/40 dark:bg-white/5 hover:bg-white dark:hover:bg-white/10 transition-all text-[13px] font-bold text-slate-800 dark:text-slate-200 border border-white/80 dark:border-white/10 shadow-sm language-button group lg:w-auto w-full justify-between lg:justify-start"
        aria-label="Select language"
        aria-expanded="false"
        aria-haspopup="true"
    >
        <div class="flex items-center gap-2.5">
            <span class="text-base leading-none translate-y-[1px]" aria-hidden="true">
                {languages[currentLang].flag}
            </span>
            <span class="hidden lg:inline uppercase tracking-widest text-[11px] opacity-80">
                {languages[currentLang].name}
            </span>
            <span class="lg:hidden uppercase tracking-widest text-[11px] opacity-80">
                {languages[currentLang].name}
            </span>
        </div>
        <ChevronDown className="w-3.5 h-3.5 text-slate-400 group-hover:text-teal-vibrant transition-all duration-300 group-aria-expanded:rotate-180" />
    </button>

    <div
        class="absolute right-0 top-full mt-2 w-64 glass-panel bg-white/90 dark:bg-[#1A1A1A]/90 opacity-0 invisible transform -translate-y-2 transition-all duration-300 z-[500] language-dropdown shadow-premium pointer-events-none"
    >
        <div class="p-2 max-h-[70vh] overflow-y-auto custom-scrollbar">
            <div class="px-3 py-2 mb-1">
                <span class="text-[10px] font-black tracking-[0.2em] text-slate-muted uppercase opacity-50">
                    {currentLang === 'es' ? 'Seleccionar Idioma' : 'Select Language'}
                </span>
            </div>
            <div class="grid grid-cols-1 gap-1">
                {
                    supportedLangs.map((lang) => (
                        <a
                            href={translateHref(lang)}
                            class={`flex items-center gap-3 px-4 py-3 rounded-2xl text-[13px] font-bold transition-all duration-300 ${
                                lang === currentLang
                                    ? "bg-teal-vibrant/10 text-teal-vibrant"
                                    : "text-slate-600 dark:text-slate-400 hover:bg-white dark:hover:bg-white/5 hover:text-teal-vibrant"
                            }`}
                        >
                            <span class="text-lg leading-none" aria-hidden="true">
                                {languages[lang].flag}
                            </span>
                            <span class="flex-1">{languages[lang].name}</span>
                            {lang === currentLang && (
                                <div class="w-1.5 h-1.5 rounded-full bg-teal-vibrant shadow-[0_0_12px_rgba(20,184,166,0.8)]"></div>
                            )}
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</div>

<script>
    function initLanguageSelector() {
        const selectors = document.querySelectorAll(".language-selector");
        
        selectors.forEach(selector => {
            const button = selector.querySelector(".language-button") as HTMLButtonElement;
            const dropdown = selector.querySelector(".language-dropdown") as HTMLElement;

            if (!button || !dropdown) return;

            const toggle = (force?: boolean) => {
                const isExpanded = force !== undefined ? !force : button.getAttribute("aria-expanded") === "true";
                
                if (isExpanded) {
                    button.setAttribute("aria-expanded", "false");
                    dropdown.classList.add("opacity-0", "invisible", "-translate-y-4", "pointer-events-none");
                    dropdown.classList.remove("opacity-100", "visible", "translate-y-0", "pointer-events-auto");
                } else {
                    // Close all others
                    document.querySelectorAll(".language-button").forEach(b => {
                        if (b !== button) {
                            b.setAttribute("aria-expanded", "false");
                            const d = b.nextElementSibling;
                            if (d) {
                                d.classList.add("opacity-0", "invisible", "-translate-y-4", "pointer-events-none");
                                d.classList.remove("opacity-100", "visible", "translate-y-0", "pointer-events-auto");
                            }
                        }
                    });

                    button.setAttribute("aria-expanded", "true");
                    dropdown.classList.remove("opacity-0", "invisible", "-translate-y-4", "pointer-events-none");
                    dropdown.classList.add("opacity-100", "visible", "translate-y-0", "pointer-events-auto");
                }
            };

            // Remove old listeners to avoid duplicates on View Transition re-runs
            button.onclick = (e) => {
                e.stopPropagation();
                toggle();
            };
        });

        // Close on click outside
        document.addEventListener("click", (e) => {
            if (!(e.target as HTMLElement).closest(".language-selector")) {
                document.querySelectorAll(".language-button").forEach(button => {
                    button.setAttribute("aria-expanded", "false");
                    const dropdown = button.nextElementSibling;
                    if (dropdown) {
                        dropdown.classList.add("opacity-0", "invisible", "-translate-y-4", "pointer-events-none");
                        dropdown.classList.remove("opacity-100", "visible", "translate-y-0", "pointer-events-auto");
                    }
                });
            }
        });

        // Close on escape key
        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                document.querySelectorAll(".language-button").forEach(button => {
                    if (button.getAttribute("aria-expanded") === "true") {
                        (button as HTMLElement).click();
                    }
                });
            }
        });
    }

    // Initialize
    initLanguageSelector();
    
    // Support Astro View Transitions
    document.addEventListener("astro:page-load", initLanguageSelector);
</script>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        @apply bg-slate-200 dark:bg-white/10 rounded-full;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        @apply bg-teal-vibrant/50;
    }
</style>

---
import { languages, supportedLangs, type Lang } from "../i18n/ui-locales";

interface Props {
    lang: Lang;
}

const { lang: currentLang } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const normalizedPath = Astro.url.pathname.endsWith("/")
    ? Astro.url.pathname
    : `${Astro.url.pathname}/`;
const translateHref = (lang: Lang) =>
    normalizedPath.replace(
        new RegExp(`^${baseUrl}/${currentLang}(?=/|$)`),
        `${baseUrl}/${lang}`,
    );
---

<div class="relative language-selector">
    <button
        type="button"
        class="flex items-center gap-2 px-4 py-2.5 rounded-full bg-slate-100/50 dark:bg-white/5 hover:bg-white dark:hover:bg-white/10 transition-all text-[13px] font-bold text-slate-600 dark:text-slate-300 hover:text-teal-primary border border-slate-200/50 dark:border-white/10 hover:border-teal-primary/20 language-button"
        aria-label="Select language"
        aria-expanded="false"
        aria-haspopup="true"
    >
        <span class="text-base" aria-hidden="true"
            >{languages[currentLang].flag}</span
        >
        <span
            class="hidden lg:inline"
            >{languages[currentLang].name}</span
        >
        <svg
            class="w-3.5 h-3.5 text-slate-400 group-hover:text-teal-primary transition-colors"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M19 9l-7 7-7-7"></path>
        </svg>
    </button>

    <div
        class="absolute right-0 top-full mt-3 w-56 glass-panel !bg-white/95 dark:!bg-[#1A1A1A]/95 !border-white/20 dark:!border-white/10 opacity-0 invisible transform -translate-y-4 transition-all duration-300 z-50 language-dropdown"
    >

        <div class="py-3 px-2 max-h-[32rem] overflow-y-auto">
            {
                supportedLangs.map((lang) => (
                    <a
                        href={translateHref(lang)}
                        class={`flex items-center gap-3 px-4 py-3 rounded-2xl text-[13px] font-bold transition-all ${
                            lang === currentLang
                                ? "bg-teal-primary/10 text-teal-primary"
                                : "text-slate-muted hover:bg-teal-primary/5 hover:text-teal-primary"
                        }`}
                    >
                        <span class="text-lg" aria-hidden="true">
                            {languages[lang].flag}
                        </span>
                        <span>{languages[lang].name}</span>
                        {lang === currentLang && (
                            <div class="ml-auto w-1.5 h-1.5 rounded-full bg-teal-primary shadow-[0_0_8px_rgba(0,128,160,0.4)]"></div>
                        )}
                    </a>
                ))
            }
        </div>
    </div>
</div>

<script>
    function setupLanguageSelectors() {
        const selectors = document.querySelectorAll(".language-selector");
        
        selectors.forEach(selector => {
            const button = selector.querySelector(".language-button");
            const dropdown = selector.querySelector(".language-dropdown");

            if (!button || !dropdown) return;

            // Remove existing listener if any (for SPA transitions if applicable)
            const newButton = button.cloneNode(true);
            button.parentNode?.replaceChild(newButton, button);

            newButton.addEventListener("click", (e) => {
                e.stopPropagation();
                const isOpen = dropdown.classList.contains("opacity-100");

                // Close all other dropdowns
                document.querySelectorAll(".language-dropdown").forEach(d => {
                    if (d !== dropdown) {
                        d.classList.remove("opacity-100", "visible", "translate-y-0");
                        d.classList.add("opacity-0", "invisible", "-translate-y-2");
                        d.previousElementSibling?.setAttribute("aria-expanded", "false");
                    }
                });

                if (isOpen) {
                    dropdown.classList.remove("opacity-100", "visible", "translate-y-0");
                    dropdown.classList.add("opacity-0", "invisible", "-translate-y-2");
                    (newButton as HTMLElement).setAttribute("aria-expanded", "false");
                } else {
                    dropdown.classList.remove("opacity-0", "invisible", "-translate-y-2");
                    dropdown.classList.add("opacity-100", "visible", "translate-y-0");
                    (newButton as HTMLElement).setAttribute("aria-expanded", "true");
                }
            });
        });

        // Close when clicking outside
        document.addEventListener("click", (e) => {
            if (!(e.target as HTMLElement).closest(".language-selector")) {
                document.querySelectorAll(".language-dropdown").forEach(dropdown => {
                    dropdown.classList.remove("opacity-100", "visible", "translate-y-0");
                    dropdown.classList.add("opacity-0", "invisible", "-translate-y-2");
                    dropdown.previousElementSibling?.setAttribute("aria-expanded", "false");
                });
            }
        });
    }

    // Initial setup
    setupLanguageSelectors();

    // Re-setup on Astro page load (for view transitions)
    document.addEventListener("astro:page-load", setupLanguageSelectors);
</script>

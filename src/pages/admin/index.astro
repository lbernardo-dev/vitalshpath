                                        ${Object.keys(r.translations || {}).length > 5 ? `<div class="px-2 py-1 bg-gray-100 dark:bg-white/5 rounded text-[10px] font-bold text-gray-500 text-center uppercase">+${Object.keys(r.translations).length - 5}</div>` : ''}
                                    </div>

                                    <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-white/5">
                                        <button class="text-xs font-black text-blue-600 hover:text-blue-700 transition-colors uppercase tracking-widest flex items-center gap-2">
                                            <span>Detalles</span>
                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                        </button>
                                        <button class="text-[10px] font-black text-red-400 hover:text-red-600 transition-colors uppercase tracking-widest delete-release-btn" data-id="${r.id}">Eliminar</button>
                                    </div>
                                </div>
                            `).join("");
                            
                            // Re-bind delete buttons
                            document.querySelectorAll(".delete-release-btn").forEach(btn => {
                                btn.addEventListener("click", async (e: any) => {
                                    if(confirm("¿Eliminar versión?")) {

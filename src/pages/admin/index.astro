---
import "../../styles/global.css";
const baseUrl = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="robots" content="noindex, nofollow" />
        <title>VitalsPath Admin</title>
    </head>
    <body class="bg-gray-50 min-h-screen">
        <div id="loading" class="flex items-center justify-center min-h-screen">
            <div class="text-center">
                <div
                    class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500 mx-auto mb-4"
                >
                </div>
                <p class="text-gray-600">Cargando...</p>
            </div>
        </div>

        <div
            id="login"
            class="hidden min-h-screen flex items-center justify-center p-4"
        >
            <div
                class="bg-white rounded-2xl shadow-xl p-8 max-w-md w-full text-center"
            >
                <div
                    class="w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-500 rounded-2xl flex items-center justify-center mx-auto mb-6"
                >
                    <svg
                        class="w-8 h-8 text-white"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                        ></path>
                    </svg>
                </div>
                <h1 class="text-2xl font-bold text-gray-900 mb-2">
                    VitalsPath Admin
                </h1>
                <p class="text-gray-600 mb-8">Acceso restringido</p>
                <button
                    id="google-login"
                    class="w-full flex items-center justify-center gap-3 px-6 py-3 border border-gray-300 rounded-xl hover:bg-gray-50 transition-colors"
                >
                    <svg class="w-5 h-5" viewBox="0 0 24 24">
                        <path
                            fill="#4285F4"
                            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                        ></path>
                        <path
                            fill="#34A853"
                            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                        ></path>
                        <path
                            fill="#FBBC05"
                            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                        ></path>
                        <path
                            fill="#EA4335"
                            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                        ></path>
                    </svg>
                    <span class="font-medium text-gray-700"
                        >Continuar con Google</span
                    >
                </button>
            </div>
        </div>

        <div
            id="unauthorized"
            class="hidden min-h-screen flex items-center justify-center p-4"
        >
            <div
                class="bg-white rounded-2xl shadow-xl p-8 max-w-md w-full text-center"
            >
                <div
                    class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6"
                >
                    <svg
                        class="w-8 h-8 text-red-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </div>
                <h1 class="text-2xl font-bold text-gray-900 mb-2">
                    Acceso Denegado
                </h1>
                <p class="text-gray-600 mb-6">Email no autorizado</p>
                <button
                    id="retry-login"
                    class="px-6 py-3 bg-gray-100 rounded-xl hover:bg-gray-200 transition-colors"
                    >Reintentar</button
                >
            </div>
        </div>

        <div id="dashboard" class="hidden">
            <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
                <div
                    class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center"
                >
                    <div class="flex items-center gap-3">
                        <div
                            class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-500 rounded-xl flex items-center justify-center"
                        >
                            <span class="text-white font-bold">VP</span>
                        </div>
                        <h1 class="text-xl font-bold text-gray-900">
                            VitalsPath Admin
                        </h1>
                    </div>
                    <div class="flex items-center gap-4">
                        <span
                            id="user-name"
                            class="text-sm font-medium text-gray-700"></span>
                        <button
                            id="logout-btn"
                            class="px-4 py-2 text-sm text-gray-600 hover:bg-gray-100 rounded-lg"
                            >Cerrar sesión</button
                        >
                    </div>
                </div>
            </nav>

            <main class="max-w-7xl mx-auto px-4 py-8">
                <div
                    class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-7 gap-6 mb-8"
                >
                    <div class="bg-white rounded-xl shadow-sm border p-6">
                        <span class="text-sm text-gray-500">Total Lista</span>
                        <p
                            id="stat-total"
                            class="text-2xl font-bold text-gray-900 mt-1"
                        >
                            0
                        </p>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border p-6">
                        <span class="text-sm text-gray-500">Hoy (Lista)</span>
                        <p
                            id="stat-today-signups"
                            class="text-2xl font-bold text-gray-900 mt-1"
                        >
                            +0
                        </p>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border p-6">
                        <span class="text-sm text-gray-500">Hoy (Visitas)</span>
                        <p
                            id="stat-today-visitors"
                            class="text-2xl font-bold text-gray-900 mt-1"
                        >
                            0
                        </p>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border p-6">
                        <span class="text-sm text-gray-500">Total Visitas</span>
                        <p
                            id="stat-total-visitors"
                            class="text-2xl font-bold text-gray-900 mt-1"
                        >
                            0
                        </p>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border p-6">
                        <span class="text-sm text-gray-500">Online</span>
                        <p
                            id="stat-online"
                            class="text-2xl font-bold text-gray-900 mt-1"
                        >
                            0
                        </p>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border p-6">
                        <span class="text-sm text-gray-500">Tiempo Medio</span>
                        <p
                            id="stat-avg-time"
                            class="text-2xl font-bold text-gray-900 mt-1"
                        >
                            0s
                        </p>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border p-6">
                        <span class="text-sm text-gray-500">Clics App Store</span>
                        <p
                            id="stat-app-store-clicks"
                            class="text-2xl font-bold text-gray-900 mt-1"
                        >
                            0
                        </p>
                        <div class="mt-2 text-[10px] text-gray-400 font-medium">
                            <span id="stat-app-store-tracked">0</span> trackeados + <span id="stat-app-store-manual">0</span> manuales
                        </div>
                    </div>
                </div>

                <!-- Tabs Navigation -->
                <div class="flex gap-4 mb-6 border-b">
                    <button
                        id="tab-waitlist"
                        class="px-4 py-2 border-b-2 border-blue-500 font-medium text-blue-600 transition-all"
                        >Lista de Espera</button
                    >
                    <button
                        id="tab-analytics"
                        class="px-4 py-2 border-b-2 border-transparent font-medium text-gray-500 hover:text-gray-700 transition-all"
                        >Analítica</button
                    >
                    <button
                        id="tab-pricing"
                        class="px-4 py-2 border-b-2 border-transparent font-medium text-gray-500 hover:text-gray-700 transition-all"
                        >Precios</button
                    >
                    <button
                        id="tab-surveys"
                        class="px-4 py-2 border-b-2 border-transparent font-medium text-gray-500 hover:text-gray-700 transition-all"
                        >Encuestas</button
                    >
                    <button
                        id="tab-settings"
                        class="px-4 py-2 border-b-2 border-transparent font-medium text-gray-500 hover:text-gray-700 transition-all"
                        >Ajustes</button
                    >
                    <button
                        data-section="releases"
                        class="px-6 py-4 text-sm font-bold text-gray-500 hover:text-blue-600 transition-all border-b-2 border-transparent"
                    >
                        Versiones (Timeline)
                    </button>
                    <button
                        id="tab-roadmap"
                        data-section="roadmap"
                        class="px-6 py-4 text-sm font-bold text-gray-500 hover:text-blue-600 transition-all border-b-2 border-transparent whitespace-nowrap"
                    >
                        Hoja de Ruta (Roadmap)
                    </button>
                </div>

                <!-- Section: Waitlist -->
                <div
                    id="section-waitlist"
                    class="bg-white rounded-xl shadow-sm border overflow-hidden"
                >
                    <div
                        class="px-6 py-4 border-b flex justify-between items-center"
                    >
                        <h2 class="font-semibold text-gray-900">
                            Registros Recientes
                        </h2>
                        <button
                            id="refresh-btn"
                            class="px-4 py-2 text-sm text-gray-600 hover:bg-gray-100 rounded-lg"
                            >Actualizar</button
                        >
                    </div>
                    <table class="min-w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                                    >Email</th
                                >
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                                    >Fecha</th
                                >
                                <th
                                    class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                                    >Origen</th
                                >
                            </tr>
                        </thead>
                        <tbody id="waitlist-body" class="divide-y">
                            <tr
                                ><td
                                    colspan="3"
                                    class="px-6 py-12 text-center text-gray-500"
                                    >Cargando...</td
                                >
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Section: Analytics -->
                <div id="section-analytics" class="hidden space-y-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <!-- Top Languages -->
                        <div class="bg-white rounded-xl shadow-sm border p-6">
                            <h3 class="font-bold text-gray-900 mb-4">
                                Idiomas más usados
                            </h3>
                            <div id="analytics-langs" class="space-y-4">
                                <p class="text-gray-500 text-sm">
                                    Cargando datos...
                                </p>
                            </div>
                        </div>
                        <!-- Top Pages -->
                        <div class="bg-white rounded-xl shadow-sm border p-6">
                            <h3 class="font-bold text-gray-900 mb-4">
                                Páginas más vistas
                            </h3>
                            <div id="analytics-pages" class="space-y-4">
                                <p class="text-gray-500 text-sm">
                                    Cargando datos...
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Daily History Table -->
                    <div
                        class="bg-white rounded-xl shadow-sm border overflow-hidden"
                    >
                        <div class="px-6 py-4 border-b">
                            <h3 class="font-bold text-gray-900">
                                Historial (Últimos 7 días)
                            </h3>
                        </div>
                        <table class="min-w-full">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                                        >Fecha</th
                                    >
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                                        >Visitas Únicas</th
                                    >
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                                        >Páginas Vistas</th
                                    >
                                    <th
                                        class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"
                                        >Nuevos Leads</th
                                    >
                                </tr>
                            </thead>
                            <tbody
                                id="analytics-history-body"
                                class="divide-y text-sm"
                            >
                                <tr
                                    ><td
                                        colspan="4"
                                        class="px-6 py-12 text-center text-gray-500"
                                        >Cargando...</td
                                    >
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Section: Pricing Management -->
                <div id="section-pricing" class="hidden space-y-8">
                    <div
                        class="grid md:grid-cols-2 gap-8"
                        id="pricing-editor-container"
                    >
                        <p class="text-gray-500">Cargando planes...</p>
                    </div>
                </div>

                <!-- Section: Surveys -->
                <div id="section-surveys" class="hidden space-y-8">
                    <div class="bg-white rounded-xl shadow-sm border p-6">
                        <h3 class="font-bold text-gray-900 mb-4">
                            Crear Nueva Encuesta
                        </h3>
                        <div class="space-y-4 max-w-lg">
                            <div>
                                <label
                                    class="block text-sm font-medium text-gray-700 mb-1"
                                    >Pregunta</label
                                >
                                <input
                                    type="text"
                                    id="survey-question"
                                    class="w-full px-4 py-2 border rounded-lg"
                                    placeholder="¿Qué te parece la landing?"
                                />
                            </div>
                            <div>
                                <label
                                    class="block text-sm font-medium text-gray-700 mb-1"
                                    >Opciones (separadas por comas)</label
                                >
                                <input
                                    type="text"
                                    id="survey-options"
                                    class="w-full px-4 py-2 border rounded-lg"
                                    placeholder="Genial, Normal, Mejorable"
                                />
                            </div>
                            <button
                                id="create-survey-btn"
                                class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                                >Publicar Encuesta</button
                            >
                        </div>
                    </div>

                    <div
                        id="active-survey-results"
                        class="bg-white rounded-xl shadow-sm border p-6"
                    >
                        <h3 class="font-bold text-gray-900 mb-4">
                            Resultados Encuesta Activa
                        </h3>
                        <div id="survey-display" class="space-y-4">
                            <p class="text-gray-500">
                                No hay encuestas activas
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Section: Roadmap -->
                <div id="section-roadmap" class="hidden space-y-8">
                    <div class="bg-white/80 backdrop-blur-xl rounded-[2rem] border border-blue-100/50 p-8 shadow-xl shadow-blue-900/5">
                        <div class="flex items-center gap-4 mb-8">
                            <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-indigo-200">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-1.447-.894L15 9m0 11V9"></path></svg>
                            </div>
                            <div>
                                <h2 class="text-2xl font-black text-slate-900 leading-tight">Gestión de Hoja de Ruta</h2>
                                <p class="text-slate-500 font-medium">Planifica y comunica el futuro de VitalPath</p>
                            </div>
                        </div>

                        <div class="space-y-6 max-w-2xl">
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-bold text-slate-700 mb-2">Nombre de la Mejora (ES)</label>
                                    <input type="text" id="roadmap-title" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none transition-all" placeholder="Ej: Integración con Apple Watch">
                                </div>
                                <div>
                                    <label class="block text-sm font-bold text-slate-700 mb-2">Fecha Estimada</label>
                                    <input type="text" id="roadmap-date" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none transition-all" placeholder="Ej: Q4 2026, Diciembre 2026">
                                </div>
                            </div>
                            
                            <div>
                                <label class="block text-sm font-bold text-slate-700 mb-2">Descripción (Notas breves)</label>
                                <textarea id="roadmap-description" rows="3" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none transition-all" placeholder="Detalles sobre esta funcionalidad..."></textarea>
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-bold text-slate-700 mb-2">Estado</label>
                                    <select id="roadmap-status" class="w-full px-4 py-3 border border-slate-200 rounded-xl bg-white focus:ring-2 focus:ring-indigo-500 outline-none appearance-none">
                                        <option value="planned">Planificado (Planned)</option>
                                        <option value="in-progress">En Desarrollo (In Progress)</option>
                                        <option value="completed">Completado (Completed)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-bold text-slate-700 mb-2">Prioridad</label>
                                    <input type="number" id="roadmap-priority" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none transition-all" value="0">
                                </div>
                                <div class="flex items-center gap-2 pt-8">
                                    <input type="checkbox" id="roadmap-public" class="w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500">
                                    <label for="roadmap-public" class="text-sm font-bold text-slate-700 uppercase tracking-widest cursor-pointer">Publicar en Landing (Libre)</label>
                                </div>
                            </div>

                            <button id="submit-roadmap-btn" class="w-full md:w-auto px-10 py-4 bg-indigo-600 text-white font-black rounded-xl hover:bg-indigo-700 transition-all shadow-[0_10px_30px_rgba(79,70,229,0.3)] hover:shadow-[0_15px_40px_rgba(79,70,229,0.4)] active:scale-[0.98] flex items-center justify-center gap-3">
                                <span>Traducir y Guardar en Roadmap</span>
                                <svg class="w-5 h-5 font-bold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"></path></svg>
                            </button>

                            <!-- Status UI for Roadmap -->
                            <div id="roadmap-status-container" class="hidden mt-6 p-6 rounded-2xl border border-indigo-100 bg-indigo-50/50 backdrop-blur-md">
                                <div class="flex items-center gap-4 mb-4">
                                    <div class="animate-spin rounded-full h-5 w-5 border-2 border-indigo-500 border-t-transparent"></div>
                                    <p id="roadmap-status-title" class="font-bold text-indigo-900">Procesando hoja de ruta...</p>
                                </div>
                                <div id="roadmap-error" class="hidden mt-4 p-4 rounded-xl bg-red-100/50 border border-red-200 text-red-700 text-sm font-medium"></div>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white/80 backdrop-blur-xl rounded-[2rem] border border-slate-100 p-8 shadow-xl shadow-slate-900/5">
                        <h3 class="text-xl font-black text-slate-900 mb-6">Elementos Actuales</h3>
                        <div id="roadmap-list" class="space-y-4">
                            <!-- Roadmap items will lead here -->
                            <div class="animate-pulse flex space-y-4 flex-col">
                                <div class="h-12 bg-slate-100 rounded-xl w-full"></div>
                                <div class="h-12 bg-slate-100 rounded-xl w-full text-center py-3 text-slate-400 font-medium italic">Cargando elementos...</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="section-settings" class="hidden space-y-8">
                    <div class="bg-white rounded-xl shadow-sm border p-6">
                        <h3 class="font-bold text-gray-900 mb-4">Configuración de adquisición App Store</h3>
                        <div class="space-y-4 max-w-lg">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Cifra manual externa</label>
                                <p class="text-xs text-gray-500 mb-2">Este número se sumará a los clics a App Store trackeados automáticamente desde la landing.</p>
                                <div class="flex gap-2">
                                    <input
                                        type="number"
                                        id="app-store-manual-input"
                                        class="flex-1 px-4 py-2 border rounded-lg"
                                        placeholder="Ej: 500"
                                    />
                                    <button
                                        id="save-app-store-manual-btn"
                                        class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
                                    >Guardar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="bg-white rounded-xl shadow-sm border p-6">
                        <h3 class="font-bold text-gray-900 mb-4">Enlaces públicos de App Store</h3>
                        <div class="space-y-5 max-w-3xl">
                            <p class="text-sm text-gray-600">
                                Fuente única de verdad para CTAs públicos, footer, soporte y enlaces de reseña.
                                Si dejas vacíos los storefronts, el sitio usará el enlace genérico.
                            </p>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Enlace genérico</label>
                                <input
                                    type="url"
                                    id="app-store-generic-url"
                                    class="w-full px-4 py-2 border rounded-lg"
                                    placeholder="https://apps.apple.com/app/id6760143192"
                                />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Enlace de reseña</label>
                                <input
                                    type="url"
                                    id="app-store-review-url"
                                    class="w-full px-4 py-2 border rounded-lg"
                                    placeholder="https://apps.apple.com/app/id6760143192?action=write-review"
                                />
                            </div>
                            <div class="grid gap-4 md:grid-cols-2">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Storefront España</label>
                                    <input
                                        type="url"
                                        id="app-store-es-url"
                                        class="w-full px-4 py-2 border rounded-lg"
                                        placeholder="https://apps.apple.com/es/app/id6760143192"
                                    />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Storefront Estados Unidos</label>
                                    <input
                                        type="url"
                                        id="app-store-en-url"
                                        class="w-full px-4 py-2 border rounded-lg"
                                        placeholder="https://apps.apple.com/us/app/id6760143192"

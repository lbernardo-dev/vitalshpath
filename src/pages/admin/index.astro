                    }
                }
                fetchReleases();

                document.getElementById("submit-release-btn")?.addEventListener("click", async () => {
                    const version = (document.getElementById("release-version") as HTMLInputElement).value.trim();
                    const build = (document.getElementById("release-build") as HTMLInputElement).value.trim();
                    const changes = (document.getElementById("release-changes") as HTMLTextAreaElement).value.trim();
                    const aiProvider = (document.getElementById("release-ai") as HTMLSelectElement).value;
                    const apiKey = (document.getElementById("release-apikey") as HTMLInputElement).value.trim();
                    const sourceLang = (document.getElementById("release-lang") as HTMLSelectElement).value;

                    const statusContainer = document.getElementById("release-status-container")!;
                    const statusTitle = document.getElementById("release-status-title")!;
                    const errorBox = document.getElementById("release-error")!;
                    const errorMsg = document.getElementById("release-error-msg")!;
                    const btn = document.getElementById("submit-release-btn") as HTMLButtonElement;

                    const setStep = (id: string, active: boolean, done: boolean = false) => {
                        const el = document.getElementById(id);
                        if (!el) return;
                        el.style.opacity = active || done ? "1" : "0.4";
                        const icon = el.querySelector('.step-icon');
                        if (icon) icon.textContent = done ? "✓" : (active ? "●" : "○");
                        if (active) el.classList.add("font-black", "text-blue-600");
                        else el.classList.remove("font-black", "text-blue-600");
                    };

                    if (!version || !build || !changes || !apiKey) {
                        errorMsg.textContent = "Por favor completa todos los campos (Versión, Build, Novedades y API Key).";
                        errorBox.classList.remove("hidden");
                        window.scrollTo({ top: errorBox.offsetTop - 100, behavior: 'smooth' });
                        return;
                    }

                    // Reset UI
                    localStorage.setItem(lsKey, apiKey);
                    errorBox.classList.add("hidden");
                    statusContainer.classList.remove("hidden");
                    btn.disabled = true;
                    btn.style.opacity = "0.5";
                    
                    setStep("step-ai", true);
                    setStep("step-parse", false);
                    setStep("step-db", false);

                    const targetLangs = ["en", "es", "fr", "de", "it", "pt", "ja", "zh", "ko", "ru", "ar", "hi", "tr", "nl", "pl"];
                    
                    try {
                        let translationsObj = {};
                        // Better prompt for structured data
                        const promptMsg = `Task: Translate release notes into 15 languages.
Target Languages: ${targetLangs.join(', ')}
Output Format: STRICT JSON object where keys are 2-letter codes and values are arrays of strings (one for each bullet point).
Constraint: Do NOT include original text. DO NOT include markdown backticks.

Original Content (${sourceLang}):
${changes}`;

                        if (aiProvider === "openai") {
                            const res = await fetch("https://api.openai.com/v1/chat/completions", {
                                method: "POST",
                                headers: { "Content-Type": "application/json", "Authorization": `Bearer ${apiKey}` },
                                body: JSON.stringify({
                                    model: "gpt-4o-mini",
                                    messages: [{ role: "user", content: promptMsg }],
                                    response_format: { type: "json_object" }
                                })
                            });
                            const json = await res.json();
                            if (json.error) throw new Error(`OpenAI Error: ${json.error.message || "Error desconocido"}`);
                            translationsObj = typeof json.choices[0].message.content === 'string' 
                                ? JSON.parse(json.choices[0].message.content) 
                                : json.choices[0].message.content;
                        } else {
                            // Gemini (multiple models & API versions for 2026)
                            const tryGeminiVersioned = async (modelName: string, apiVersionCode: string = "v1") => {
                                // @ts-ignore - Important: Ensure model string is clean
                                const cleanModelName = modelName.trim();
                                
                                try {
                                    const response = await fetch(`https://generativelanguage.googleapis.com/${apiVersionCode}/models/${cleanModelName}:generateContent?key=${apiKey}`, {
                                        method: "POST",
                                        headers: { "Content-Type": "application/json" },
                                        body: JSON.stringify({
                                            contents: [{ parts: [{ text: promptMsg }] }],
                                            generationConfig: { 
                                                responseMimeType: "application/json",
                                                temperature: 0.1
                                            }
                                        })
                                    });
                                    return response;
                                } catch (e) {
                                    // Handle network failures
                                    return { ok: false, status: 0, statusText: "Network Error" } as any;
                                }
                            };

                            // Multi-pass attempt logic: Try v1, then v1beta, then fallback model
                            const resilientGeminiFetch = async (modelToTry: string) => {
                                let response = await tryGeminiVersioned(modelToTry, "v1");
                                
                                // If 404 or 400, version might be wrong or model deprecated
                                if (!response.ok && (response.status === 404 || response.status === 400)) {
                                    console.warn(`Gemini ${modelToTry} fail on v1 (${response.status}), trying v1beta...`);
                                    response = await tryGeminiVersioned(modelToTry, "v1beta");
                                }
                                
                                return response;
                            };

                            let res = await resilientGeminiFetch(aiProvider);
                            
                            // If still failed, try the ultimate free stable fallback
                            if (!res.ok && res.status !== 429 && aiProvider !== "gemini-2.5-flash") {
                                console.warn(`Model ${aiProvider} failed fully, trying 2.5-flash...`);
                                res = await resilientGeminiFetch("gemini-2.5-flash");
                            }
                            
                            if (!res.ok) {
                                const errJson = await res.json().catch(() => ({}));
                                const msg = errJson.error?.message || `Error HTTP ${res.status}`;
                                if (res.status === 429) throw new Error("¡Cuota agotada en este modelo! Espera 60s o usa otro modelo.");
                                if (res.status === 404) throw new Error(`El modelo '${aiProvider}' no se encontró en tu región o API Key. Prueba con un modelo 'Flash'.`);
                                throw new Error(`Gemini API: ${msg}`);
                            }

                            const json = await res.json();
                            const candidate = json.candidates?.[0];
                            
                            // Handle potential empty candidates (safety filters)
                            if (!candidate || !candidate.content?.parts?.[0]?.text) {
                                if (candidate?.finishReason === "SAFETY") {
                                    throw new Error("La IA bloqueó la respuesta por motivos de seguridad. Prueba a simplificar el texto.");
                                }
                                throw new Error("La IA respondió sin contenido. Esto suele ser por falta de créditos o límites de cuota.");
                            }

                            const rawText = candidate.content.parts[0].text;
                            const jsonMatch = rawText.match(/\{[\s\S]*\}/);
                            if (!jsonMatch) throw new Error("La IA no devolvió un formato válido. Intenta con frases más cortas.");
                            translationsObj = JSON.parse(jsonMatch[0]);
                        }

                        setStep("step-ai", false, true);
                        setStep("step-parse", true);

                        // Validation
                        if (!translationsObj["en"] || !translationsObj["es"]) {
                            console.error("Missing core langs:", translationsObj);
                            throw new Error("Faltan idiomas críticos (en/es) en la respuesta de la IA.");
                        }

                        setStep("step-parse", false, true);
                        setStep("step-db", true);

                        const { error } = await (supabase.from("releases") as any).insert([{
                            version, 
                            build_number: build, 
                            translations: translationsObj
                        }]);

                        if (error) throw new Error("Supabase: " + error.message);
                        
                        setStep("step-db", false, true);
                        statusTitle.textContent = "¡Versión publicada!";
                        
                        // Success cleanup
                        document.getElementById("release-version").value = "";
                        document.getElementById("release-build").value = "";
                        document.getElementById("release-changes").value = "";
                        
                        setTimeout(() => {
                            statusContainer.classList.add("hidden");
                            btn.disabled = false;
                            btn.style.opacity = "1";
                        }, 3000);
                        
                        fetchReleases();

                    } catch (e: any) {
                        console.error("Release creation failed:", e);
                        errorMsg.textContent = e.message || "Ocurrió un error inesperado.";
                        errorBox.classList.remove("hidden");
                        statusContainer.classList.add("hidden");
                        btn.disabled = false;
                        btn.style.opacity = "1";
                    }
                });
            }


                        const priority = parseInt((document.getElementById("roadmap-priority") as HTMLInputElement).value) || 0;
                        const isPublic = (document.getElementById("roadmap-public") as HTMLInputElement).checked;
                        
                        const apiKey = (document.getElementById("release-apikey") as HTMLInputElement).value.trim();
                        const statusContainer = document.getElementById("roadmap-status-container")!;
                        const statusTitle = document.getElementById("roadmap-status-title")!;
                        const errorBox = document.getElementById("roadmap-error")!;
                        const btn = document.getElementById("submit-roadmap-btn") as HTMLButtonElement;

                        if (!title || !apiKey) {
                            alert("Por favor rellena al menos el título y asegúrate de tener una API Key guardada en la sección de versiones.");
                            return;
                        }

                        btn.disabled = true;
                        btn.style.opacity = "0.5";
                        statusContainer.classList.remove("hidden");
                        statusTitle.textContent = "Traduciendo hito (IA)...";
                        errorBox.classList.add("hidden");

                        const targetLangs = ["en", "es", "fr", "de", "it", "pt", "ja", "zh", "ko", "ru", "ar", "hi", "tr", "nl", "pl"];

                        const promptMsg = `Task: Translate a roadmap milestone into 15 languages.
Target Languages: ${targetLangs.join(', ')}
Output Format: STRICT JSON object where keys are 2-letter codes and values are objects with {title, description}.
Constraint: Do NOT include original text. DO NOT include markdown backticks.

Original (ES):
Title: ${title}
Description: ${description}`;
                        
                        let translationsObj = {};
                        const aiProvider = (document.getElementById("release-ai") as HTMLSelectElement).value;

                        async function translateRoadmap() {
                             if (aiProvider === "openai") {
                                 const response = await fetch("https://api.openai.com/v1/chat/completions", {
                                     method: "POST",
                                     headers: { "Content-Type": "application/json", "Authorization": `Bearer ${apiKey}` },
                                     body: JSON.stringify({
                                         model: "gpt-4o-mini",
                                         messages: [{ role: "user", content: promptMsg }],
                                         response_format: { type: "json_object" }
                                     })
                                 });
                                 const json = await response.json();
                                 if (json.error) throw new Error(`OpenAI Error: ${json.error.message || "Error desconocido"}`);
                                 return typeof json.choices[0].message.content === 'string' 
                                     ? JSON.parse(json.choices[0].message.content) 
                                     : json.choices[0].message.content;
                             } else {
                                 const tryGeminiVersioned = async (modelName: string, apiVersionCode: string = "v1") => {
                                     const cleanModelName = modelName.trim();
                                     try {
                                         const response = await fetch(`https://generativelanguage.googleapis.com/${apiVersionCode}/models/${cleanModelName}:generateContent?key=${apiKey}`, {
                                             method: "POST",
                                             headers: { "Content-Type": "application/json" },
                                             body: JSON.stringify({
                                                 contents: [{ parts: [{ text: promptMsg }] }],
                                                 generationConfig: { responseMimeType: "application/json", temperature: 0.1 }
                                             })
                                         });
                                         return response;
                                     } catch (e) {
                                         return { ok: false, status: 0, statusText: "Network Error" } as any;
                                     }
                                 };

                                 const resilientGeminiFetch = async (modelToTry: string) => {
                                     let response = await tryGeminiVersioned(modelToTry, "v1");
                                     if (!response.ok && (response.status === 404 || response.status === 400)) {
                                         response = await tryGeminiVersioned(modelToTry, "v1beta");
                                     }
                                     return response;
                                 };

                                 let res = await resilientGeminiFetch(aiProvider);
                                 
                                 if (!res.ok && res.status !== 429 && aiProvider !== "gemini-1.5-flash") {
                                     res = await resilientGeminiFetch("gemini-1.5-flash");
                                 }

                                 if (!res.ok) {
                                     const errJson = await res.json().catch(() => ({}));
                                     const msg = errJson.error?.message || `Error HTTP ${res.status}`;
                                     if (res.status === 429) throw new Error("¡Cuota agotada en este modelo! Prueba con 'Gemini 1.5 Flash' o espera 60s.");
                                     throw new Error(`Gemini API: ${msg}`);
                                 }

                                 const json = await res.json();
                                 const candidate = json.candidates?.[0];
                                 if (!candidate || !candidate.content?.parts?.[0]?.text) {
                                     if (candidate?.finishReason === "SAFETY") throw new Error("La IA bloqueó la respuesta por seguridad.");
                                     throw new Error("La IA respondió sin contenido.");
                                 }

                                 const rawText = candidate.content.parts[0].text;
                                 const jsonMatch = rawText.match(/\{[\s\S]*\}/);
                                 if (!jsonMatch) throw new Error("Formato de respuesta IA inválido");
                                 return JSON.parse(jsonMatch[0]);
                             }
                        }

                        translationsObj = await translateRoadmap();

                        statusTitle.textContent = "Guardando en base de datos...";
                        
                        const { error } = await (supabase.from("roadmap") as any).insert([{
                            title, 
                            target_date: date,
                            description,
                            status,
                            priority,
                            is_public: isPublic,
                            translations: translationsObj
                        }]);

                        if (error) throw error;

                        statusTitle.textContent = "¡Hito añadido!";
                        setTimeout(() => {
                            statusContainer.classList.add("hidden");
                            btn.disabled = false;
                            btn.style.opacity = "1";
                        }, 2000);

                        // Reset form
                        (document.getElementById("roadmap-title") as HTMLInputElement).value = "";
                        (document.getElementById("roadmap-description") as HTMLTextAreaElement).value = "";
                        
                        fetchRoadmap();

                    } catch (e: any) {
                        console.error(e);
                        errorBox.textContent = "Error: " + (e.message || "Unknown error");
                        errorBox.classList.remove("hidden");
                        btn.disabled = false;
                        btn.style.opacity = "1";
                    }
                });
            }

            setupTabs();
            setupPricing();
            setupSurveys();
            setupSettings();
            setupReleases();
            setupRoadmap();
            init();
        </script>
    </body>
</html>

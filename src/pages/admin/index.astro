                                />
                                <span class="text-sm text-gray-700">
                                    Activar mantenimiento en las páginas públicas de marketing.
                                    Las rutas legales enlazadas desde la app seguirán accesibles.
                                </span>
                            </label>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Mensaje personalizado</label>
                                <p class="text-xs text-gray-500 mb-2">Opcional. Si lo dejas vacío, se mostrará el texto por defecto de la página de mantenimiento.</p>
                                <textarea
                                    id="maintenance-message"
                                    rows="4"
                                    class="w-full px-4 py-3 border rounded-lg"
                                    placeholder="Estamos preparando el lanzamiento público..."
                                ></textarea>
                            </div>
                            <div class="flex items-center gap-3">
                                <button
                                    id="save-maintenance-btn"
                                    class="px-6 py-2 bg-gray-900 text-white rounded-lg hover:bg-blue-700 transition-colors"
                                >Guardar mantenimiento</button>
                                <a
                                    href={`${baseUrl}es/maintenance/`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-sm font-medium text-blue-600 hover:text-blue-700"
                                >Ver página</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section: Releases -->
                <div id="section-releases" class="hidden space-y-8">
                    <div class="bg-white rounded-xl shadow-sm border p-6">
                        <h3 class="font-bold text-gray-900 mb-4">Lanzar Nueva Versión</h3>
                        <div class="space-y-4 max-w-2xl">
                            <div class="grid grid-cols-2 gap-4">
                                <div><label class="block text-sm font-medium text-gray-700 mb-1">Versión (App)</label><input type="text" id="release-version" class="w-full px-4 py-2 border rounded-lg" placeholder="1.2.0"></div>
                                <div><label class="block text-sm font-medium text-gray-700 mb-1">Build</label><input type="text" id="release-build" class="w-full px-4 py-2 border rounded-lg" placeholder="42"></div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Novedades (una por línea o Markdown)</label>
                                <textarea id="release-changes" rows="5" class="w-full px-4 py-3 border rounded-lg" placeholder="- Mejora de rendimiento\n- Nuevo diseño"></textarea>
                            </div>
                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Idioma Origen</label>
                                    <select id="release-lang" class="w-full px-4 py-2 border rounded-lg">
                                        <option value="es">Español</option>
                                        <option value="en">Inglés</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Motor IA (Traducirá a 15 idiomas)</label>
                                    <select id="release-ai" class="w-full px-4 py-2 border rounded-lg bg-white">
                                        <option value="gemini-2.0-flash">Gemini 2.0 Flash (Gratis / Rápido)</option>
                                        <option value="gemini-1.5-flash">Gemini 1.5 Flash (Gratis / Estable)</option>
                                        <option value="gemini-1.5-pro">Gemini 1.5 Pro (Pago / Avanzado)</option>
                                        <option value="openai">Explorar OpenAI (GPT-4o-mini)</option>
                                    </select>
                                </div>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">API Key (Se guarda seguro en tu navegador local)</label>
                                <input type="password" id="release-apikey" class="w-full px-4 py-2 border rounded-lg" placeholder="sk-...">
                            </div>
                            <button id="submit-release-btn" class="w-full md:w-auto px-10 py-4 bg-blue-600 text-white font-black rounded-xl hover:bg-blue-700 transition-all shadow-[0_10px_30px_rgba(37,99,235,0.3)] hover:shadow-[0_15px_40px_rgba(37,99,235,0.4)] active:scale-[0.98] flex items-center justify-center gap-3">
                                <span>Publicar Nueva Versión</span>
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path></svg>
                            </button>
                            
                            <!-- Enhanced Status/Progress UI -->
                            <div id="release-status-container" class="hidden mt-6 p-6 rounded-2xl border border-blue-100 bg-blue-50/50 backdrop-blur-md">
                                <div class="flex items-center gap-4 mb-4">
                                    <div class="animate-spin rounded-full h-5 w-5 border-2 border-blue-500 border-t-transparent"></div>
                                    <p id="release-status-title" class="font-bold text-blue-900">Procesando lanzamiento...</p>
                                </div>
                                <div class="space-y-3">
                                    <div id="step-ai" class="flex items-center gap-2 text-sm text-blue-700 opacity-50 transition-opacity">
                                        <span class="step-icon">○</span> <span>Generando traducciones (15 idiomas)</span>
                                    </div>
                                    <div id="step-parse" class="flex items-center gap-2 text-sm text-blue-700 opacity-50 transition-opacity">
                                        <span class="step-icon">○</span> <span>Validando integridad del contenido</span>
                                    </div>
                                    <div id="step-db" class="flex items-center gap-2 text-sm text-blue-700 opacity-50 transition-opacity">
                                        <span class="step-icon">○</span> <span>Publicando en base de datos</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Error Display -->
                            <div id="release-error" class="hidden mt-6 p-6 rounded-2xl border border-red-200 bg-red-50 text-red-900 shadow-sm animate-float-slow">
                                <div class="flex items-center gap-3 mb-2">
                                    <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path></svg>
                                    <h4 class="font-bold">Error en el proceso</h4>
                                </div>
                                <p id="release-error-msg" class="text-sm font-medium opacity-80 leading-relaxed"></p>
                                <button onclick="document.getElementById('release-error').classList.add('hidden')" class="mt-4 text-xs font-bold uppercase tracking-widest text-red-600 hover:text-red-800">Cerrar</button>
                            </div>
                        </div>
                    </div>
                    <!-- Lista de versiones anteriores -->
                    <div class="bg-white rounded-xl shadow-sm border p-6">
                        <h3 class="font-bold text-gray-900 mb-4">Versiones Previas</h3>
                        <div id="releases-list" class="space-y-4">
                            <p class="text-gray-500">Cargando...</p>
                        </div>
                    </div>
                </div>
            </main>
        </div>

        <script>
            import { getSupabase } from "../../lib/supabase";
            import { getDefaultAppStoreLinks } from "../../lib/app-store-links";

            var ADMIN_EMAILS = [
                "lbernardo.dev@gmail.com",
                "yilianbs@gmail.com",
            ];

            // Get base URL for redirects
            const baseUrl =
                import.meta.env.BASE_URL === "/"
                    ? ""
                    : import.meta.env.BASE_URL;

            const supabase = getSupabase();
            const defaultAppStoreLinks = getDefaultAppStoreLinks();

            function show(id) {
                const el = document.getElementById(id);
                if (el) el.classList.remove("hidden");
            }
            function hide(id) {
                const el = document.getElementById(id);
                if (el) el.classList.add("hidden");
            }

	            function loadDashboard() {
	                if (!supabase) return;

                // Core Stats
                supabase.rpc("get_stats").then(function (result) {
                    if (result.data) {
                        const data = result.data;
                        document.getElementById("stat-total").textContent =
                            data.total_signups || 0;
                        document.getElementById(
                            "stat-today-signups"
                        ).textContent = "+" + (data.today_signups || 0);
                        document.getElementById(
                            "stat-today-visitors"
                        ).textContent = data.today_visitors || 0;
                        document.getElementById(
                            "stat-total-visitors"
                        ).textContent = data.total_visitors || 0;
                        document.getElementById("stat-online").textContent =
                            data.online_now || 0;

                        // App Store Clicks
                        if (data.app_store_clicks_total !== undefined) {
                            document.getElementById("stat-app-store-clicks").textContent = data.app_store_clicks_total;
                            document.getElementById("stat-app-store-tracked").textContent = data.app_store_clicks_tracked;
                            document.getElementById("stat-app-store-manual").textContent = data.app_store_clicks_manual;
                        }

                        if (data.avg_duration_seconds !== undefined) {
                            const secs = Math.round(data.avg_duration_seconds);
                            const el = document.getElementById("stat-avg-time");
                            if (secs < 60) {
                                el.textContent = `${secs}s`;
                            } else {
                                const mins = Math.floor(secs / 60);
                                const remSecs = secs % 60;
                                el.textContent =
                                    remSecs > 0
                                        ? `${mins}m ${remSecs}s`
                                        : `${mins}m`;
                            }
                        }
                    }
                });

                // Deep Analytics
	                supabase.rpc("get_admin_analytics").then(function (result) {
                    if (result.data) {
                        const data = result.data;

                        // Render Langs
                        const langsEl =
                            document.getElementById("analytics-langs");
                        langsEl.innerHTML =
                            data.top_languages
                                .map(
                                    (l) => `
                            <div>
                                <div class="flex justify-between text-sm mb-1">
                                    <span class="font-medium text-gray-700">${l.lang.toUpperCase()}</span>
                                    <span class="text-gray-500">${
                                        l.count
                                    } vistas</span>
                                </div>
                                <div class="w-full bg-gray-100 rounded-full h-2">
                                    <div class="bg-blue-500 h-2 rounded-full" style="width: ${Math.min(
                                        100,
                                        (l.count /
                                            data.top_languages[0].count) *
                                            100
                                    )}%"></div>
                                </div>
                            </div>
                        `
                                )
                                .join("") ||
                            '<p class="text-gray-500 text-sm">Sin datos</p>';

                        // Render Pages
                        const pagesEl =
                            document.getElementById("analytics-pages");
                        pagesEl.innerHTML =
                            data.top_pages
                                .map(
                                    (p) => `
                            <div>
                                <div class="flex justify-between text-sm mb-1">
                                    <span class="font-medium text-gray-700 truncate mr-2">${
                                        p.page
                                    }</span>
                                    <span class="text-gray-500">${
                                        p.count
                                    }</span>
                                </div>
                                <div class="w-full bg-gray-100 rounded-full h-2">
                                    <div class="bg-purple-500 h-2 rounded-full" style="width: ${Math.min(
                                        100,
                                        (p.count / data.top_pages[0].count) *
                                            100
                                    )}%"></div>
                                </div>
                            </div>
                        `
                                )
                                .join("") ||
                            '<p class="text-gray-500 text-sm">Sin datos</p>';

                        // Render History
                        const historyBody = document.getElementById(
                            "analytics-history-body"
                        );
                        historyBody.innerHTML = data.history
                            .map(
                                (h) => `
                            <tr>
                                <td class="px-6 py-4 font-medium text-gray-900">${h.date}</td>
                                <td class="px-6 py-4 text-gray-600">${h.unique_visitors}</td>
                                <td class="px-6 py-4 text-gray-600">${h.page_views}</td>
                                <td class="px-6 py-4 text-blue-600 font-bold">${h.signups}</td>
                            </tr>
                        `
                            )
                            .join("");

                        // Render Survey
                        const surveyEl =
                            document.getElementById("survey-display");
                        if (data.active_survey) {
                            const totalVotes = (
                                data.active_survey.results || []
                            ).reduce((acc, curr) => acc + curr.votes, 0);
                            surveyEl.innerHTML = `
                                <div class="space-y-6">
                                    <h4 class="text-2xl font-black text-gray-900 leading-tight">${
                                        data.active_survey.question
                                    }</h4>
                                    <p class="text-sm text-gray-400 font-bold uppercase tracking-widest">${totalVotes} votos registrados</p>
                                    <button id="close-survey-btn" class="px-6 py-3 bg-red-50 text-red-600 font-bold rounded-xl hover:bg-red-100 transition-all text-sm border border-red-100">Cerrar Encuesta</button>
                                </div>
                                <div class="space-y-5 bg-gray-50 p-6 rounded-2xl border border-gray-100">
                                    ${(data.active_survey.options || [])
                                        .map((opt) => {
                                            const r = (
                                                data.active_survey.results || []
                                            ).find(
                                                (res) =>
                                                    res.selected_option === opt
                                            ) || { votes: 0 };
                                            const pct =
                                                totalVotes > 0
                                                    ? Math.round(
                                                          (r.votes /
                                                              totalVotes) *
                                                              100
                                                      )
                                                    : 0;
                                            return `
                                            <div>
                                                <div class="flex justify-between text-sm mb-2">
                                                    <span class="font-bold text-gray-700">${opt}</span>
                                                    <span class="font-black text-blue-600">${r.votes} votos (${pct}%)</span>
                                                </div>
                                                <div class="w-full bg-white rounded-full h-3 border border-gray-100 overflow-hidden">
                                                    <div class="bg-gradient-to-r from-blue-500 to-indigo-600 h-full transition-all duration-1000" style="width: ${pct}%"></div>
                                                </div>
                                            </div>
                                        `;
                                        })
                                        .join("")}
                                </div>
                            `;
                        } else {
                            surveyEl.innerHTML =
                                '<p class="text-gray-500 italic">No hay una encuesta activa.</p>';
                        }

                        // Render Pricing
                        const pricingEl = document.getElementById(
                            "pricing-editor-container"
                        );
                        pricingEl.innerHTML = (data.pricing || [])
                            .filter((p) => p.id !== "free") // Only premium plans for now
                            .map((p) => {
                                const labels = {
                                    premium_monthly: "Premium Mensual",
                                    premium_annual: "Premium Anual",
                                    premium_lifetime:
                                        "Premium De Por Vida (Lifetime)",
                                };
                                const label = labels[p.id] || p.id;

                                return `
                            <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 hover:shadow-md transition-all">
                                <div class="flex items-center justify-between mb-6">
                                    <h4 class="text-lg font-black text-gray-900 uppercase tracking-tighter">${label}</h4>
                                    <span class="px-3 py-1 bg-blue-100 text-blue-600 rounded-full text-[10px] font-black uppercase tracking-widest">${
                                        p.id.split("_")[1] || ""
                                    }</span>
                                </div>
                                <div class="space-y-6">
                                    <div class="space-y-2">
                                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Precio Base (${
                                            p.currency
                                        })</label>
                                        <input type="number" step="0.01" class="pricing-base w-full px-4 py-3 bg-gray-50 border-none rounded-xl font-bold text-xl" data-id="${
                                            p.id
                                        }" value="${p.base_price}">
                                    </div>
                                    <div class="space-y-2">
                                        <label class="text-[10px] font-black text-gray-400 uppercase tracking-widest">Descuento (%)</label>
                                        <input type="number" class="pricing-discount w-full px-4 py-3 bg-gray-50 border-none rounded-xl font-bold text-xl" data-id="${
                                            p.id
                                        }" value="${p.discount_percentage}">
                                    </div>
                                    <div class="pt-4 flex items-center justify-between border-t border-gray-50 mt-4">
                                        <div class="text-xs font-bold text-gray-500 uppercase tracking-wider">Final: <span class="text-blue-600 font-black text-lg">${
                                            p.currency
                                        }${(
                                    p.base_price *
                                    (1 - p.discount_percentage / 100)
                                ).toFixed(2)}</span></div>
                                        <button class="save-pricing-btn px-6 py-2 bg-gray-900 text-white text-xs font-black rounded-lg hover:bg-blue-600 transition-colors" data-id="${
                                            p.id
                                        }">Guardar</button>
                                    </div>
                                </div>
                            </div>
                        `;
                            })
                            .join("");
	                    }
	                });

	                supabase
	                    .from("site_settings")
	                    .select("key, value")
	                    .in("key", ["app_store_manual_count", "testflight_manual_count", "maintenance_mode", "app_store_links"])
	                    .then(function (result) {
	                        if (!result.data) return;

	                        const manualSetting = result.data.find(
	                            (item) => item.key === "app_store_manual_count"
	                        ) || result.data.find((item) => item.key === "testflight_manual_count");
	                        const maintenanceSetting = result.data.find(
	                            (item) => item.key === "maintenance_mode"
	                        );
                            const appStoreLinksSetting = result.data.find(
                                (item) => item.key === "app_store_links"
                            );

	                        const manualInput = document.getElementById("app-store-manual-input");
	                        if (manualInput && manualSetting) {
	                            manualInput.value = String(manualSetting.value || 0);
	                        }

	                        const maintenanceEnabled = document.getElementById("maintenance-enabled");
	                        const maintenanceMessage = document.getElementById("maintenance-message");
	                        const maintenanceValue = maintenanceSetting?.value;
	                        const enabled =
	                            typeof maintenanceValue === "boolean"
	                                ? maintenanceValue
	                                : Boolean(maintenanceValue?.enabled);
	                        const message =
	                            typeof maintenanceValue === "object" &&
	                            maintenanceValue !== null &&
	                            typeof maintenanceValue.message === "string"
	                                ? maintenanceValue.message
	                                : "";

	                        if (maintenanceEnabled) maintenanceEnabled.checked = enabled;
	                        if (maintenanceMessage) maintenanceMessage.value = message;

                            const appStoreLinksValue =
                                typeof appStoreLinksSetting?.value === "object" &&
                                appStoreLinksSetting?.value !== null
                                    ? appStoreLinksSetting.value
                                    : defaultAppStoreLinks;

                            const appStoreGenericInput = document.getElementById("app-store-generic-url");
                            const appStoreReviewInput = document.getElementById("app-store-review-url");
                            const appStoreEsInput = document.getElementById("app-store-es-url");
                            const appStoreEnInput = document.getElementById("app-store-en-url");

                            if (appStoreGenericInput) {
                                appStoreGenericInput.value =
                                    appStoreLinksValue.genericUrl || defaultAppStoreLinks.genericUrl;
                            }
                            if (appStoreReviewInput) {
                                appStoreReviewInput.value =
                                    appStoreLinksValue.reviewUrl || defaultAppStoreLinks.reviewUrl;
                            }
                            if (appStoreEsInput) {
                                appStoreEsInput.value =
                                    appStoreLinksValue.storefronts?.es ||
                                    defaultAppStoreLinks.storefronts.es ||
                                    "";
                            }
                            if (appStoreEnInput) {
                                appStoreEnInput.value =
                                    appStoreLinksValue.storefronts?.en ||
                                    defaultAppStoreLinks.storefronts.en ||
                                    "";
                            }
	                    });

	                supabase
	                    .from("waitlist")
                    .select("*")
                    .order("created_at", { ascending: false })
                    .limit(50)
                    .then(function (result) {
                        var tbody = document.getElementById("waitlist-body");
                        if (!tbody) return;

                        if (result.data && result.data.length > 0) {
                            var html = "";
                            result.data.forEach(function (item) {
                                html +=
                                    '<tr class="hover:bg-gray-50"><td class="px-6 py-4 text-sm text-gray-900">' +
                                    item.email +
                                    '</td><td class="px-6 py-4 text-sm text-gray-500">' +
                                    new Date(item.created_at).toLocaleString(
                                        "es-ES"
                                    ) +
                                    '</td><td class="px-6 py-4 text-sm text-gray-500">' +
                                    (item.source || "landing") +
                                    "</td></tr>";
                            });
                            tbody.innerHTML = html;
                        } else {
                            tbody.innerHTML =
                                '<tr><td colspan="3" class="px-6 py-12 text-center text-gray-500">Sin datos</td></tr>';
                        }
                    });
            }

            async function init() {
                console.log("Iniciando administración...");
                if (!supabase) {
                    console.error("Supabase no está configurado");
                    hide("loading");
                    alert("Supabase not configured");
                    return;
                }

                console.log("Verificando sesión actual...");
                var {
                    data: { session },
                    error: sessionError,
                } = await supabase.auth.getSession();

                if (sessionError) {
                    console.error(
                        "Error al obtener sesión:",
                        sessionError.message
                    );
                }

                if (session && session.user) {
                    console.log("Sesión encontrada para:", session.user.email);
                    if (
                        ADMIN_EMAILS.includes(session.user.email.toLowerCase())
                    ) {
                        console.log("Acceso autorizado");
                        hide("loading");
                        hide("login");
                        show("dashboard");
                        const nameEl = document.getElementById("user-name");
                        if (nameEl) nameEl.textContent = session.user.email;
                        loadDashboard();
                    } else {
                        console.warn(
                            "Email no autorizado:",
                            session.user.email
                        );
                        hide("loading");
                        hide("login");
                        show("unauthorized");
                    }
                } else {
                    console.log("No hay sesión activa");
                    // If we are coming back from callback, the hash might be handled by onAuthStateChange
                    // Still hidden logout/login if loading is visible
                    setTimeout(() => {
                        const loadingVisible = !document
                            .getElementById("loading")
                            ?.classList.contains("hidden");
                        if (loadingVisible) {
                            console.log("Mostrando pantalla de login");
                            hide("loading");
                            show("login");
                        }
                    }, 2000); // Give it a bit more time for onAuthStateChange to fire
                }

                supabase.auth.onAuthStateChange(function (event, session) {
                    console.log(
                        "Auth State Change:",
                        event,
                        session?.user?.email
                    );
                    if (
                        (event === "SIGNED_IN" || event === "USER_UPDATED") &&
                        session
                    ) {
                        if (
                            ADMIN_EMAILS.includes(
                                session.user.email.toLowerCase()
                            )
                        ) {
                            console.log("Acceso autorizado vía evento");
                            hide("loading");
                            hide("login");
                            hide("unauthorized");
                            show("dashboard");
                            const nameEl = document.getElementById("user-name");
                            if (nameEl) nameEl.textContent = session.user.email;
                            loadDashboard();
                        } else {
                            console.warn(
                                "Email no autorizado vía evento:",
                                session.user.email

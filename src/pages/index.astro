---
import { supportedLangs } from "../i18n/ui-locales";

// URL base para redirecciones
const siteUrl = "https://lbernardo-dev.github.io/vitalshpath";
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta
            name="google-site-verification"
            content="b72boX-YTMPpT_1qmIYVjY3BpA7LIVuMVPtBqqJJBmk"
        />
        <title>VitalsPath - Smart Medication Tracker</title>
        
        <!-- SEO & Indexation -->
        <link rel="sitemap" href={`${siteUrl}/sitemap-index.xml`} />
        <link rel="canonical" href={`${siteUrl}/`} />
        {
            supportedLangs.map((lang) => (
                <link
                    rel="alternate"
                    hreflang={lang}
                    href={`${siteUrl}/${lang}/`}
                />
            ))
        }
        <link rel="alternate" hreflang="x-default" href={`${siteUrl}/en/`} />

        <!-- Favicon para la raíz (Crucial para indexación de icono) -->
        <link rel="icon" type="image/png" sizes="32x32" href={`${siteUrl}/favicon-32x32.png`} />
        <link rel="apple-touch-icon" href={`${siteUrl}/apple-touch-icon.png`} />

        <script is:inline define:vars={{ siteUrl, supportedLangs }}>
            (function () {
                var defaultLang = "en";

                function getPreferredLanguage() {
                    var saved = localStorage.getItem("vitalspath-lang");
                    if (saved && supportedLangs.indexOf(saved) !== -1) {
                        return saved;
                    }

                    var navLang = navigator.language || navigator.userLanguage;
                    if (navLang) {
                        var langCode = navLang.toLowerCase().split("-")[0];
                        if (supportedLangs.indexOf(langCode) !== -1) {
                            return langCode;
                        }
                    }

                    return defaultLang;
                }

                var lang = getPreferredLanguage();
                var newPath = siteUrl + "/" + lang + "/";

                // Redirección inteligente
                if (window.location.href !== newPath && !window.location.search.includes('no-redirect')) {
                    window.location.replace(newPath);
                }
            })();
        </script>
        
        <!-- Meta Refresh absoluto (Evita el "Redirect Error" de Search Console) -->
        <meta http-equiv="refresh" content={`0;url=${siteUrl}/en/`} />
    </head>
    <body class="bg-white dark:bg-black">
        <noscript>
            <meta http-equiv="refresh" content={`0;url=${siteUrl}/en/`} />
        </noscript>
    </body>
</html>

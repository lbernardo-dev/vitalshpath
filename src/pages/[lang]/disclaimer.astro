---
import LegalPageShell from "../../components/LegalPageShell.astro";
import { getLegalCopy } from "../../content/legal-copy";
import { supportedLangs, type Lang } from "../../i18n/ui-locales";

export function getStaticPaths() {
    return supportedLangs.map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params;
const currentLang = lang as Lang;
const copy = getLegalCopy(currentLang).disclaimer;
---

<LegalPageShell lang={currentLang} title={copy.title}>
    <div class="space-y-6">
        <section class="rounded-[1.75rem] border border-amber-200/80 bg-amber-50/90 p-6 dark:border-amber-500/20 dark:bg-amber-500/10">
            <p class="text-sm font-black uppercase tracking-[0.18em] text-amber-700 dark:text-amber-200">
                {copy.noticeTitle}
            </p>
            <p class="mt-3 text-lg leading-relaxed text-amber-900 dark:text-amber-100">
                {copy.noticeBody}
            </p>
        </section>

        {
            copy.sections.map((section, index) => (
                <section
                    class:list={[
                        "rounded-[1.5rem] border p-6",
                        index === 1
                            ? "border-red-200/80 bg-red-50/80 dark:border-red-500/20 dark:bg-red-500/10"
                            : "border-slate-200/80 bg-slate-50/80 dark:border-white/10 dark:bg-white/5",
                    ]}
                >
                    <h2 class="text-2xl font-black tracking-tight text-slate-950 dark:text-white">
                        {section.title}
                    </h2>
                    <p class="mt-3 text-base leading-relaxed text-slate-700 dark:text-slate-300">
                        {section.body}
                    </p>
                </section>
            ))
        }
    </div>
</LegalPageShell>

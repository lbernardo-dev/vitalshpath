---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/landing/Hero.astro";
import Features from "../../components/landing/Features.astro";
import Ecosystem from "../../components/landing/Ecosystem.astro";
import DownloadCTA from "../../components/landing/DownloadCTA.astro";
import {
    supportedLangs,
    type Lang,
} from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";

export function getStaticPaths() {
    return supportedLangs.map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params;
const currentLang = lang as Lang;
const copy = getSiteCopy(currentLang);
---

<Layout
    lang={currentLang}
    pageTitle={copy.meta.title}
    pageDescription={copy.meta.description}
>
    <!-- We wrap in a container to manage the reveal animations -->
    <main id="app-container" class="min-h-screen bg-cream selection:bg-teal-primary selection:text-white dark:bg-slate-950 transition-colors duration-500 overflow-x-hidden">
        
        <Header lang={currentLang} />

        <Hero lang={currentLang} />
        
        <Features lang={currentLang} />
        
        <Ecosystem lang={currentLang} />
        
        <DownloadCTA lang={currentLang} />

        <Footer lang={currentLang} />
        
    </main>
</Layout>

<script>
    import { setupRevealObserver } from "../../lib/reveal-observer";
    
    // Initialize reveal animations
    document.addEventListener("DOMContentLoaded", () => {
        setupRevealObserver();
    });
</script>

---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/landing/Hero.astro";
import Features from "../../components/landing/Features.astro";
import Ecosystem from "../../components/landing/Ecosystem.astro";
import DownloadCTA from "../../components/landing/DownloadCTA.astro";
import {
    supportedLangs,
    type Lang,
} from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";

export function getStaticPaths() {
    return supportedLangs.map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params;
const currentLang = lang as Lang;
const copy = getSiteCopy(currentLang);
---

<Layout
    lang={currentLang}
    pageTitle={copy.meta.title}
    pageDescription={copy.meta.description}
>
    <!-- Floating background blobs for premium depth -->
    <div class="fixed top-0 left-0 w-full h-full pointer-events-none -z-10 overflow-hidden" aria-hidden="true">
        <div class="absolute top-[10%] left-[10%] w-[30vw] h-[30vw] min-w-[300px] min-h-[300px] rounded-full bg-teal-primary/5 blur-[120px] animate-blob transition-colors duration-1000"></div>
        <div class="absolute top-[40%] right-[5%] w-[35vw] h-[35vw] min-w-[350px] min-h-[350px] rounded-full bg-orange-accent/5 blur-[120px] animate-blob animation-delay-2000 transition-colors duration-1000"></div>
        <div class="absolute bottom-[10%] left-[20%] w-[25vw] h-[25vw] min-w-[250px] min-h-[250px] rounded-full bg-teal-primary/5 blur-[120px] animate-blob animation-delay-4000 transition-colors duration-1000"></div>
    </div>

    <Header lang={currentLang} />

    <Hero lang={currentLang} />

    <Features lang={currentLang} />

    <Ecosystem lang={currentLang} />

    <DownloadCTA lang={currentLang} />

    <Footer lang={currentLang} />
</Layout>

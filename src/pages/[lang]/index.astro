---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import {
    supportedLangs,
    type Lang,
} from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";
import {
    getDefaultAppStoreLinks,
    getAppStoreUrlForLang,
} from "../../lib/app-store-links";
import { Image } from "astro:assets";
import appMockup from "../../assets/images/app-mockup.png";
import dashboardScreen from "../../assets/images/screens/screen-01-dashboard.PNG";
import medicationScreen from "../../assets/images/screens/screen-04-medications.PNG";
import symptomsScreen from "../../assets/images/screens/screen-13-symptoms.PNG";
import appointmentsScreen from "../../assets/images/screens/screen-11-appointments.PNG";
import widgetScreen from "../../assets/images/screens/screen-20-widgets-home.PNG";
import liveActivityScreen from "../../assets/images/screens/screen-27-live-activity2.PNG";
import watchListScreen from "../../assets/images/eco-watch-list.png";

export function getStaticPaths() {
    return supportedLangs.map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params;
const currentLang = lang as Lang;
const copy = getSiteCopy(currentLang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const appStoreHref = getAppStoreUrlForLang(currentLang, getDefaultAppStoreLinks());
const supportHref = `${baseUrl}/${currentLang}/feedback/`;
const privacyHref = `${baseUrl}/${currentLang}/privacy/`;
const releaseHref = `${baseUrl}/${currentLang}/release-features/`;
const roadmapHref = `${baseUrl}/${currentLang}/roadmap/`;

const showcaseCards = [
    {
        image: medicationScreen,
        alt: "Medication planning in VitalsPath",
        title: copy.home.featureListItems[0],
    },
    {
        image: widgetScreen,
        alt: "VitalsPath widgets on iPhone",
        title: copy.home.featureListItems[7],
    },
    {
        image: watchListScreen,
        alt: "VitalsPath on Apple Watch",
        title: "Apple Watch",
    },
];

const sectionImages = [dashboardScreen, appointmentsScreen, liveActivityScreen];

const sectionLinks = [
    { href: releaseHref, label: copy.nav.releaseFeatures },
    { href: roadmapHref, label: copy.nav.roadmap },
    { href: privacyHref, label: copy.nav.privacy },
];
---

<Layout
    lang={currentLang}
    pageTitle={copy.meta.title}
    pageDescription={copy.meta.description}
>
    <main class="min-h-screen bg-white text-slate-950 dark:bg-slate-950 dark:text-white">
        <Header lang={currentLang} />

        <section class="relative overflow-hidden pb-20 pt-28 sm:pb-24 sm:pt-32">
            <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_left,rgba(14,165,233,0.18),transparent_38%),radial-gradient(circle_at_bottom_right,rgba(20,184,166,0.12),transparent_34%)]"></div>
            <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 lg:grid-cols-[1.08fr,0.92fr]">
                <div class="max-w-2xl">
                    <div class="inline-flex rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-[11px] font-black uppercase tracking-[0.22em] text-sky-700 dark:border-sky-500/20 dark:bg-sky-500/10 dark:text-sky-300">
                        VitalsPath
                    </div>
                    <h1 class="mt-5 text-4xl font-black leading-tight tracking-tight sm:text-5xl lg:text-6xl">
                        {copy.home.heroTitle}
                    </h1>
                    <p class="mt-6 text-lg leading-8 text-slate-600 dark:text-slate-300">
                        {copy.home.heroSubtitle}
                    </p>

                    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                        <a
                            href={appStoreHref}
                            data-app-store-link
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center justify-center rounded-2xl bg-sky-600 px-6 py-4 text-center text-sm font-black text-white shadow-[0_25px_60px_-24px_rgba(2,132,199,0.95)] transition-all hover:bg-sky-700"
                        >
                            {copy.home.primaryCta}
                        </a>
                        <a
                            href={releaseHref}
                            class="inline-flex items-center justify-center rounded-2xl border border-slate-200 px-6 py-4 text-center text-sm font-bold text-slate-700 transition-all hover:border-slate-300 hover:text-slate-950 dark:border-white/10 dark:text-slate-200 dark:hover:border-white/20 dark:hover:text-white"
                        >
                            {copy.home.secondaryCta}
                        </a>
                    </div>

                    <div class="mt-4 space-y-3">
                        <p class="text-sm leading-6 text-slate-500 dark:text-slate-400">
                            {copy.common.medicalDisclaimer}
                        </p>
                    </div>

                    <div class="mt-8 flex flex-wrap gap-3">
                        {
                            sectionLinks.map((link) => (
                                <a
                                    href={link.href}
                                    class="inline-flex rounded-full border border-slate-200 px-3 py-1.5 text-sm font-semibold text-slate-600 transition-colors hover:border-slate-300 hover:text-slate-950 dark:border-white/10 dark:text-slate-300 dark:hover:border-white/20 dark:hover:text-white"
                                >
                                    {link.label}
                                </a>
                            ))
                        }
                    </div>
                </div>

                <div class="relative">
                    <div class="absolute inset-x-10 top-0 -z-10 h-64 rounded-full bg-sky-500/20 blur-[90px]"></div>
                    <div class="grid gap-4 sm:grid-cols-[1fr,0.84fr]">
                        <div class="rounded-[2rem] border border-slate-200/80 bg-white/92 p-4 shadow-[0_35px_100px_-50px_rgba(15,23,42,0.45)] backdrop-blur dark:border-white/10 dark:bg-white/5">
                            <Image
                                src={appMockup}
                                alt="VitalsPath health timeline"
                                class="mx-auto h-auto w-full max-w-[20rem] rounded-[1.7rem]"
                                widths={[400, 640]}
                                sizes="(max-width: 1024px) 70vw, 32vw"
                            />
                        </div>
                        <div class="grid gap-4">
                            {
                                showcaseCards.map((card) => (
                                    <div class="rounded-[1.75rem] border border-slate-200/80 bg-white/92 p-3 shadow-[0_25px_80px_-50px_rgba(15,23,42,0.4)] dark:border-white/10 dark:bg-white/5">
                                        <Image
                                            src={card.image}
                                            alt={card.alt}
                                            class="aspect-[9/12] w-full rounded-[1.2rem] object-cover"
                                            widths={[280, 420]}
                                            sizes="(max-width: 1024px) 40vw, 18vw"
                                        />
                                        <p class="mt-3 text-sm font-bold text-slate-700 dark:text-slate-200">
                                            {card.title}
                                        </p>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="pb-20 sm:pb-24">
            <div class="mx-auto max-w-7xl px-4 sm:px-6">
                <div class="grid gap-6 lg:grid-cols-3">
                    {
                        copy.home.sections.map((section, index) => (
                            <article class="overflow-hidden rounded-[2rem] border border-slate-200/80 bg-white p-5 shadow-[0_30px_90px_-55px_rgba(15,23,42,0.35)] dark:border-white/10 dark:bg-white/5 sm:p-6">
                                <Image
                                    src={sectionImages[index]}
                                    alt={section.title}
                                    class="aspect-[16/10] w-full rounded-[1.4rem] object-cover"
                                    widths={[640, 960]}
                                    sizes="(max-width: 1024px) 100vw, 30vw"
                                />
                                <h2 class="mt-6 text-2xl font-black tracking-tight">
                                    {section.title}
                                </h2>
                                <p class="mt-4 text-base leading-7 text-slate-600 dark:text-slate-300">
                                    {section.body}
                                </p>
                            </article>
                        ))
                    }
                </div>
            </div>
        </section>

        <section class="pb-20 sm:pb-24">
            <div class="mx-auto max-w-7xl px-4 sm:px-6">
                <div class="grid gap-8 lg:grid-cols-[1.1fr,0.9fr]">
                    <div class="rounded-[2rem] border border-slate-200/80 bg-slate-50 p-6 dark:border-white/10 dark:bg-white/5 sm:p-8">
                        <p class="text-sm font-black uppercase tracking-[0.22em] text-sky-600 dark:text-sky-300">
                            {copy.home.featureListTitle}
                        </p>
                        <div class="mt-6 grid gap-3 sm:grid-cols-2">
                            {
                                copy.home.featureListItems.map((item) => (
                                    <div class="rounded-2xl border border-white/80 bg-white px-4 py-4 text-sm font-semibold text-slate-700 shadow-sm dark:border-white/10 dark:bg-slate-950/60 dark:text-slate-200">
                                        {item}
                                    </div>
                                ))
                            }
                        </div>
                        <p class="mt-6 text-sm leading-6 text-slate-500 dark:text-slate-400">
                            {copy.home.footnote}
                        </p>
                    </div>

                    <div class="rounded-[2rem] border border-slate-200/80 bg-white p-6 shadow-[0_30px_90px_-55px_rgba(15,23,42,0.35)] dark:border-white/10 dark:bg-white/5 sm:p-8">
                        <p class="text-sm font-black uppercase tracking-[0.22em] text-sky-600 dark:text-sky-300">
                            {copy.nav.releaseFeatures}
                        </p>
                        <h2 class="mt-4 text-3xl font-black tracking-tight">
                            {copy.releaseFeatures.sections[0].title}
                        </h2>
                        <p class="mt-4 text-base leading-7 text-slate-600 dark:text-slate-300">
                            {copy.releaseFeatures.sections[0].body}
                        </p>
                        <div class="mt-6 overflow-hidden rounded-[1.5rem] border border-slate-200/80 dark:border-white/10">
                            <Image
                                src={symptomsScreen}
                                alt={copy.releaseFeatures.sections[1].title}
                                class="aspect-[16/10] w-full object-cover"
                                widths={[640, 960]}
                                sizes="(max-width: 1024px) 100vw, 34vw"
                            />
                        </div>
                        <div class="mt-6 flex flex-wrap gap-3">
                            <a
                                href={releaseHref}
                                class="inline-flex rounded-2xl bg-slate-950 px-4 py-3 text-sm font-black text-white transition-colors hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-100"
                            >
                                {copy.nav.releaseFeatures}
                            </a>
                            <a
                                href={supportHref}
                                class="inline-flex rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold text-slate-700 transition-colors hover:border-slate-300 hover:text-slate-950 dark:border-white/10 dark:text-slate-200 dark:hover:border-white/20 dark:hover:text-white"
                            >
                                {copy.common.contactSupport}
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <Footer lang={currentLang} />
    </main>
</Layout>

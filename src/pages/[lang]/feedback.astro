---
import PageShell from "../../components/PageShell.astro";
import { supportedLangs, type Lang } from "../../i18n/ui-locales";
import { useTranslations } from "../../i18n";
import { getSiteCopy } from "../../content/site-copy";
import { appStoreLabels } from "../../lib/app-store-labels";
import {
    getDefaultAppStoreLinks,
    getAppStoreUrlForLang,
} from "../../lib/app-store-links";
import { supportEmail } from "../../lib/site-config";
import { MessageSquare, Send, CheckCircle } from "lucide-react";

export function getStaticPaths() {
    return supportedLangs.map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params;
const currentLang = lang as Lang;
const t = useTranslations(currentLang);
const copy = getSiteCopy(currentLang);
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
const appStoreHref = getAppStoreUrlForLang(currentLang, getDefaultAppStoreLinks());
const reviewHref = getDefaultAppStoreLinks().reviewUrl;
---

<PageShell
    lang={currentLang}
    title={copy.support.title}
    intro={copy.support.intro}
    badge={copy.nav.support}
    pageTitle={`${copy.support.title} | VitalsPath`}
    pageDescription={copy.support.intro}
>
    <div class="grid gap-6 lg:grid-cols-[0.9fr,1.1fr]">
        <div class="space-y-6">
            <section class="rounded-[1.6rem] border border-slate-200/80 bg-slate-50 p-5 dark:border-white/10 dark:bg-slate-950/60 sm:p-6">
                <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-sky-600 text-white">
                    <MessageSquare class="h-6 w-6" />
                </div>
                <h2 class="mt-5 text-2xl font-black tracking-tight text-slate-950 dark:text-white">
                    {copy.support.contactTitle}
                </h2>
                <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-300">
                    {copy.support.contactBody}
                </p>
                <a
                    href={`mailto:${supportEmail}`}
                    class="mt-5 inline-flex rounded-2xl bg-sky-600 px-4 py-3 text-sm font-black text-white transition-colors hover:bg-sky-700"
                >
                    {copy.common.contactSupport}
                </a>
            </section>

            <section class="rounded-[1.6rem] border border-slate-200/80 bg-white p-5 dark:border-white/10 dark:bg-white/5 sm:p-6">
                <h2 class="text-2xl font-black tracking-tight text-slate-950 dark:text-white">
                    {copy.support.helpTitle}
                </h2>
                <ul class="mt-5 space-y-3 text-base leading-7 text-slate-600 dark:text-slate-300">
                    {
                        copy.support.helpItems.map((item) => (
                            <li class="rounded-2xl border border-slate-200/80 bg-slate-50 px-4 py-3 dark:border-white/10 dark:bg-slate-950/50">
                                {item}
                            </li>
                        ))
                    }
                </ul>
                <p class="mt-5 text-sm leading-6 text-slate-500 dark:text-slate-400">
                    {copy.support.note}
                </p>
            </section>

            <section class="rounded-[1.6rem] border border-slate-200/80 bg-white p-5 dark:border-white/10 dark:bg-white/5 sm:p-6">
                <h2 class="text-2xl font-black tracking-tight text-slate-950 dark:text-white">
                    App Store
                </h2>
                <div class="mt-5 flex flex-wrap gap-3">
                    <a
                        href={appStoreHref}
                        data-app-store-link
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex rounded-2xl bg-slate-950 px-4 py-3 text-sm font-black text-white transition-colors hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-100"
                    >
                        {appStoreLabels[currentLang].view}
                    </a>
                    <a
                        href={reviewHref}
                        data-app-store-review-link
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex rounded-2xl border border-slate-200 px-4 py-3 text-sm font-bold text-slate-700 transition-colors hover:border-slate-300 hover:text-slate-950 dark:border-white/10 dark:text-slate-200 dark:hover:border-white/20 dark:hover:text-white"
                    >
                        {appStoreLabels[currentLang].rate}
                    </a>
                </div>
            </section>
        </div>

        <section class="rounded-[1.6rem] border border-slate-200/80 bg-white p-5 shadow-[0_30px_90px_-55px_rgba(15,23,42,0.35)] dark:border-white/10 dark:bg-white/5 sm:p-6">
            <h2 class="text-2xl font-black tracking-tight text-slate-950 dark:text-white">
                {copy.support.formTitle}
            </h2>
            <p class="mt-3 text-base leading-7 text-slate-600 dark:text-slate-300">
                {copy.support.formIntro}
            </p>

            <form
                id="feedback-form"
                action={`https://formsubmit.co/${supportEmail}`}
                method="POST"
                class="mt-8 space-y-5"
            >
                <input type="hidden" name="_subject" value="VitalsPath Support" />
                <input type="hidden" name="_captcha" value="false" />
                <input type="hidden" name="_template" value="table" />
                <input
                    type="hidden"
                    name="_next"
                    value={`https://lbernardo-dev.github.io/vitalshpath/${currentLang}/feedback/?submitted=true`}
                />

                <div>
                    <label class="mb-2 block text-sm font-semibold text-slate-800 dark:text-slate-100">
                        {t("feedback.form.type")}
                    </label>
                    <select
                        name="feedback_type"
                        required
                        class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-sky-500 dark:border-white/10 dark:bg-slate-950 dark:text-white"
                    >
                        <option value="feature">{t("feedback.types.feature")}</option>
                        <option value="bug">{t("feedback.types.bug")}</option>
                        <option value="improvement">{t("feedback.types.improvement")}</option>
                        <option value="question">{t("feedback.types.question")}</option>
                        <option value="other">{t("feedback.types.other")}</option>
                    </select>
                </div>

                <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <label for="name" class="mb-2 block text-sm font-semibold text-slate-800 dark:text-slate-100">
                            {t("feedback.form.name")}
                        </label>
                        <input
                            id="name"
                            name="name"
                            type="text"
                            class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-sky-500 dark:border-white/10 dark:bg-slate-950 dark:text-white"
                            placeholder={t("feedback.form.namePlaceholder")}
                        />
                    </div>
                    <div>
                        <label for="email" class="mb-2 block text-sm font-semibold text-slate-800 dark:text-slate-100">
                            {t("feedback.form.email")}
                        </label>
                        <input
                            id="email"
                            name="email"
                            type="email"
                            required
                            class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-sky-500 dark:border-white/10 dark:bg-slate-950 dark:text-white"
                            placeholder={t("feedback.form.emailPlaceholder")}
                        />
                    </div>
                </div>

                <div>
                    <label for="subject" class="mb-2 block text-sm font-semibold text-slate-800 dark:text-slate-100">
                        {t("feedback.form.subject")}
                    </label>
                    <input
                        id="subject"
                        name="subject"
                        type="text"
                        required
                        class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-sky-500 dark:border-white/10 dark:bg-slate-950 dark:text-white"
                        placeholder={t("feedback.form.subjectPlaceholder")}
                    />
                </div>

                <div>
                    <label for="message" class="mb-2 block text-sm font-semibold text-slate-800 dark:text-slate-100">
                        {t("feedback.form.message")}
                    </label>
                    <textarea
                        id="message"
                        name="message"
                        rows="6"
                        required
                        class="w-full rounded-2xl border border-slate-200 bg-white px-4 py-3 text-slate-900 outline-none transition focus:border-sky-500 dark:border-white/10 dark:bg-slate-950 dark:text-white"
                        placeholder={t("feedback.form.messagePlaceholder")}
                    ></textarea>
                </div>

                <button
                    type="submit"
                    class="inline-flex items-center gap-2 rounded-2xl bg-sky-600 px-5 py-3 text-sm font-black text-white transition-colors hover:bg-sky-700"
                >
                    <Send class="h-4 w-4" />
                    {t("feedback.form.submit")}
                </button>
            </form>

            <div id="success-message" class="hidden py-8 text-center">
                <div class="mx-auto inline-flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-300">
                    <CheckCircle class="h-8 w-8" />
                </div>
                <h3 class="mt-4 text-2xl font-black text-slate-950 dark:text-white">
                    {t("feedback.success.title")}
                </h3>
                <p class="mt-3 text-slate-600 dark:text-slate-300">
                    {t("feedback.success.message")}
                </p>
            </div>
        </section>
    </div>
</PageShell>

<script>
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get("submitted") === "true") {
        const form = document.getElementById("feedback-form");
        const successMessage = document.getElementById("success-message");
        if (form && successMessage) {
            form.classList.add("hidden");
            successMessage.classList.remove("hidden");
        }
        window.history.replaceState({}, document.title, window.location.pathname);
    }
</script>

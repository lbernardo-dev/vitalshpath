---
import Layout from "../../layouts/Layout.astro";
import { supportedLangs, type Lang } from "../../i18n/ui-locales";
import { useTranslations } from "../../i18n";

export function getStaticPaths() {
	return supportedLangs.map((lang) => ({
		params: { lang },
	}));
}

const { lang } = Astro.params;
const currentLang = lang as Lang;
const t = useTranslations(currentLang);
---

<Layout
	lang={currentLang}
	robots="noindex, nofollow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
	pageTitle={`${t("maintenance.title")} | VitalsPath`}
	pageDescription={t("maintenance.defaultMessage")}
>
	<main class="min-h-screen px-6 py-24 flex items-center justify-center">
		<section class="w-full max-w-3xl rounded-[2rem] border border-gray-200/80 bg-white/90 p-8 md:p-12 shadow-[0_40px_120px_-60px_rgba(15,23,42,0.45)] backdrop-blur dark:border-white/10 dark:bg-gray-950/80">
			<div class="inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-700 dark:border-amber-500/20 dark:bg-amber-500/10 dark:text-amber-300">
				<span class="h-2 w-2 rounded-full bg-amber-500"></span>
				{t("maintenance.status")}
			</div>

			<h1 class="mt-6 text-4xl font-bold tracking-tight text-gray-900 dark:text-white md:text-5xl">
				{t("maintenance.title")}
			</h1>
			<p class="mt-4 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-300">
				{t("maintenance.subtitle")}
			</p>

			<div class="mt-8 rounded-[1.5rem] border border-gray-200 bg-gray-50/80 p-6 text-base leading-7 text-gray-700 dark:border-white/10 dark:bg-white/5 dark:text-gray-200">
				<p id="maintenance-message">{t("maintenance.defaultMessage")}</p>
			</div>

			<p class="mt-6 text-sm leading-6 text-gray-500 dark:text-gray-400">
				{t("maintenance.legalAccess")}
			</p>

			<div class="mt-10 flex flex-wrap gap-4">
				<a
					href={`${import.meta.env.BASE_URL}${currentLang}/`}
					class="inline-flex items-center justify-center rounded-full bg-blue-600 px-6 py-3 font-semibold text-white transition-transform hover:scale-[1.02] hover:bg-blue-700"
				>
					{t("maintenance.backToHome")}
				</a>
				<a
					href={`${import.meta.env.BASE_URL}${currentLang}/privacy/`}
					class="inline-flex items-center justify-center rounded-full border border-gray-300 px-6 py-3 font-semibold text-gray-800 transition-colors hover:border-blue-300 hover:text-blue-700 dark:border-white/15 dark:text-white dark:hover:border-blue-400/40 dark:hover:text-blue-300"
				>
					Privacy
				</a>
			</div>
		</section>
	</main>

	<script define:vars={{ currentLang }}>
		import { getSupabase, isSupabaseConfigured } from "../../lib/supabase";

		async function hydrateMaintenanceMessage() {
			if (!isSupabaseConfigured()) return;

			const messageEl = document.getElementById("maintenance-message");
			if (!messageEl) return;

			const supabase = getSupabase();
			if (!supabase) return;

			const { data, error } = await supabase
				.from("site_settings")
				.select("value")
				.eq("key", "maintenance_mode")
				.maybeSingle();

			if (error || !data?.value) return;

			const value = data.value;
			const customMessage =
				typeof value === "object" && value !== null ? value.message : "";

			if (typeof customMessage === "string" && customMessage.trim()) {
				messageEl.textContent = customMessage.trim();
			}
		}

		hydrateMaintenanceMessage();
	</script>
</Layout>

---
import PageShell from "../../components/PageShell.astro";
import { supportedLangs, type Lang } from "../../i18n/ui-locales";
import { getSiteCopy } from "../../content/site-copy";

export function getStaticPaths() {
    return supportedLangs.map((lang) => ({
        params: { lang },
    }));
}

const { lang } = Astro.params;
const currentLang = lang as Lang;
const copy = getSiteCopy(currentLang);
const serviceDisclosure: Record<Lang, { notice: string; title: string; sections: { title: string; body: string }[] }> = {
    en: {
        notice: "",
        title: "How data is stored and which services are involved",
        sections: [
            { title: "App storage and iCloud sync", body: "VitalsPath stores profile and health records in its app database and is configured to sync records through Apple CloudKit when an iCloud account and network are available. Profiles intentionally shared through the app may be available to people who accept an invitation, subject to the access selected by the owner. Sync can be delayed or interrupted. VitalsPath does not claim end-to-end encryption for every record or feature." },
            { title: "Apple Health and location", body: "With Health access, VitalsPath reads or writes only supported data types approved in Apple's permission sheet; you can change access in iOS Settings. With location permission, the app can use location for map and local-context features. For weather, coordinates are rounded to about 1.1 km before the request is sent to Open-Meteo. Holiday lookup sends a year and country code to Nager.Date. Reverse geocoding uses Apple's MapKit/CLGeocoder." },
            { title: "Optional product analytics", body: "Firebase Analytics collection is disabled until you explicitly enable analytics in the app. When enabled, the app sends defined product-interaction events and coarse feature or subscription context. The event contract excludes medication names, doses, symptoms, diagnoses, appointments, clinical timestamps and free-form text. The linked Google Analytics 4 property currently retains event-level data for 2 months and user-level data for 14 months. The setting that resets user-data retention with each new activity is enabled, so the user-level period can extend while activity continues. Google says this retention control does not affect standard aggregated reports. You can turn collection off again in app settings." },
            { title: "Crash and technical diagnostics", body: "Firebase Crashlytics can collect crash reports and technical context such as app/build version, device model, operating-system version and locale. Crash reporting is enabled by default in production unless you turn it off in app settings. When disabled, the app deletes reports that have not yet been sent. Google retains received crash stack traces and associated identifiers for 90 days before starting removal from live and backup systems. Crash reports differ from product analytics and may contain diagnostic stack or breadcrumb data." },
            { title: "Purchases and subscriptions", body: "Apple StoreKit/App Store processes payment and purchase transactions; RevenueCat receives the app-user identifier and transaction/entitlement information to support product availability, purchase restoration and entitlement checks. Purchase records and subscription entitlements are outside the analytics/diagnostics retention settings and follow the providers' terms and applicable obligations. Deleting or resetting VitalsPath data does not cancel an App Store subscription or currently send a customer-deletion request to RevenueCat. Contact vitalspath@gmail.com to request deletion of RevenueCat data; manage or cancel an App Store subscription through Apple's subscription settings." },
            { title: "Retention and requests", body: "Health and profile data stored in the app remain on the device and in CloudKit until you delete them, except historical logs and reports subject to app retention controls. Medication-dose records and medication activity entries share a retention setting with 30, 90, 180 or 365 days or permanent storage; the default is 30 days. Appointment and condition activity entries follow their own category settings. Other activity types without a retention setting remain until you delete them. Professional reports default to 30 days and can be retained for 1–365 days. Cleanup runs when the app starts and when a retention setting changes. You can delete a profile or reset all app data under Settings > Data Management. A full reset erases local data and attempts to purge the CloudKit zone. If iCloud or a network connection is unavailable, local deletion still proceeds and remote CloudKit removal may not complete at that time; the app shows a warning during onboarding. Analytics and diagnostic retention are described above and differ by service. For access or deletion requests about a particular provider record, contact vitalspath@gmail.com." },
        ],
    },
    es: {
        notice: "",
        title: "Cómo se guardan los datos y qué servicios intervienen",
        sections: [
            { title: "Almacenamiento de la app y sincronización con iCloud", body: "VitalsPath guarda perfiles y registros de salud en su base de datos y está configurada para sincronizarlos mediante Apple CloudKit cuando hay una cuenta de iCloud y conexión. Los perfiles que se comparten desde la app pueden quedar disponibles para las personas que acepten una invitación, según los permisos elegidos por quien comparte. La sincronización puede retrasarse o interrumpirse. VitalsPath no afirma que todos los registros o funciones tengan cifrado de extremo a extremo." },
            { title: "Apple Health y ubicación", body: "Con acceso a Salud, VitalsPath lee o escribe únicamente los tipos de datos compatibles aprobados en el permiso de Apple; puedes modificarlo en Ajustes de iOS. Con permiso de ubicación, la app puede usar la ubicación para mapas y funciones de contexto local. Para consultar el tiempo, redondea las coordenadas a unos 1,1 km antes de enviarlas a Open-Meteo. La consulta de festivos envía año y código de país a Nager.Date. La geocodificación inversa utiliza MapKit/CLGeocoder de Apple." },
            { title: "Analítica de producto opcional", body: "La recopilación de Firebase Analytics está desactivada hasta que actives expresamente las analíticas en la app. Si la activas, se envían eventos definidos de interacción y contexto general de funciones o suscripción. El contrato de eventos excluye nombres de medicamentos, dosis, síntomas, diagnósticos, citas, horas clínicas y texto libre. La propiedad vinculada de Google Analytics 4 conserva actualmente los datos de eventos durante 2 meses y los datos de usuario durante 14 meses. Está activada la opción que reinicia la conservación de datos de usuario con cada nueva actividad, por lo que ese plazo puede prolongarse mientras sigas usando la app. Google indica que este control no afecta a los informes agregados estándar. Puedes desactivarla desde los ajustes de la app." },
            { title: "Informes de fallos y diagnósticos técnicos", body: "Firebase Crashlytics puede recopilar informes de fallos y contexto técnico como versión/build de la app, modelo del dispositivo, versión del sistema operativo e idioma. En producción, los informes están activados por defecto salvo que los desactives en los ajustes de la app. Al desactivarlos, la app elimina los informes pendientes de envío; los informes ya recibidos por Firebase siguen el plazo de Crashlytics. Google conserva las trazas de fallos y los identificadores asociados durante 90 días antes de iniciar su eliminación de los sistemas activos y las copias de seguridad. Son distintos de la analítica de producto y pueden incluir datos técnicos de pila o migas de diagnóstico." },
            { title: "Compras y suscripciones", body: "Apple StoreKit/App Store procesa los pagos y las transacciones de compra; RevenueCat recibe un identificador de usuario de la app y datos de transacciones y derechos para ofrecer productos, restaurar compras y comprobar suscripciones. Los datos de compras y derechos de suscripción quedan fuera de los ajustes de conservación de analíticas/diagnósticos y se rigen por las condiciones de los proveedores y las obligaciones aplicables. Borrar o restablecer los datos de VitalsPath no cancela una suscripción de App Store ni envía actualmente a RevenueCat una solicitud de borrado del cliente. Para solicitar la eliminación de datos de RevenueCat, escribe a vitalspath@gmail.com; gestiona o cancela una suscripción de App Store desde los ajustes de suscripciones de Apple." },
            { title: "Conservación y solicitudes", body: "Los perfiles y datos de salud guardados por la app se conservan en el dispositivo y CloudKit hasta que los elimines, salvo los historiales y los informes sujetos a controles de retención. Los registros de tomas y las entradas de actividad de medicación comparten un control con opciones de 30, 90, 180 o 365 días o conservación permanente; el valor predeterminado es 30 días. La actividad de citas y condiciones sigue el ajuste de su categoría. Los demás tipos de actividad, que no tienen un control de retención, se conservan hasta que los elimines. Los informes profesionales se conservan 30 días de forma predeterminada y el plazo se puede ajustar entre 1 y 365 días. La limpieza se ejecuta al iniciar la app y cuando cambia un ajuste de retención. Puedes eliminar un perfil o restablecer los datos desde Ajustes > Gestión de datos. El restablecimiento completo borra los datos locales e intenta purgar la zona de CloudKit. Si iCloud o la conexión de red no están disponibles, el borrado local continúa y la eliminación remota de CloudKit puede no completarse en ese momento; la app muestra un aviso durante la configuración inicial. La analítica y los diagnósticos tienen los plazos indicados arriba, distintos según el servicio. Para solicitudes de acceso o eliminación de datos de un proveedor, escribe a vitalspath@gmail.com." },
        ],
    },
    fr: { notice: "Les informations détaillées sur le stockage, les fournisseurs et les contrôles sont actuellement disponibles en espagnol et en anglais.", title: "", sections: [] },
    de: { notice: "Ausführliche Informationen zu Speicherung, Diensten und Einstellungen sind derzeit auf Spanisch und Englisch verfügbar.", title: "", sections: [] },
    it: { notice: "Le informazioni dettagliate su archiviazione, servizi e controlli sono attualmente disponibili in spagnolo e inglese.", title: "", sections: [] },
    pt: { notice: "As informações detalhadas sobre armazenamento, serviços e controles estão disponíveis atualmente em espanhol e inglês.", title: "", sections: [] },
    ja: { notice: "保存、サービス、設定に関する詳細は現在スペイン語と英語で提供されています。", title: "", sections: [] },
    zh: { notice: "有关存储、服务和控制项的详细信息目前提供西班牙语和英语版本。", title: "", sections: [] },
    ko: { notice: "저장, 서비스 및 설정에 관한 자세한 정보는 현재 스페인어와 영어로 제공됩니다.", title: "", sections: [] },
    ru: { notice: "Подробная информация о хранении, сервисах и настройках пока доступна на испанском и английском языках.", title: "", sections: [] },
    ar: { notice: "المعلومات التفصيلية حول التخزين والخدمات وعناصر التحكم متاحة حاليًا بالإسبانية والإنجليزية.", title: "", sections: [] },
    hi: { notice: "स्टोरेज, सेवाओं और नियंत्रणों की विस्तृत जानकारी अभी स्पेनिश और अंग्रेज़ी में उपलब्ध है।", title: "", sections: [] },
    tr: { notice: "Depolama, hizmetler ve denetimlerle ilgili ayrıntılı bilgiler şu anda İspanyolca ve İngilizce sunuluyor.", title: "", sections: [] },
    nl: { notice: "Uitgebreide informatie over opslag, diensten en instellingen is momenteel beschikbaar in het Spaans en Engels.", title: "", sections: [] },
    pl: { notice: "Szczegółowe informacje o przechowywaniu danych, usługach i ustawieniach są obecnie dostępne po hiszpańsku i angielsku.", title: "", sections: [] },
};
---

<PageShell
    lang={currentLang}
    title={copy.privacy.title}
    intro={copy.privacy.intro}
    badge={copy.nav.privacy}
>
    <div class="grid gap-6">
        {
            copy.privacy.sections.map((section) => (
                <section class="rounded-[1.6rem] border border-slate-200/80 bg-slate-50 p-5 dark:border-white/10 dark:bg-slate-950/60 sm:p-6">
                    <h2 class="text-2xl font-black tracking-tight text-slate-950 dark:text-white">
                        {section.title}
                    </h2>
                    <p class="mt-4 text-base leading-7 text-slate-600 dark:text-slate-300">
                        {section.body}
                    </p>
                </section>
            ))
        }

        {serviceDisclosure[currentLang].notice && (
            <p lang={currentLang} class="rounded-2xl border border-amber-300 bg-amber-50 p-5 text-sm leading-6 text-amber-950 dark:border-amber-700 dark:bg-amber-950/40 dark:text-amber-100">
                {serviceDisclosure[currentLang].notice}
            </p>
        )}
        {serviceDisclosure[currentLang].sections.length > 0 && (
            <section class="rounded-[1.6rem] border border-slate-200/80 bg-slate-50 p-5 dark:border-white/10 dark:bg-slate-950/60 sm:p-6">
                <h2 class="text-2xl font-black tracking-tight text-slate-950 dark:text-white">{serviceDisclosure[currentLang].title}</h2>
                <div class="mt-6 space-y-6">
                    {serviceDisclosure[currentLang].sections.map((section) => (
                        <div>
                            <h3 class="text-lg font-bold text-slate-950 dark:text-white">{section.title}</h3>
                            <p class="mt-2 text-base leading-7 text-slate-600 dark:text-slate-300">{section.body}</p>
                        </div>
                    ))}
                </div>
            </section>
        )}
        <section class="rounded-[1.75rem] border border-sky-200 bg-sky-50 p-5 dark:border-sky-500/20 dark:bg-sky-500/10 sm:p-6">
            <p class="text-sm font-black uppercase tracking-[0.22em] text-sky-700 dark:text-sky-300">
                VitalsPath
            </p>
            <p class="mt-4 text-base leading-7 text-slate-700 dark:text-slate-200">
                {copy.common.medicalDisclaimer}
            </p>
            <div class="mt-6">
                <a
                    href={`${baseUrl}/${currentLang}/feedback/`}
                    class="inline-flex rounded-2xl bg-sky-600 px-4 py-3 text-sm font-black text-white transition-colors hover:bg-sky-700"
                >
                    {copy.common.contactSupport}
                </a>
            </div>
        </section>
    </div>
</PageShell>
